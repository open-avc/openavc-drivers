# Generated catalog files. CI rebuilds and commits these on merge to main;
# contributors edit driver files only and never hand-edit or commit these.
# linguist-generated collapses them in GitHub pull-request diffs and excludes
# them from the repository's language statistics.
index.json linguist-generated=true
devices.json linguist-generated=true
index/** linguist-generated=true
devices/** linguist-generated=true

# Generated copies of the platform's driver-contract modules (see
# scripts/vendor_platform_contract.py; CI fails when they drift from the
# platform repo). LF-normalized so the byte-for-byte sync check behaves
# the same on every platform.
scripts/_vendor/** text eol=lf linguist-generated=true

# Published JSON Schemas, generated by the platform repo from its driver
# contract and byte-copied here by scripts/vendor_platform_contract.py.
avcdriver.schema.json text eol=lf linguist-generated=true
pythondriver.schema.json text eol=lf linguist-generated=true

# Driver files and the catalog generated from them. build_index.py hashes
# the bytes on disk and the platform hashes what raw.githubusercontent
# serves, which is the blob as stored - so the two only agree when the
# working tree matches the blob. Without this, regenerating the catalog on
# Windows writes CRLF checksums that no download can ever match, and every
# driver in the catalog becomes uninstallable (the hash check is
# fail-closed). Same reasoning as the vendored files above.
*.avcdriver text eol=lf
*.py text eol=lf
*.json text eol=lf
