# Generated catalog files. CI rebuilds and commits these on merge to main;
# contributors edit driver files only and never hand-edit or commit these.
# linguist-generated collapses them in GitHub pull-request diffs and excludes
# them from the repository's language statistics.
index.json linguist-generated=true
devices.json linguist-generated=true
index/** linguist-generated=true
devices/** linguist-generated=true

# Generated copies of the platform's driver-contract modules (see
# scripts/vendor_platform_contract.py; CI fails when they drift from the
# platform repo). LF-normalized so the byte-for-byte sync check behaves
# the same on every platform.
scripts/_vendor/** text eol=lf linguist-generated=true
