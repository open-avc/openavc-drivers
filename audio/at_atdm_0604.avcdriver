# Audio-Technica ATDM-0604 Digital SmartMixer Driver
#
# Controls Audio-Technica ATDM-0604 automatic mixers over TCP (port 17300).
#
# Protocol reference: IP Control Protocol Specification ATDM-0604 (docs.audio-technica.com)
#
# Command format (Set):  <command> S <modelID> <unitNo> NC <params> \r
# Command format (Get):  <command> O <modelID> <unitNo> NC <params> \r
# Response ACK:          <command> ACK \r
# Response NAK:          <command> NAK <error_code> \r
# Answer:                <command> <modelID> <unitNo> NC <params> \r
#
# All fields are space-delimited (0x20), INCLUDING a trailing space before
# the CR — the spec's own examples end "<params> \r", and the successor
# model (ATDM-0604a, which shares this grammar family) NAKs 04 on
# parametered commands without it (hardware-verified). Parameters are
# comma-separated; a parameter may be omitted (left empty between commas)
# to leave that field unchanged on a Set.
#
# NOTE: This driver targets the ORIGINAL ATDM-0604. The ATDM-0604a
# successor speaks a newer protocol revision (9-field SmartMix general,
# 7-field per-channel SmartMix, short-code channel commands, g_deviceid,
# AT-LINK) — use the at_atdm_0604a driver for it.
#
# Key concepts:
#   - 6 mic/line inputs (0-5) plus 1 stereo input (10)
#   - 2 mono outputs (0-1) plus 1 stereo output (10) — the protocol has no
#     output channels 2-9 (the spec's output-channel tables list exactly
#     0 = Output 1, 1 = Output 2, 10 = Output ST)
#   - Fader values: 0 = mute(-inf), 1-511 = -120dB to +10dB (411 = 0 dB)
#   - SmartMixer: automatic gain sharing / gating for conferencing.
#     Per-channel settings via s_smart_mix (8 fields: channel, gain-share
#     weight, 3 reserved, gate priority, can cut, off attenuation); common
#     settings via s_smart_mix_general (6 fields: mode, last mic on, gate
#     hold time, NOMA, number of open mics, priority mode). Both have g_*
#     read-back verbs.
#   - Push notifications: the mixer multicasts MD state-change notices over
#     UDP (factory default 225.0.0.100:17000) — never on the TCP control
#     connection. This driver joins that group (push: block) and arms the
#     "IP Control Setting Notification" flag from on_connect via an
#     s_network omission write. The push surface is spec-derived (no bench
#     hardware for this model): the runtime-only (no-reboot) behavior of
#     the flag write is verified on the ATDM-0604a only and assumed here —
#     if this model applies it only after the reboot its spec calls for,
#     the write is harmless (ACK) and notices simply stay off until enabled
#     in Web Remote. Level meters (level_meter_notice, 44 values at the
#     meter interval) ride the same channel and are opt-in via the Enable
#     Level Meters config field; when off the arming write omits the Audio
#     Level Notification field entirely so another controller's meter feed
#     is never disturbed. Polling stays on as the baseline resync for
#     networks that filter multicast.
#   - Max 5 simultaneous TCP connections
#   - Asynchronous: can send commands without waiting for ACK/NAK

id: at_atdm_0604
name: Audio-Technica ATDM-0604
manufacturer: Audio-Technica
category: audio
version: 1.6.0
author: OpenAVC
min_platform_version: "0.23.0"
description: >
  Controls Audio-Technica ATDM-0604 Digital SmartMixer via TCP with
  real-time multicast push updates. Input/output level and mute control,
  preset recall, SmartMix configuration, and optional live level meters.

source_url: https://docs.audio-technica.com/us/atdm_0604_ip_control_protcol_specification_ver1_1_2_web_190626.pdf
tags: [mixer, smartmixer, conferencing, automixer]
verified: false
simulated: true
ports: [17300]
compatible_models:
  - manufacturer: Audio-Technica
    models: [ATDM-0604]
    confidence: untested

transport: tcp
delimiter: "\r"

help:
  overview: >
    Controls Audio-Technica ATDM-0604 Digital SmartMixer. The ATDM-0604 is a
    6-input automatic mixer designed for conference and installed
    sound applications.
  setup: >
    1. Connect the ATDM-0604 to the network (default control port 17300).
    2. Configure the mixer's IP address via the front panel or Web Remote.
    3. To let OpenAVC find the mixer in a network scan, enable
       "Allow Discovery" (UPnP) in the mixer's network settings.
    4. Input channels: 1-6 (mic/line) and ST (stereo).
       Output channels: 1-2 and ST (stereo).
    5. Front-panel and Web Remote changes appear in OpenAVC instantly:
       the mixer multicasts change notices (factory default group
       225.0.0.100, port 17000) and OpenAVC listens automatically. If you
       changed the multicast address or port in Web Remote's network
       settings, set the matching values in this device's Notification
       Group / Notification Port fields. The mixer and the OpenAVC server
       must be on the same VLAN, and switches with IGMP snooping need an
       IGMP querier — if notices are filtered, control still works and
       changes appear at the poll interval instead.
    6. Enable Level Meters (off by default) streams live input/output
       meters into OpenAVC at about two updates per second — bind panel
       meter elements to the meter state values.

discovery:
  # The Audio-Technica control-unit family advertises one shared UPnP URN
  # when "Allow Discovery" is enabled; the modelName in the description XML
  # names the exact model (captured from ATDM-0604a hardware — the plain
  # 0604's modelName string is inferred from the same UPnP stack and, being
  # an exact match, simply never fires if wrong).
  # No active tcp_probe: g_firmware_version is answered identically across
  # the family, and every distinctive old-generation signature is a NAK,
  # which the newer models reproduce for other reasons.
  ssdp:
    - device_type: "urn:schemas-upnp-org:device:ATCUDevice:1"
      model: "ATDM-0604"
  oui:
    - "00:0a:45"
  port_open:
    - 17300
  manufacturer_alias:
    - "audio-technica"
    - "audio technica"
    - "at"

default_config:
  host: ""
  port: 17300
  poll_interval: 15
  inter_command_delay: 0.05
  notification_group: "225.0.0.100"
  notification_port: 17000
  enable_level_meters: false

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 17300
    label: Port
  poll_interval:
    type: integer
    default: 15
    min: 0
    label: Poll Interval (sec)
  inter_command_delay:
    type: number
    default: 0.05
    label: Inter-Command Delay (sec)
  notification_group:
    type: string
    default: "225.0.0.100"
    label: Notification Group
    help: >
      Multicast address the mixer sends its change notices to (Web Remote
      network settings). Leave at the factory default unless it was changed
      on the mixer.
  notification_port:
    type: integer
    default: 17000
    min: 1
    max: 65535
    label: Notification Port
    help: "UDP port for the mixer's multicast notices (factory default 17000)."
  enable_level_meters:
    type: boolean
    default: false
    label: Enable Level Meters
    help: >
      Stream live input/output level meters into OpenAVC (about two updates
      per second). Uses the mixer's Audio Level Notification; leave off if
      you don't bind meters on a panel.

# Rendered against config at connect: empty while Enable Level Meters is
# off, "1" when on — so the on_connect arming write below OMITS the Audio
# Level Notification field (leaving it as-is for other controllers)
# instead of writing 0.
config_derived:
  meters_flag: "{enable_level_meters:d}"

# Join the mixer's notice group while connected. MD frames feed the
# response rules below; only frames from this device's own address are
# accepted.
push:
  type: multicast
  group: "{notification_group}"
  port: "{notification_port}"

# Arm "IP Control Setting Notification" (field 7) — and, only when meters
# are enabled, "Audio Level Notification" (field 8) — via the s_network
# omission write (Table 4-8: the same 19-field layout as the ATDM-0604a).
# Applying without a reboot is verified on the ATDM-0604a only and assumed
# here; if this model honors the flag only after the reboot its spec calls
# for, the write is harmless (ACK) and notices simply stay off until
# enabled in Web Remote.
on_connect:
  - 's_network S 0000 00 NC ,,,,,,1,{meters_flag},,,,,,,,,,, \r'

state_variables:
  firmware_version:
    type: string
    label: Firmware Version
    help: "Firmware version string reported by the device (g_firmware_version)."
  input_1_level:
    type: number
    label: Input 1 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on input 1 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  input_2_level:
    type: number
    label: Input 2 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on input 2 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  input_3_level:
    type: number
    label: Input 3 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on input 3 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  input_4_level:
    type: number
    label: Input 4 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on input 4 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  input_5_level:
    type: number
    label: Input 5 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on input 5 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  input_6_level:
    type: number
    label: Input 6 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on input 6 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  input_st_level:
    type: number
    label: Input ST Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on the stereo input (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."

  # ── Input mutes (read-only: the original 0604 protocol has no input-mute
  #    set/get commands — these update only via the input_gain_level_notice
  #    push when the mute changes on the front panel or Web Remote) ──
  input_1_mute:
    type: boolean
    label: Input 1 Mute
    help: "True when input 1 is muted. Updates via push notification (front-panel/Web Remote changes); cannot be set through this protocol."
  input_2_mute:
    type: boolean
    label: Input 2 Mute
    help: "True when input 2 is muted. Updates via push notification (front-panel/Web Remote changes); cannot be set through this protocol."
  input_3_mute:
    type: boolean
    label: Input 3 Mute
    help: "True when input 3 is muted. Updates via push notification (front-panel/Web Remote changes); cannot be set through this protocol."
  input_4_mute:
    type: boolean
    label: Input 4 Mute
    help: "True when input 4 is muted. Updates via push notification (front-panel/Web Remote changes); cannot be set through this protocol."
  input_5_mute:
    type: boolean
    label: Input 5 Mute
    help: "True when input 5 is muted. Updates via push notification (front-panel/Web Remote changes); cannot be set through this protocol."
  input_6_mute:
    type: boolean
    label: Input 6 Mute
    help: "True when input 6 is muted. Updates via push notification (front-panel/Web Remote changes); cannot be set through this protocol."
  input_st_mute:
    type: boolean
    label: Input ST Mute
    help: "True when the stereo input is muted. Updates via push notification (front-panel/Web Remote changes); cannot be set through this protocol."
  output_1_level:
    type: number
    label: Output 1 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on output 1 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_2_level:
    type: number
    label: Output 2 Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on output 2 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_st_level:
    type: number
    label: Output ST Level
    min: 0
    max: 511
    step: 1
    control: true
    help: "Fader level on the stereo output (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_1_mute:
    type: boolean
    label: Output 1 Mute
    control: true
    help: "True when output 1 is muted."
  output_2_mute:
    type: boolean
    label: Output 2 Mute
    control: true
    help: "True when output 2 is muted."
  output_st_mute:
    type: boolean
    label: Output ST Mute
    control: true
    help: "True when the stereo output is muted."
  smart_mix_mode:
    type: integer
    label: SmartMix Mode
    help: "SmartMix operating mode (0 = Off, 1 = Gate, 2 = Gain Share)."
  last_mic_on:
    type: boolean
    label: Last Mic On
    help: "True when Last Mic On is enabled (the last open mic stays open in Gate mode)."
  gate_hold_time:
    type: string
    label: Gate Hold Time (ms)
    help: "Gate hold time in milliseconds (100-500 in 100 ms steps, 1000-10000 in 500 ms steps)."
  noma:
    type: boolean
    label: NOM Attenuation
    help: "True when NOM attenuation is enabled (output level compensates for the number of open mics)."
  open_mic_count:
    type: integer
    label: Open Mic Count
    help: "Maximum number of simultaneously open microphones in Gate mode (1-6)."
  priority_mode:
    type: integer
    label: Priority Mode
    help: "Gate priority mode (0 = Mode 1, 1 = Mode 2)."

  # ── SmartMix gate activity (updated live via push notification when
  #    SmartMix is enabled — great for "mic went live" automation) ──
  input_1_gate_open:
    type: boolean
    label: Input 1 Gate Open
    help: "True while SmartMix holds input 1's gate open (updates instantly via push)."
  input_2_gate_open:
    type: boolean
    label: Input 2 Gate Open
    help: "True while SmartMix holds input 2's gate open (updates instantly via push)."
  input_3_gate_open:
    type: boolean
    label: Input 3 Gate Open
    help: "True while SmartMix holds input 3's gate open (updates instantly via push)."
  input_4_gate_open:
    type: boolean
    label: Input 4 Gate Open
    help: "True while SmartMix holds input 4's gate open (updates instantly via push)."
  input_5_gate_open:
    type: boolean
    label: Input 5 Gate Open
    help: "True while SmartMix holds input 5's gate open (updates instantly via push)."
  input_6_gate_open:
    type: boolean
    label: Input 6 Gate Open
    help: "True while SmartMix holds input 6's gate open (updates instantly via push)."

  last_recalled_preset:
    type: integer
    label: Last Recalled Preset
    min: 1
    max: 6
    help: "Preset bank most recently recalled on the mixer (updates via push notification)."

  # ── Live level meters (post-fader, 0-61; only stream while Enable Level
  #    Meters is on — updates ~2/sec, background tier for the cloud relay) ──
  input_1_meter:
    type: integer
    label: Input 1 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for input 1 (0-61; requires Enable Level Meters)."
  input_2_meter:
    type: integer
    label: Input 2 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for input 2 (0-61; requires Enable Level Meters)."
  input_3_meter:
    type: integer
    label: Input 3 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for input 3 (0-61; requires Enable Level Meters)."
  input_4_meter:
    type: integer
    label: Input 4 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for input 4 (0-61; requires Enable Level Meters)."
  input_5_meter:
    type: integer
    label: Input 5 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for input 5 (0-61; requires Enable Level Meters)."
  input_6_meter:
    type: integer
    label: Input 6 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for input 6 (0-61; requires Enable Level Meters)."
  input_st_l_meter:
    type: integer
    label: Input ST L Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for the stereo input, left (0-61; requires Enable Level Meters)."
  input_st_r_meter:
    type: integer
    label: Input ST R Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for the stereo input, right (0-61; requires Enable Level Meters)."
  output_1_meter:
    type: integer
    label: Output 1 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for output 1 (0-61; requires Enable Level Meters)."
  output_2_meter:
    type: integer
    label: Output 2 Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for output 2 (0-61; requires Enable Level Meters)."
  output_st_l_meter:
    type: integer
    label: Output ST L Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for the stereo output, left (0-61; requires Enable Level Meters)."
  output_st_r_meter:
    type: integer
    label: Output ST R Meter
    min: 0
    max: 61
    cloud_priority: low
    help: "Post-fader level meter for the stereo output, right (0-61; requires Enable Level Meters)."

commands:
  # ── Input Level Control ──
  set_input_level:
    label: Set Input Level
    send: 's_input_gain_level S 0000 00 NC {channel},,,{level},,, \r'
    help: >
      Set the fader level for an input channel (0=mute, 1=-120dB, 411=0dB,
      511=+10dB). The preamp gain and the other input settings are left
      unchanged (omitted-parameter write).
    params:
      channel:
        type: enum
        required: true
        label: Input Channel
        values: ["0", "1", "2", "3", "4", "5", "10"]
        help: "0-5 = Input 1-6, 10 = Input ST (channels 6-9 do not exist)"
      level:
        type: integer
        required: true
        label: Level (Fader)
        min: 0
        max: 511
        help: "0=mute, 1=-120dB, 411=0dB, 511=+10dB"

  set_input_gain:
    label: Set Input Gain
    send: 's_input_gain_level S 0000 00 NC {channel},{gain},{gain},,,, \r'
    help: >
      Set the mic/line preamp gain for an input channel. The fader level
      and the other input settings are left unchanged.
    params:
      channel:
        type: enum
        required: true
        label: Input Channel
        values: ["0", "1", "2", "3", "4", "5", "10"]
        help: "0-5 = Input 1-6, 10 = Input ST"
      gain:
        type: integer
        required: true
        label: Preamp Gain
        min: 0
        max: 40
        help: "0-40: Mic = +20 to +60 dB, Line = -20 to -60 dBu"

  # ── Output Level Control ──
  set_output_level:
    label: Set Output Level
    send: 's_output_level S 0000 00 NC {channel},{level},, \r'
    help: >
      Set the output level for a channel. Level is a fader value (0=mute,
      1=-120dB, 511=+10dB).
    params:
      channel:
        type: enum
        required: true
        label: Output Channel
        values: ["0", "1", "10"]
        help: "0 = Output 1, 1 = Output 2, 10 = Output ST (the 0604 has no other outputs)"
      level:
        type: integer
        required: true
        label: Level (Fader)
        min: 0
        max: 511
        help: "0=mute, 1=-120dB, 411=0dB, 511=+10dB"

  # ── Output Mute Control ──
  output_mute_on:
    label: Output Mute On
    send: 's_output_mute S 0000 00 NC {channel},1 \r'
    help: "Mute an output channel."
    params:
      channel:
        type: enum
        required: true
        label: Output Channel
        values: ["0", "1", "10"]
        help: "0 = Output 1, 1 = Output 2, 10 = Output ST"

  output_mute_off:
    label: Output Mute Off
    send: 's_output_mute S 0000 00 NC {channel},0 \r'
    help: "Unmute an output channel."
    params:
      channel:
        type: enum
        required: true
        label: Output Channel
        values: ["0", "1", "10"]
        help: "0 = Output 1, 1 = Output 2, 10 = Output ST"

  # ── Smart Mix Control ──
  set_smart_mix:
    label: Set SmartMix Channel
    send: 's_smart_mix S 0000 00 NC {channel},{weight},,,,{priority},{can_cut},{off_attenuation} \r'
    help: >
      Configure the per-channel SmartMix settings for an input. Writes the
      full documented field set: gain-share weight, gate priority, can cut,
      and off attenuation (the three reserved fields are left empty).
    params:
      channel:
        type: integer
        required: true
        label: Input Channel
        min: 0
        max: 5
        help: "0-5 = Input 1-6"
      weight:
        type: integer
        default: 30
        label: Gain Share Weight
        min: 0
        max: 60
        help: "0-60 = -15 dB to +15 dB in 0.5 dB steps (30 = 0 dB); used in Gain Share mode"
      priority:
        type: integer
        default: 0
        label: Gate Priority
        min: 0
        max: 1
        help: "1 = priority channel in Gate mode"
      can_cut:
        type: integer
        default: 0
        label: Can Cut
        min: 0
        max: 1
        help: "1 = channel can be cut in Gate mode"
      off_attenuation:
        type: integer
        default: 40
        label: Off Attenuation
        min: 0
        max: 60
        help: "0-60 = 0 to -60 dB attenuation (1 dB steps) when the mic is gated off"

  set_smart_mix_mode:
    label: Set SmartMix Mode
    send: 's_smart_mix_general S 0000 00 NC {mode},,,,, \r'
    help: "Set the SmartMix operating mode (other common settings are left unchanged)."
    params:
      mode:
        type: integer
        required: true
        label: Mode
        min: 0
        max: 2
        help: "0=Off, 1=Gate, 2=Gain Share"

  set_open_mic_count:
    label: Set Open Mic Count
    send: 's_smart_mix_general S 0000 00 NC ,,,,{count}, \r'
    help: "Set the maximum number of simultaneously open microphones (Gate mode)."
    params:
      count:
        type: integer
        required: true
        label: Open Mic Count
        min: 1
        max: 6
        help: "1-6 mics"

  # ── Preset Control ──
  recall_preset:
    label: Recall Preset
    send: 'call_preset S 0000 00 NC {preset} \r'
    help: "Load a saved preset."
    params:
      preset:
        type: enum
        required: true
        label: Preset Number
        values: ["1", "2", "3", "4", "5", "6"]
        help: "Preset bank 1-6"

  save_preset:
    label: Save Preset
    send: 'save_preset S 0000 00 NC {preset} \r'
    help: "Save current settings to a preset."
    params:
      preset:
        type: enum
        required: true
        label: Preset Number
        values: ["1", "2", "3", "4", "5", "6"]
        help: "Preset bank 1-6"

  # ── System Commands ──
  set_meter_interval:
    label: Set Meter Interval
    send: 's_level_meter_interval S 0000 00 NC {interval} \r'
    help: >
      Set how often the mixer sends level-meter notices. This is a global
      setting on the mixer shared by every connected controller.
    params:
      interval:
        type: integer
        required: true
        default: 500
        label: Interval (ms)
        min: 100
        max: 10000
        help: "Meter notification interval in milliseconds (mixer default 100)."

  identify:
    label: Identify (Blink LED)
    send: 'identify S 0000 00 NC \r'
    help: "Blinks the front panel LED to identify the unit."

  reboot:
    label: Reboot
    send: 'reboot S 0000 00 NC \r'
    help: "Reboots the ATDM-0604."

# ── Device settings (SmartMix common settings — writable + read back via
#    g_smart_mix_general; each write changes only its own field, using the
#    protocol's omitted-parameter convention) ──
device_settings:
  smart_mix_mode:
    type: integer
    min: 0
    max: 2
    label: SmartMix Mode
    help: "0 = Off, 1 = Gate, 2 = Gain Share."
    state_key: smart_mix_mode
    default: 0
    setup: false
    write:
      send: 's_smart_mix_general S 0000 00 NC {value},,,,, \r'
  last_mic_on:
    type: boolean
    label: Last Mic On
    help: "Keep the last open microphone open in Gate mode."
    state_key: last_mic_on
    default: false
    setup: false
    write:
      send: 's_smart_mix_general S 0000 00 NC ,{value:d},,,, \r'
  gate_hold_time:
    type: enum
    values: ["100", "200", "300", "400", "500", "1000", "1500", "2000", "2500", "3000", "3500", "4000", "4500", "5000", "5500", "6000", "6500", "7000", "7500", "8000", "8500", "9000", "9500", "10000"]
    label: Gate Hold Time (ms)
    help: "How long a gated mic stays open after the signal drops."
    state_key: gate_hold_time
    default: "2500"
    setup: false
    write:
      send: 's_smart_mix_general S 0000 00 NC ,,{value},,, \r'
  noma:
    type: boolean
    label: NOM Attenuation
    help: "Attenuate the output as more microphones open (number-of-open-mics compensation)."
    state_key: noma
    default: false
    setup: false
    write:
      send: 's_smart_mix_general S 0000 00 NC ,,,{value:d},, \r'
  open_mic_count:
    type: integer
    min: 1
    max: 6
    label: Open Mic Count
    help: "Maximum number of simultaneously open microphones in Gate mode."
    state_key: open_mic_count
    default: 4
    setup: false
    write:
      send: 's_smart_mix_general S 0000 00 NC ,,,,{value}, \r'
  priority_mode:
    type: integer
    min: 0
    max: 1
    label: Priority Mode
    help: "Gate priority behavior: 0 = Mode 1, 1 = Mode 2."
    state_key: priority_mode
    default: 0
    setup: false
    write:
      send: 's_smart_mix_general S 0000 00 NC ,,,,,{value} \r'

# ── Quick actions ──
actions:
  - id: recall_preset
    icon: bookmark
  - id: output_mute_on
    icon: volume-x
  - id: output_mute_off
    icon: volume-2
  - id: identify
    icon: sun

responses:
  # ── Firmware version answer ──
  - match: 'g_firmware_version 0000 \S+ NC (\S+)'
    set: { firmware_version: "$1" }

  # ── SmartMix common settings answer (one line fans out into six vars) ──
  - match: 'g_smart_mix_general 0000 \S+ NC (\d+),(\d+),(\d+),(\d+),(\d+),(\d+)'
    set:
      smart_mix_mode: "$1"
      last_mic_on: "$2"
      gate_hold_time: "$3"
      noma: "$4"
      open_mic_count: "$5"
      priority_mode: "$6"

  # ── Input level answers (channels 0-5 map to input_1_level through
  #    input_6_level; channel 10 is the stereo input) ──
  - match: 'g_input_gain_level 0000 \S+ NC 10,\d+,\d+,(\d+)'
    set: { input_st_level: "$1" }
  - match: 'g_input_gain_level 0000 \S+ NC 0,\d+,\d+,(\d+)'
    set: { input_1_level: "$1" }
  - match: 'g_input_gain_level 0000 \S+ NC 1,\d+,\d+,(\d+)'
    set: { input_2_level: "$1" }
  - match: 'g_input_gain_level 0000 \S+ NC 2,\d+,\d+,(\d+)'
    set: { input_3_level: "$1" }
  - match: 'g_input_gain_level 0000 \S+ NC 3,\d+,\d+,(\d+)'
    set: { input_4_level: "$1" }
  - match: 'g_input_gain_level 0000 \S+ NC 4,\d+,\d+,(\d+)'
    set: { input_5_level: "$1" }
  - match: 'g_input_gain_level 0000 \S+ NC 5,\d+,\d+,(\d+)'
    set: { input_6_level: "$1" }

  # ── Output level answers (channels 0, 1, 10=ST) ──
  - match: 'g_output_level 0000 \S+ NC 10,(\d+)'
    set: { output_st_level: "$1" }
  - match: 'g_output_level 0000 \S+ NC 0,(\d+)'
    set: { output_1_level: "$1" }
  - match: 'g_output_level 0000 \S+ NC 1,(\d+)'
    set: { output_2_level: "$1" }

  # ── Output mute answers (channels 0, 1, 10=ST) ──
  - match: 'g_output_mute 0000 \S+ NC 10,1'
    set: { output_st_mute: "true" }
  - match: 'g_output_mute 0000 \S+ NC 10,0'
    set: { output_st_mute: "false" }
  - match: 'g_output_mute 0000 \S+ NC 0,1'
    set: { output_1_mute: "true" }
  - match: 'g_output_mute 0000 \S+ NC 0,0'
    set: { output_1_mute: "false" }
  - match: 'g_output_mute 0000 \S+ NC 1,1'
    set: { output_2_mute: "true" }
  - match: 'g_output_mute 0000 \S+ NC 1,0'
    set: { output_2_mute: "false" }

  # ── MD push notices (multicast; see push: block). Same first-match
  #    dispatch as the answers above. The spec fixes the Unit No slot at 00
  #    ("Not used"); \S+ per the file convention. Spec: "some parameters can
  #    be omitted" — level/mute captures are OPTIONAL groups so an omitted
  #    field simply skips its mapping instead of storing garbage. ST channel
  #    (10) rules precede 0-5 per the file convention. ──

  # Input gain/level/mute changed (Table 5-6: ch, mic_gain, line_gain,
  # level, mute). The mute slot feeds the read-only input mute vars — the
  # only source this protocol has for input mute state.
  - match: 'MD input_gain_level_notice 0000 \S+ NC 10,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_st_level: "$1", input_st_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 0,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_1_level: "$1", input_1_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 1,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_2_level: "$1", input_2_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 2,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_3_level: "$1", input_3_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 3,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_4_level: "$1", input_4_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 4,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_5_level: "$1", input_5_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 5,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_6_level: "$1", input_6_mute: "$2" }

  # Output level changed (Table 5-7: ch, level — the spec's own example
  # shows five values, but the table documents exactly two; trust the table)
  - match: 'MD output_level_notice 0000 \S+ NC 10,(\d+)'
    set: { output_st_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 0,(\d+)'
    set: { output_1_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 1,(\d+)'
    set: { output_2_level: "$1" }

  # Output mute changed (Table 5-10: ch, mute)
  - match: 'MD output_mute_notice 0000 \S+ NC 10,([01])'
    set: { output_st_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 0,([01])'
    set: { output_1_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 1,([01])'
    set: { output_2_mute: "$1" }

  # SmartMix gate open/close (Table 5-3: all six inputs in ONE frame —
  # unlike the per-channel notice of the newer protocol generation) — sent
  # while SmartMix is on
  - match: 'MD open_channel_notice 0000 \S+ NC ([01]),([01]),([01]),([01]),([01]),([01])'
    set:
      input_1_gate_open: "$1"
      input_2_gate_open: "$2"
      input_3_gate_open: "$3"
      input_4_gate_open: "$4"
      input_5_gate_open: "$5"
      input_6_gate_open: "$6"

  # Preset recalled (Table 5-5: bank 1-6; the notice's value 0 means "not
  # selected" and is deliberately unmatched) — fires for front-panel, Web
  # Remote, and IP
  - match: 'MD recall_preset_notice 0000 \S+ NC ([1-6])'
    set: { last_recalled_preset: "$1" }

  # Level meters: 44 values (Table 5-2) — 12 post-fader (In1-6, ST L/R,
  # Out1-2, ST L/R, 0-61) then 8 pre-fader + 4 AEC + 8 gain-share +
  # 12 dynamics (unmapped). Arrives at the meter interval (mixer default
  # 100 ms); throttled to ~2 writes/sec.
  - match: 'MD level_meter_notice 0000 \S+ NC (\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),'
    throttle: 0.5
    set:
      input_1_meter: "$1"
      input_2_meter: "$2"
      input_3_meter: "$3"
      input_4_meter: "$4"
      input_5_meter: "$5"
      input_6_meter: "$6"
      input_st_l_meter: "$7"
      input_st_r_meter: "$8"
      output_1_meter: "$9"
      output_2_meter: "$10"
      output_st_l_meter: "$11"
      output_st_r_meter: "$12"

polling:
  queries:
    - 'g_firmware_version O 0000 00 NC \r'
    - 'g_smart_mix_general O 0000 00 NC \r'
    - 'g_input_gain_level O 0000 00 NC 0 \r'
    - 'g_input_gain_level O 0000 00 NC 1 \r'
    - 'g_input_gain_level O 0000 00 NC 2 \r'
    - 'g_input_gain_level O 0000 00 NC 3 \r'
    - 'g_input_gain_level O 0000 00 NC 4 \r'
    - 'g_input_gain_level O 0000 00 NC 5 \r'
    - 'g_input_gain_level O 0000 00 NC 10 \r'
    - 'g_output_level O 0000 00 NC 0 \r'
    - 'g_output_level O 0000 00 NC 1 \r'
    - 'g_output_level O 0000 00 NC 10 \r'
    - 'g_output_mute O 0000 00 NC 0 \r'
    - 'g_output_mute O 0000 00 NC 1 \r'
    - 'g_output_mute O 0000 00 NC 10 \r'

# ── LIVENESS WATCHDOG ──
# The ATDM protocol is asynchronous and push-capable: between polls a quiet
# room produces no traffic, and fire-and-forget poll queries never notice a
# mixer that dropped without a FIN. Probe the documented firmware-version
# query (the same one polling uses) and require its answer within 5 s; two
# silent probes force a reconnect with a typed no_response fault. The expect
# is unanchored — the poll cycle's own g_firmware_version answer satisfies a
# pending probe too, but MD pushes cannot.
liveness:
  send: 'g_firmware_version O 0000 00 NC \r'
  expect: 'g_firmware_version 0000'
  interval: 30
  timeout: 5
  max_failures: 2

# ── SIMULATOR DEFINITION ──
# Simulates the TCP control surface (polling + commands) plus the MD push
# channel: because the driver declares a multicast push: block, the
# notifications templates below are emitted to the notification group over
# UDP multicast — never on the TCP connection — exactly like the real mixer.
simulator:
  initial_state:
    firmware_version: "1.0.2"
    input_1_level: 411
    input_2_level: 411
    input_3_level: 411
    input_4_level: 411
    input_5_level: 411
    input_6_level: 411
    input_st_level: 411
    input_1_mute: false
    input_2_mute: false
    input_3_mute: false
    input_4_mute: false
    input_5_mute: false
    input_6_mute: false
    input_st_mute: false
    output_1_level: 411
    output_2_level: 411
    output_st_level: 411
    output_1_mute: false
    output_2_mute: false
    output_st_mute: false
    smart_mix_mode: 0
    last_mic_on: 0
    gate_hold_time: 2500
    noma: 0
    open_mic_count: 4
    priority_mode: 0
    input_1_gate_open: false
    input_2_gate_open: false
    input_3_gate_open: false
    input_4_gate_open: false
    input_5_gate_open: false
    input_6_gate_open: false
    last_recalled_preset: 1

  delays:
    command_response: 0.03

  # MD notices, emitted to the driver's multicast push group on any state
  # change (Simulator UI toggles included). Templates render the same frame
  # grammar the response rules parse; {value:d} turns booleans into 0/1.
  # Level/mute changes use the omitted-parameter forms the real mixer's
  # grammar allows, so the optional-capture response rules are exercised.
  notifications:
    input_1_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 0,,,{value}, '
    input_2_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 1,,,{value}, '
    input_3_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 2,,,{value}, '
    input_4_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 3,,,{value}, '
    input_5_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 4,,,{value}, '
    input_6_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 5,,,{value}, '
    input_st_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 10,,,{value}, '
    input_1_mute:
      '*': 'MD input_gain_level_notice 0000 00 NC 0,,,,{value:d} '
    input_2_mute:
      '*': 'MD input_gain_level_notice 0000 00 NC 1,,,,{value:d} '
    input_3_mute:
      '*': 'MD input_gain_level_notice 0000 00 NC 2,,,,{value:d} '
    input_4_mute:
      '*': 'MD input_gain_level_notice 0000 00 NC 3,,,,{value:d} '
    input_5_mute:
      '*': 'MD input_gain_level_notice 0000 00 NC 4,,,,{value:d} '
    input_6_mute:
      '*': 'MD input_gain_level_notice 0000 00 NC 5,,,,{value:d} '
    input_st_mute:
      '*': 'MD input_gain_level_notice 0000 00 NC 10,,,,{value:d} '
    output_1_level:
      '*': 'MD output_level_notice 0000 00 NC 0,{value} '
    output_2_level:
      '*': 'MD output_level_notice 0000 00 NC 1,{value} '
    output_st_level:
      '*': 'MD output_level_notice 0000 00 NC 10,{value} '
    output_1_mute:
      '*': 'MD output_mute_notice 0000 00 NC 0,{value:d} '
    output_2_mute:
      '*': 'MD output_mute_notice 0000 00 NC 1,{value:d} '
    output_st_mute:
      '*': 'MD output_mute_notice 0000 00 NC 10,{value:d} '
    # The 0604's open_channel_notice carries all six gates in one frame; a
    # template can only render the toggled key, so the other five slots
    # render 0 (the real mixer sends the live snapshot of all six).
    input_1_gate_open:
      '*': 'MD open_channel_notice 0000 00 NC {value:d},0,0,0,0,0 '
    input_2_gate_open:
      '*': 'MD open_channel_notice 0000 00 NC 0,{value:d},0,0,0,0 '
    input_3_gate_open:
      '*': 'MD open_channel_notice 0000 00 NC 0,0,{value:d},0,0,0 '
    input_4_gate_open:
      '*': 'MD open_channel_notice 0000 00 NC 0,0,0,{value:d},0,0 '
    input_5_gate_open:
      '*': 'MD open_channel_notice 0000 00 NC 0,0,0,0,{value:d},0 '
    input_6_gate_open:
      '*': 'MD open_channel_notice 0000 00 NC 0,0,0,0,0,{value:d} '
    last_recalled_preset:
      '*': 'MD recall_preset_notice 0000 00 NC {value} '

  controls:
    - type: slider
      key: input_1_level
      label: Input 1 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: input_2_level
      label: Input 2 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: input_3_level
      label: Input 3 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: input_4_level
      label: Input 4 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: input_5_level
      label: Input 5 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: input_6_level
      label: Input 6 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: input_st_level
      label: Input ST Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: output_1_level
      label: Output 1 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: output_2_level
      label: Output 2 Level
      min: 0
      max: 511
      step: 1
    - type: slider
      key: output_st_level
      label: Output ST Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_1_mute
      label: Output 1 Mute
    - type: toggle
      key: output_2_mute
      label: Output 2 Mute
    - type: toggle
      key: output_st_mute
      label: Output ST Mute
    - type: toggle
      key: input_1_gate_open
      label: Input 1 Gate Open
    - type: toggle
      key: input_2_gate_open
      label: Input 2 Gate Open

  command_handlers:
    # Firmware version query
    - match: 'g_firmware_version O 0000 00 NC ?'
      handler: |
        respond(f'g_firmware_version 0000 00 NC {state["firmware_version"]} \r')

    # SmartMix common settings query
    - match: 'g_smart_mix_general O 0000 00 NC ?'
      handler: |
        respond(
            f'g_smart_mix_general 0000 00 NC {state["smart_mix_mode"]},'
            f'{state["last_mic_on"]},{state["gate_hold_time"]},'
            f'{state["noma"]},{state["open_mic_count"]},{state["priority_mode"]} \r'
        )

    # SmartMix common settings set (omitted fields stay unchanged)
    - match: 's_smart_mix_general S 0000 00 NC (.*) ?'
      handler: |
        parts = match.group(1).split(',')
        keys = ['smart_mix_mode', 'last_mic_on', 'gate_hold_time',
                'noma', 'open_mic_count', 'priority_mode']
        for i, value in enumerate(parts):
            if i < len(keys) and value.strip():
                state[keys[i]] = int(value)
        respond('s_smart_mix_general ACK \r')

    # Input gain/level query (channel 10 = stereo input)
    - match: 'g_input_gain_level O 0000 00 NC (\d+) ?'
      handler: |
        ch = match.group(1)
        key = 'input_st_level' if ch == '10' else f'input_{int(ch)+1}_level'
        level = state.get(key, 411)
        respond(f'g_input_gain_level 0000 00 NC {ch},20,20,{level},0,0,0 \r')

    # Input gain/level set (7 params: ch, mic gain, line gain, level, max_en,
    # max_vol, mute — omitted fields between commas stay unchanged, so the
    # level is only applied when its position is non-empty)
    - match: 's_input_gain_level S 0000 00 NC (\d+),(.*)'
      handler: |
        ch = match.group(1)
        parts = match.group(2).strip().split(',')
        if len(parts) >= 3 and parts[2].strip():
            key = 'input_st_level' if ch == '10' else f'input_{int(ch)+1}_level'
            state[key] = int(parts[2])
        respond('s_input_gain_level ACK \r')

    # Output level query (valid channels: 0, 1, 10 — others NAK like the device)
    - match: 'g_output_level O 0000 00 NC (\d+) ?'
      handler: |
        ch = match.group(1)
        if ch == '10':
            respond(f'g_output_level 0000 00 NC 10,{state.get("output_st_level", 411)},0,0 \r')
        elif ch in ('0', '1'):
            key = f'output_{int(ch)+1}_level'
            respond(f'g_output_level 0000 00 NC {ch},{state.get(key, 411)},0,0 \r')
        else:
            respond('g_output_level NAK 01 \r')

    # Output level set
    - match: 's_output_level S 0000 00 NC (\d+),(\d+).*'
      handler: |
        ch = match.group(1)
        if ch == '10':
            state['output_st_level'] = int(match.group(2))
            respond('s_output_level ACK \r')
        elif ch in ('0', '1'):
            state[f'output_{int(ch)+1}_level'] = int(match.group(2))
            respond('s_output_level ACK \r')
        else:
            respond('s_output_level NAK 01 \r')

    # Output mute query
    - match: 'g_output_mute O 0000 00 NC (\d+) ?'
      handler: |
        ch = match.group(1)
        if ch == '10':
            val = 1 if state.get('output_st_mute', False) else 0
            respond(f'g_output_mute 0000 00 NC 10,{val} \r')
        elif ch in ('0', '1'):
            val = 1 if state.get(f'output_{int(ch)+1}_mute', False) else 0
            respond(f'g_output_mute 0000 00 NC {ch},{val} \r')
        else:
            respond('g_output_mute NAK 01 \r')

    # Output mute set
    - match: 's_output_mute S 0000 00 NC (\d+),(\d+) ?'
      handler: |
        ch = match.group(1)
        mute = match.group(2) == '1'
        if ch == '10':
            state['output_st_mute'] = mute
            respond('s_output_mute ACK \r')
        elif ch in ('0', '1'):
            state[f'output_{int(ch)+1}_mute'] = mute
            respond('s_output_mute ACK \r')
        else:
            respond('s_output_mute NAK 01 \r')

    # Per-channel SmartMix set (8 fields incl. reserved; not tracked as state)
    - match: 's_smart_mix S 0000 00 NC.*'
      handler: |
        respond('s_smart_mix ACK \r')

    # Network settings write (the driver's on_connect notification arming)
    - match: 's_network S 0000 00 NC.*'
      handler: |
        respond('s_network ACK \r')

    # Level meter interval write
    - match: 's_level_meter_interval S 0000 00 NC.*'
      handler: |
        respond('s_level_meter_interval ACK \r')

    # Preset recall (recall updates state, which emits the MD notice)
    - match: 'call_preset S 0000 00 NC (\d) ?'
      handler: |
        state['last_recalled_preset'] = int(match.group(1))
        respond('call_preset ACK \r')

    # Preset save
    - match: 'save_preset S 0000 00 NC.*'
      handler: |
        respond('save_preset ACK \r')

    # Identify
    - match: 'identify S 0000 00 NC.*'
      handler: |
        respond('identify ACK \r')

    # Reboot
    - match: 'reboot S 0000 00 NC.*'
      handler: |
        respond('reboot ACK \r')

  error_modes:
    communication_timeout:
      description: "Mixer stops responding"
      behavior: no_response
