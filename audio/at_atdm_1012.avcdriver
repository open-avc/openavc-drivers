# ── SIMULATOR DEFINITION ──
simulator:
  initial_state:
    firmware_version: "1.0.0"
    input_1_level: 411
    input_2_level: 411
    input_3_level: 411
    input_4_level: 411
    input_5_level: 411
    input_6_level: 411
    input_7_level: 411
    input_8_level: 411
    input_9_level: 411
    input_10_level: 411
    input_1_mute: false
    input_2_mute: false
    input_3_mute: false
    input_4_mute: false
    input_5_mute: false
    input_6_mute: false
    input_7_mute: false
    input_8_mute: false
    input_9_mute: false
    input_10_mute: false
    output_1_level: 411
    output_2_level: 411
    output_3_level: 411
    output_4_level: 411
    output_5_level: 411
    output_6_level: 411
    output_7_level: 411
    output_8_level: 411
    output_1_mute: false
    output_2_mute: false
    output_3_mute: false
    output_4_mute: false
    output_5_mute: false
    output_6_mute: false
    output_7_mute: false
    output_8_mute: false

  delays:
    command_response: 0.03

  controls:
    - type: slider
      key: input_1_level
      label: Input 1 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_1_mute
      label: Input 1 Mute
    - type: slider
      key: input_2_level
      label: Input 2 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_2_mute
      label: Input 2 Mute
    - type: slider
      key: input_3_level
      label: Input 3 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_3_mute
      label: Input 3 Mute
    - type: slider
      key: input_4_level
      label: Input 4 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_4_mute
      label: Input 4 Mute
    - type: slider
      key: input_5_level
      label: Input 5 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_5_mute
      label: Input 5 Mute
    - type: slider
      key: input_6_level
      label: Input 6 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_6_mute
      label: Input 6 Mute
    - type: slider
      key: input_7_level
      label: Input 7 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_7_mute
      label: Input 7 Mute
    - type: slider
      key: input_8_level
      label: Input 8 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_8_mute
      label: Input 8 Mute
    - type: slider
      key: input_9_level
      label: Input 9 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_9_mute
      label: Input 9 Mute
    - type: slider
      key: input_10_level
      label: Input 10 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: input_10_mute
      label: Input 10 Mute
    - type: slider
      key: output_1_level
      label: Output 1 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_1_mute
      label: Output 1 Mute
    - type: slider
      key: output_2_level
      label: Output 2 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_2_mute
      label: Output 2 Mute
    - type: slider
      key: output_3_level
      label: Output 3 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_3_mute
      label: Output 3 Mute
    - type: slider
      key: output_4_level
      label: Output 4 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_4_mute
      label: Output 4 Mute
    - type: slider
      key: output_5_level
      label: Output 5 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_5_mute
      label: Output 5 Mute
    - type: slider
      key: output_6_level
      label: Output 6 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_6_mute
      label: Output 6 Mute
    - type: slider
      key: output_7_level
      label: Output 7 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_7_mute
      label: Output 7 Mute
    - type: slider
      key: output_8_level
      label: Output 8 Level
      min: 0
      max: 511
      step: 1
    - type: toggle
      key: output_8_mute
      label: Output 8 Mute

  command_handlers:
    # Firmware version query
    - match: 'g_firmware_version O 0000 00 NC'
      handler: |
        respond(f'g_firmware_version 0000 00 NC {state["firmware_version"]}\r')

    # Input level query (short command)
    - match: 'GICL O 0000 00 NC (\d+)'
      handler: |
        ch = int(match.group(1))
        key = f'input_{ch+1}_level'
        level = state.get(key, 411)
        respond(f'GICL 0000 00 NC {ch},{level}\r')

    # Input level set (short command)
    - match: 'SICL S 0000 00 NC (\d+),(\d+)'
      handler: |
        ch = int(match.group(1))
        level = int(match.group(2))
        key = f'input_{ch+1}_level'
        state[key] = level
        respond('SICL ACK\r')

    # Input mute query (short command)
    - match: 'GICM O 0000 00 NC (\d+)'
      handler: |
        ch = int(match.group(1))
        key = f'input_{ch+1}_mute'
        val = 1 if state.get(key, False) else 0
        respond(f'GICM 0000 00 NC {ch},{val}\r')

    # Input mute set (short command)
    - match: 'SICM S 0000 00 NC (\d+),(\d+)'
      handler: |
        ch = int(match.group(1))
        mute = match.group(2) == '1'
        key = f'input_{ch+1}_mute'
        state[key] = mute
        respond('SICM ACK\r')

    # Output level query (short command)
    - match: 'GOCL O 0000 00 NC (\d+)'
      handler: |
        ch = int(match.group(1))
        key = f'output_{ch+1}_level'
        level = state.get(key, 411)
        respond(f'GOCL 0000 00 NC {ch},{level}\r')

    # Output level set (short command)
    - match: 'SOCL S 0000 00 NC (\d+),(\d+)'
      handler: |
        ch = int(match.group(1))
        level = int(match.group(2))
        key = f'output_{ch+1}_level'
        state[key] = level
        respond('SOCL ACK\r')

    # Output mute query (short command)
    - match: 'GOCM O 0000 00 NC (\d+)'
      handler: |
        ch = int(match.group(1))
        key = f'output_{ch+1}_mute'
        val = 1 if state.get(key, False) else 0
        respond(f'GOCM 0000 00 NC {ch},{val}\r')

    # Output mute set (short command)
    - match: 'SOCM S 0000 00 NC (\d+),(\d+)'
      handler: |
        ch = int(match.group(1))
        mute = match.group(2) == '1'
        key = f'output_{ch+1}_mute'
        state[key] = mute
        respond('SOCM ACK\r')

    # Bus assign set
    - match: 'SBUS S 0000 00 NC.*'
      handler: |
        respond('SBUS ACK\r')

    # Operator fader level set
    - match: 'SOPL S 0000 00 NC.*'
      handler: |
        respond('SOPL ACK\r')

    # Operator fader mute set
    - match: 'SOPM S 0000 00 NC.*'
      handler: |
        respond('SOPM ACK\r')

    # SmartMix mode set
    - match: 'SSMM S 0000 00 NC.*'
      handler: |
        respond('SSMM ACK\r')

    # Open mic count set
    - match: 'NOOM S 0000 00 NC.*'
      handler: |
        respond('NOOM ACK\r')

    # Preset recall
    - match: 'CALLP S 0000 00 NC.*'
      handler: |
        respond('CALLP ACK\r')

    # Preset save
    - match: 'REGIP S 0000 00 NC.*'
      handler: |
        respond('REGIP ACK\r')

    # Partial preset recall
    - match: 'CALLPP S 0000 00 NC.*'
      handler: |
        respond('CALLPP ACK\r')

    # Identify
    - match: 'identify S 0000 00 NC.*'
      handler: |
        respond('identify ACK\r')

    # Reboot
    - match: 'reboot S 0000 00 NC.*'
      handler: |
        respond('reboot ACK\r')

  error_modes:
    communication_timeout:
      description: "Mixer stops responding"
      behavior: no_response
