    label: Input 10 Level
    help: "Fader level on input 10 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  input_1_mute:
    type: boolean
    label: Input 1 Mute
    help: "True when input 1 is muted."
  input_2_mute:
    type: boolean
    label: Input 2 Mute
    help: "True when input 2 is muted."
  input_3_mute:
    type: boolean
    label: Input 3 Mute
    help: "True when input 3 is muted."
  input_4_mute:
    type: boolean
    label: Input 4 Mute
    help: "True when input 4 is muted."
