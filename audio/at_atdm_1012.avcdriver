    help: "True when input 10 is muted."
  output_1_level:
    type: number
    label: Output 1 Level
    help: "Fader level on output 1 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_2_level:
    type: number
    label: Output 2 Level
    help: "Fader level on output 2 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_3_level:
    type: number
    label: Output 3 Level
    help: "Fader level on output 3 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_4_level:
    type: number
    label: Output 4 Level
    help: "Fader level on output 4 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_5_level:
    type: number
    label: Output 5 Level
    help: "Fader level on output 5 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_6_level:
    type: number
    label: Output 6 Level
    help: "Fader level on output 6 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_7_level:
    type: number
    label: Output 7 Level
    help: "Fader level on output 7 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_8_level:
    type: number
    label: Output 8 Level
    help: "Fader level on output 8 (0 = mute, 1 = -120 dB, 411 = 0 dB, 511 = +10 dB)."
  output_1_mute:
