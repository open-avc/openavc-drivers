commands:
  # ── Input Level Control (short commands) ──
  set_input_level:
    label: Set Input Level
    send: 'SICL S 0000 00 NC {channel},{level} \r'
    help: >
      Set the input level for a channel using the short command format.
      Level is a fader value (0=mute, 1=-120dB, 411=0dB, 511=+10dB).
    params:
      channel:
        type: integer
        required: true
        label: Input Channel
        min: 0
        max: 19
        help: "0-9 = Input 1-10, 10 = ST1, 11 = ST2, 12-19 = Sub Input 1-8"
      level:
        type: integer
        required: true
        label: Level (Fader)
        min: 0
        max: 511
        help: "0=mute, 1=-120dB, 411=0dB, 511=+10dB"

  # ── Input Mute Control ──
  input_mute_on:
    label: Input Mute On
    send: 'SICM S 0000 00 NC {channel},1 \r'
    help: "Mute an input channel."
    params:
      channel:
        type: integer
        required: true
        label: Input Channel
        min: 0
        max: 19
        help: "0-9 = Input 1-10, 10 = ST1, 11 = ST2, 12-19 = Sub Input 1-8"

  input_mute_off:
    label: Input Mute Off
    send: 'SICM S 0000 00 NC {channel},0 \r'
    help: "Unmute an input channel."
    params:
      channel:
        type: integer
        required: true
        label: Input Channel
        min: 0
        max: 19
        help: "0-9 = Input 1-10, 10 = ST1, 11 = ST2, 12-19 = Sub Input 1-8"

  # ── Output Level Control (short commands) ──
  set_output_level:
    label: Set Output Level
    send: 'SOCL S 0000 00 NC {channel},{level} \r'
    help: >
      Set the output level for a channel. Level is a fader value (0=mute,
      1=-120dB, 411=0dB, 511=+10dB).
    params:
      channel:
        type: integer
        required: true
        label: Output Channel
        min: 0
        max: 9
        help: "0-7 = Output 1-8, 8 = ST1, 9 = ST2"
      level:
        type: integer
        required: true
        label: Level (Fader)
        min: 0
        max: 511
        help: "0=mute, 1=-120dB, 411=0dB, 511=+10dB"

  # ── Output Mute Control ──
  output_mute_on:
    label: Output Mute On
    send: 'SOCM S 0000 00 NC {channel},1 \r'
    help: "Mute an output channel."
    params:
      channel:
        type: integer
        required: true
        label: Output Channel
        min: 0
        max: 9
        help: "0-7 = Output 1-8, 8 = ST1, 9 = ST2"

  output_mute_off:
    label: Output Mute Off
    send: 'SOCM S 0000 00 NC {channel},0 \r'
    help: "Unmute an output channel."
    params:
      channel:
        type: integer
        required: true
        label: Output Channel
        min: 0
        max: 9
        help: "0-7 = Output 1-8, 8 = ST1, 9 = ST2"

  # ── Bus Assign ──
  set_bus_assign:
    label: Set Bus Assign
    send: 'SBUS S 0000 00 NC {channel},{bus},{assign},{level} \r'
    help: "Set the bus assign and level for an input-to-bus routing."
    params:
      channel:
        type: integer
        required: true
        label: Input Channel
        min: 0
        max: 19
        help: "0-9 = Input 1-10, 10 = ST1, 11 = ST2, 12-19 = Sub Input 1-8"
      bus:
        type: integer
        required: true
        label: Bus Channel
        min: 1
        max: 12
        help: "Bus 1-12"
      assign:
        type: integer
        required: true
        label: Bus Assign
        min: 0
        max: 2
        help: "0=Off, 1=SmartMix Pre, 2=SmartMix Post"
      level:
        type: integer
        default: 411
        label: Level (Fader)
        min: 0
        max: 411
        help: "0=mute, 1=-120dB, 411=0dB"

  # ── Operator Fader Control ──
  set_operator_fader:
    label: Set Operator Fader
    send: 'SOPL S 0000 00 NC {page},{fader},{level} \r'
    help: "Set an operator page fader level."
    params:
      page:
        type: integer
        required: true
        label: Operator Page
        min: 1
        max: 8
        help: "Operator page 1-8"
      fader:
        type: integer
        required: true
        label: Fader Number
        min: 1
        max: 8
        help: "Fader 1-8"
      level:
        type: integer
        required: true
        label: Level
        min: 0
        max: 100
        help: "0-100"

  operator_fader_mute_on:
    label: Operator Fader Mute On
    send: 'SOPM S 0000 00 NC {page},{fader},1 \r'
    help: "Mute an operator fader."
    params:
      page:
        type: integer
        required: true
        label: Operator Page
        min: 1
        max: 8
      fader:
        type: integer
        required: true
        label: Fader Number
        min: 1
        max: 8

  operator_fader_mute_off:
    label: Operator Fader Mute Off
    send: 'SOPM S 0000 00 NC {page},{fader},0 \r'
    help: "Unmute an operator fader."
    params:
      page:
        type: integer
        required: true
        label: Operator Page
        min: 1
        max: 8
      fader:
        type: integer
        required: true
        label: Fader Number
        min: 1
        max: 8

  # ── SmartMix Control ──
  set_smart_mix_mode:
    label: Set SmartMix Mode
    send: 'SSMM S 0000 00 NC {group},{mode} \r'
    help: "Set the SmartMix operating mode for a group."
    params:
      group:
        type: integer
        required: true
        label: Group
        min: 1
        max: 4
        help: "SmartMix group 1-4"
      mode:
        type: integer
        required: true
        label: Mode
        min: 0
        max: 2
        help: "0=Off, 1=Gate, 2=Gain Share"

  set_open_mic_count:
    label: Set Open Mic Count
    send: 'NOOM S 0000 00 NC {group},{count} \r'
    help: "Set the maximum number of simultaneously open microphones in a group."
    params:
      group:
        type: integer
        required: true
        label: Group
        min: 1
        max: 4
        help: "SmartMix group 1-4"
      count:
        type: integer
        required: true
        label: Open Mic Count
        min: 1
        max: 10
        help: "Max simultaneously open mics"

  # ── Preset Control ──
  recall_preset:
    label: Recall Preset
    send: 'CALLP S 0000 00 NC {preset} \r'
    help: "Load a saved preset."
    params:
      preset:
        type: integer
        required: true
        label: Preset Bank
        min: 1
        max: 8
        help: "Preset bank 1-8"

  save_preset:
    label: Save Preset
    send: 'REGIP S 0000 00 NC {preset} \r'
    help: "Save current settings to a preset bank."
    params:
      preset:
        type: integer
        required: true
        label: Preset Bank
        min: 1
        max: 8
        help: "Preset bank 1-8"

  recall_partial_preset:
    label: Recall Partial Preset
    send: 'CALLPP S 0000 00 NC {preset} \r'
    help: "Load a partial preset (subset of settings)."
    params:
      preset:
        type: integer
        required: true
        label: Partial Preset
        min: 1
        max: 40
        help: "Partial preset 1-40"

  # ── System Commands ──
  set_meter_interval:
    label: Set Meter Interval
    send: 's_level_meter_interval S 0000 00 NC {interval} \r'
    help: >
      Set how often the mixer sends level-meter notices. This is a global
      setting on the mixer shared by every connected controller.
    params:
      interval:
        type: integer
        required: true
        default: 500
        label: Interval (ms)
        min: 100
        max: 10000
        help: "Meter notification interval in milliseconds (mixer default 100)."

  identify:
    label: Identify (Blink LED)
    send: 'identify S 0000 00 NC \r'
    help: "Blinks the front panel LED to identify the unit."

  reboot:
    label: Reboot
    send: 'reboot S 0000 00 NC \r'
    help: "Reboots the ATDM-1012."

# ── Quick actions ──
actions:
  - id: recall_preset
    icon: bookmark
  - id: input_mute_on
    icon: mic-off
  - id: input_mute_off
    icon: mic
  - id: output_mute_on
    icon: volume-x
  - id: output_mute_off
    icon: volume-2
  - id: identify
    icon: sun

responses:
  # ── Firmware version answer ──
  - match: 'g_firmware_version 0000 \S+ NC (\S+)'
    set: { firmware_version: "$1" }

  # ── Input level answers (short command format) ──
  - match: 'GICL 0000 \S+ NC 0,(\d+)'
    set: { input_1_level: "$1" }
  - match: 'GICL 0000 \S+ NC 1,(\d+)'
    set: { input_2_level: "$1" }
  - match: 'GICL 0000 \S+ NC 2,(\d+)'
    set: { input_3_level: "$1" }
  - match: 'GICL 0000 \S+ NC 3,(\d+)'
    set: { input_4_level: "$1" }
  - match: 'GICL 0000 \S+ NC 4,(\d+)'
    set: { input_5_level: "$1" }
  - match: 'GICL 0000 \S+ NC 5,(\d+)'
    set: { input_6_level: "$1" }
  - match: 'GICL 0000 \S+ NC 6,(\d+)'
    set: { input_7_level: "$1" }
  - match: 'GICL 0000 \S+ NC 7,(\d+)'
    set: { input_8_level: "$1" }
  - match: 'GICL 0000 \S+ NC 8,(\d+)'
    set: { input_9_level: "$1" }
  - match: 'GICL 0000 \S+ NC 9,(\d+)'
    set: { input_10_level: "$1" }

  # ── Input mute answers ──
  - match: 'GICM 0000 \S+ NC 0,1'
    set: { input_1_mute: "true" }
  - match: 'GICM 0000 \S+ NC 0,0'
    set: { input_1_mute: "false" }
  - match: 'GICM 0000 \S+ NC 1,1'
    set: { input_2_mute: "true" }
  - match: 'GICM 0000 \S+ NC 1,0'
    set: { input_2_mute: "false" }
  - match: 'GICM 0000 \S+ NC 2,1'
    set: { input_3_mute: "true" }
  - match: 'GICM 0000 \S+ NC 2,0'
    set: { input_3_mute: "false" }
  - match: 'GICM 0000 \S+ NC 3,1'
    set: { input_4_mute: "true" }
  - match: 'GICM 0000 \S+ NC 3,0'
    set: { input_4_mute: "false" }
  - match: 'GICM 0000 \S+ NC 4,1'
    set: { input_5_mute: "true" }
  - match: 'GICM 0000 \S+ NC 4,0'
    set: { input_5_mute: "false" }
  - match: 'GICM 0000 \S+ NC 5,1'
    set: { input_6_mute: "true" }
  - match: 'GICM 0000 \S+ NC 5,0'
    set: { input_6_mute: "false" }
  - match: 'GICM 0000 \S+ NC 6,1'
    set: { input_7_mute: "true" }
  - match: 'GICM 0000 \S+ NC 6,0'
    set: { input_7_mute: "false" }
  - match: 'GICM 0000 \S+ NC 7,1'
    set: { input_8_mute: "true" }
  - match: 'GICM 0000 \S+ NC 7,0'
    set: { input_8_mute: "false" }
  - match: 'GICM 0000 \S+ NC 8,1'
    set: { input_9_mute: "true" }
  - match: 'GICM 0000 \S+ NC 8,0'
    set: { input_9_mute: "false" }
  - match: 'GICM 0000 \S+ NC 9,1'
    set: { input_10_mute: "true" }
  - match: 'GICM 0000 \S+ NC 9,0'
    set: { input_10_mute: "false" }

  # ── Output level answers ──
  - match: 'GOCL 0000 \S+ NC 0,(\d+)'
    set: { output_1_level: "$1" }
  - match: 'GOCL 0000 \S+ NC 1,(\d+)'
    set: { output_2_level: "$1" }
  - match: 'GOCL 0000 \S+ NC 2,(\d+)'
    set: { output_3_level: "$1" }
  - match: 'GOCL 0000 \S+ NC 3,(\d+)'
    set: { output_4_level: "$1" }
  - match: 'GOCL 0000 \S+ NC 4,(\d+)'
    set: { output_5_level: "$1" }
  - match: 'GOCL 0000 \S+ NC 5,(\d+)'
    set: { output_6_level: "$1" }
  - match: 'GOCL 0000 \S+ NC 6,(\d+)'
    set: { output_7_level: "$1" }
  - match: 'GOCL 0000 \S+ NC 7,(\d+)'
    set: { output_8_level: "$1" }

  # ── Output mute answers ──
  - match: 'GOCM 0000 \S+ NC 0,1'
    set: { output_1_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 0,0'
    set: { output_1_mute: "false" }
  - match: 'GOCM 0000 \S+ NC 1,1'
    set: { output_2_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 1,0'
    set: { output_2_mute: "false" }
  - match: 'GOCM 0000 \S+ NC 2,1'
    set: { output_3_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 2,0'
    set: { output_3_mute: "false" }
  - match: 'GOCM 0000 \S+ NC 3,1'
    set: { output_4_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 3,0'
    set: { output_4_mute: "false" }
  - match: 'GOCM 0000 \S+ NC 4,1'
    set: { output_5_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 4,0'
    set: { output_5_mute: "false" }
  - match: 'GOCM 0000 \S+ NC 5,1'
    set: { output_6_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 5,0'
    set: { output_6_mute: "false" }
  - match: 'GOCM 0000 \S+ NC 6,1'
    set: { output_7_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 6,0'
    set: { output_7_mute: "false" }
  - match: 'GOCM 0000 \S+ NC 7,1'
    set: { output_8_mute: "true" }
  - match: 'GOCM 0000 \S+ NC 7,0'
    set: { output_8_mute: "false" }

  # ── MD push notices (multicast; see push: block). Same first-match
  #    dispatch as the answers above. The device-ID slot is \S+ (the 1012
  #    reports a real Device ID, 00-FF). The grammar lets fields be omitted
  #    (empty between commas), so level/mute captures are OPTIONAL groups —
  #    an omitted field simply skips its mapping instead of storing
  #    garbage. ──

  # Input gain/level/mute changed (Table 5-3: ch, mic_gain, line_gain,
  # level, mute). ST1/ST2 (channels 10/11) are deliberately unmapped — the
  # driver does not model ST-channel state (matches the polling scope).
  - match: 'MD input_gain_level_notice 0000 \S+ NC 0,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_1_level: "$1", input_1_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 1,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_2_level: "$1", input_2_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 2,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_3_level: "$1", input_3_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 3,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_4_level: "$1", input_4_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 4,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_5_level: "$1", input_5_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 5,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_6_level: "$1", input_6_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 6,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_7_level: "$1", input_7_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 7,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_8_level: "$1", input_8_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 8,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_9_level: "$1", input_9_mute: "$2" }
  - match: 'MD input_gain_level_notice 0000 \S+ NC 9,[^,]*,[^,]*,(\d+)?,([01])?'
    set: { input_10_level: "$1", input_10_mute: "$2" }

  # Output level changed (Table 5-4: ch, level). ST1/ST2 (channels 8/9)
  # unmapped — no ST output state vars.
  - match: 'MD output_level_notice 0000 \S+ NC 0,(\d+)'
    set: { output_1_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 1,(\d+)'
    set: { output_2_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 2,(\d+)'
    set: { output_3_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 3,(\d+)'
    set: { output_4_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 4,(\d+)'
    set: { output_5_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 5,(\d+)'
    set: { output_6_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 6,(\d+)'
    set: { output_7_level: "$1" }
  - match: 'MD output_level_notice 0000 \S+ NC 7,(\d+)'
    set: { output_8_level: "$1" }

  # Output mute changed (Table 5-5: ch, mute)
  - match: 'MD output_mute_notice 0000 \S+ NC 0,([01])'
    set: { output_1_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 1,([01])'
    set: { output_2_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 2,([01])'
    set: { output_3_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 3,([01])'
    set: { output_4_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 4,([01])'
    set: { output_5_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 5,([01])'
    set: { output_6_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 6,([01])'
    set: { output_7_mute: "$1" }
  - match: 'MD output_mute_notice 0000 \S+ NC 7,([01])'
    set: { output_8_mute: "$1" }

  # SmartMix gate open/close (Table 5-11: ch 0-9, SmartMix group 1-4,
  # status) — per-channel on this model; the group slot is matched but not
  # captured (gate state is per input, the group is a routing detail)
  - match: 'MD open_channel_notice 0000 \S+ NC 0,[1-4],([01])'
    set: { input_1_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 1,[1-4],([01])'
    set: { input_2_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 2,[1-4],([01])'
    set: { input_3_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 3,[1-4],([01])'
    set: { input_4_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 4,[1-4],([01])'
    set: { input_5_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 5,[1-4],([01])'
    set: { input_6_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 6,[1-4],([01])'
    set: { input_7_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 7,[1-4],([01])'
    set: { input_8_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 8,[1-4],([01])'
    set: { input_9_gate_open: "$1" }
  - match: 'MD open_channel_notice 0000 \S+ NC 9,[1-4],([01])'
    set: { input_10_gate_open: "$1" }

  # Preset recalled (Table 5-9: bank 1-8) — fires for front-panel, Web
  # Remote, and IP
  - match: 'MD recall_preset_notice 0000 \S+ NC ([1-8])'
    set: { last_recalled_preset: "$1" }

  # Level meters: 42 values (Table 5-2) — 22 post-fader (In1-10, ST1, ST2,
  # Out1-8, ST1, ST2, 0-61) then 10 AEC + 10 gain-share (unmapped).
  # Arrives at the meter interval (mixer default 100 ms); throttled to
  # ~2 writes/sec.
  - match: 'MD level_meter_notice 0000 \S+ NC (\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),(\d+),'
    throttle: 0.5
    set:
      input_1_meter: "$1"
      input_2_meter: "$2"
      input_3_meter: "$3"
      input_4_meter: "$4"
      input_5_meter: "$5"
      input_6_meter: "$6"
      input_7_meter: "$7"
      input_8_meter: "$8"
      input_9_meter: "$9"
      input_10_meter: "$10"
      input_st1_meter: "$11"
      input_st2_meter: "$12"
      output_1_meter: "$13"
      output_2_meter: "$14"
      output_3_meter: "$15"
      output_4_meter: "$16"
      output_5_meter: "$17"
      output_6_meter: "$18"
      output_7_meter: "$19"
      output_8_meter: "$20"
      output_st1_meter: "$21"
      output_st2_meter: "$22"

polling:
  queries:
    - 'g_firmware_version O 0000 00 NC \r'
    - 'GICL O 0000 00 NC 0 \r'
    - 'GICL O 0000 00 NC 1 \r'
    - 'GICL O 0000 00 NC 2 \r'
    - 'GICL O 0000 00 NC 3 \r'
    - 'GICL O 0000 00 NC 4 \r'
    - 'GICL O 0000 00 NC 5 \r'
    - 'GICL O 0000 00 NC 6 \r'
    - 'GICL O 0000 00 NC 7 \r'
    - 'GICL O 0000 00 NC 8 \r'
    - 'GICL O 0000 00 NC 9 \r'
    - 'GICM O 0000 00 NC 0 \r'
    - 'GICM O 0000 00 NC 1 \r'
    - 'GICM O 0000 00 NC 2 \r'
    - 'GICM O 0000 00 NC 3 \r'
    - 'GICM O 0000 00 NC 4 \r'
    - 'GICM O 0000 00 NC 5 \r'
    - 'GICM O 0000 00 NC 6 \r'
    - 'GICM O 0000 00 NC 7 \r'
    - 'GICM O 0000 00 NC 8 \r'
    - 'GICM O 0000 00 NC 9 \r'
    - 'GOCL O 0000 00 NC 0 \r'
    - 'GOCL O 0000 00 NC 1 \r'
    - 'GOCL O 0000 00 NC 2 \r'
    - 'GOCL O 0000 00 NC 3 \r'
    - 'GOCL O 0000 00 NC 4 \r'
    - 'GOCL O 0000 00 NC 5 \r'
    - 'GOCL O 0000 00 NC 6 \r'
    - 'GOCL O 0000 00 NC 7 \r'
    - 'GOCM O 0000 00 NC 0 \r'
    - 'GOCM O 0000 00 NC 1 \r'
    - 'GOCM O 0000 00 NC 2 \r'
    - 'GOCM O 0000 00 NC 3 \r'
    - 'GOCM O 0000 00 NC 4 \r'
    - 'GOCM O 0000 00 NC 5 \r'
    - 'GOCM O 0000 00 NC 6 \r'
    - 'GOCM O 0000 00 NC 7 \r'

# ── LIVENESS WATCHDOG ──
# The ATDM protocol is asynchronous and push-capable: between polls a quiet
# room produces no traffic, and fire-and-forget poll queries never notice a
# mixer that dropped without a FIN. Probe the documented firmware-version
# query (the same one polling uses) and require its answer within 5 s; two
# silent probes force a reconnect with a typed no_response fault. The expect
# is unanchored — the poll cycle's own g_firmware_version answer satisfies a
# pending probe too, but MD pushes cannot.
liveness:
  send: 'g_firmware_version O 0000 00 NC \r'
  expect: 'g_firmware_version 0000'
  interval: 30
  timeout: 5
  max_failures: 2

# ── SIMULATOR DEFINITION ──
# Simulates the TCP control surface (polling + commands) plus the MD push
# channel: because the driver declares a multicast push: block, the
# notifications templates below are emitted to the notification group over
# UDP multicast — never on the TCP connection — exactly like the real mixer.
simulator:
  initial_state:
    firmware_version: "1.0.0"
    input_1_level: 411
    input_2_level: 411
    input_3_level: 411
    input_4_level: 411
    input_5_level: 411
    input_6_level: 411
    input_7_level: 411
    input_8_level: 411
    input_9_level: 411
    input_10_level: 411
    input_1_mute: false
    input_2_mute: false
    input_3_mute: false
    input_4_mute: false
    input_5_mute: false
    input_6_mute: false
    input_7_mute: false
    input_8_mute: false
    input_9_mute: false
    input_10_mute: false
    output_1_level: 411
    output_2_level: 411
    output_3_level: 411
    output_4_level: 411
    output_5_level: 411
    output_6_level: 411
    output_7_level: 411
    output_8_level: 411
    output_1_mute: false
    output_2_mute: false
    output_3_mute: false
    output_4_mute: false
    output_5_mute: false
    output_6_mute: false
    output_7_mute: false
    output_8_mute: false
    input_1_gate_open: false
    input_2_gate_open: false
    input_3_gate_open: false
    input_4_gate_open: false
    input_5_gate_open: false
    input_6_gate_open: false
    input_7_gate_open: false
    input_8_gate_open: false
    input_9_gate_open: false
    input_10_gate_open: false
    last_recalled_preset: 1

  delays:
    command_response: 0.03

  # MD notices, emitted to the driver's multicast push group on any state
  # change (Simulator UI toggles included). Templates render the same frame
  # grammar the response rules parse; {value:d} turns booleans into 0/1.
  # Level/mute changes use the omitted-parameter forms the real mixer's
  # grammar allows, so the optional-capture response rules are exercised.
  # Gate-open templates render SmartMix group 1 (any 1-4 matches the rules).
  notifications:
    input_1_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 0,,,{value}, '
    input_2_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 1,,,{value}, '
    input_3_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 2,,,{value}, '
    input_4_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 3,,,{value}, '
    input_5_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 4,,,{value}, '
    input_6_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 5,,,{value}, '
    input_7_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 6,,,{value}, '
    input_8_level:
      '*': 'MD input_gain_level_notice 0000 00 NC 7,,,{value}, '
