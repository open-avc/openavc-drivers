  command_handlers:
    # Firmware version query
    - match: 'g_firmware_version O 0000 00 NC ?'
      handler: |
        respond(f'g_firmware_version 0000 00 NC {state["firmware_version"]} \r')

    # Device ID query (1012-only command — backs the discovery probe)
    - match: 'g_deviceid O 0000 00 NC ?'
      handler: |
        respond('g_deviceid 0000 00 NC 00 \r')

    # Input level query (short command)
    - match: 'GICL O 0000 00 NC (\d+) ?'
      handler: |
        ch = int(match.group(1))
        key = f'input_{ch+1}_level'
        level = state.get(key, 411)
        respond(f'GICL 0000 00 NC {ch},{level} \r')

    # Input level set (short command)
    - match: 'SICL S 0000 00 NC (\d+),(\d+) ?'
      handler: |
        ch = int(match.group(1))
        level = int(match.group(2))
        key = f'input_{ch+1}_level'
        state[key] = level
        respond('SICL ACK \r')

    # Input mute query (short command)
    - match: 'GICM O 0000 00 NC (\d+) ?'
      handler: |
        ch = int(match.group(1))
        key = f'input_{ch+1}_mute'
        val = 1 if state.get(key, False) else 0
        respond(f'GICM 0000 00 NC {ch},{val} \r')

    # Input mute set (short command)
    - match: 'SICM S 0000 00 NC (\d+),(\d+) ?'
      handler: |
        ch = int(match.group(1))
        mute = match.group(2) == '1'
        key = f'input_{ch+1}_mute'
        state[key] = mute
        respond('SICM ACK \r')

    # Output level query (short command)
    - match: 'GOCL O 0000 00 NC (\d+) ?'
      handler: |
        ch = int(match.group(1))
        key = f'output_{ch+1}_level'
        level = state.get(key, 411)
        respond(f'GOCL 0000 00 NC {ch},{level} \r')

    # Output level set (short command)
    - match: 'SOCL S 0000 00 NC (\d+),(\d+) ?'
      handler: |
        ch = int(match.group(1))
        level = int(match.group(2))
        key = f'output_{ch+1}_level'
        state[key] = level
        respond('SOCL ACK \r')

    # Output mute query (short command)
    - match: 'GOCM O 0000 00 NC (\d+) ?'
      handler: |
        ch = int(match.group(1))
        key = f'output_{ch+1}_mute'
        val = 1 if state.get(key, False) else 0
        respond(f'GOCM 0000 00 NC {ch},{val} \r')

    # Output mute set (short command)
    - match: 'SOCM S 0000 00 NC (\d+),(\d+) ?'
      handler: |
        ch = int(match.group(1))
        mute = match.group(2) == '1'
        key = f'output_{ch+1}_mute'
        state[key] = mute
        respond('SOCM ACK \r')

    # Bus assign set
    - match: 'SBUS S 0000 00 NC.*'
      handler: |
        respond('SBUS ACK \r')

    # Operator fader level set
    - match: 'SOPL S 0000 00 NC.*'
      handler: |
        respond('SOPL ACK \r')

    # Operator fader mute set
    - match: 'SOPM S 0000 00 NC.*'
      handler: |
        respond('SOPM ACK \r')

    # SmartMix mode set
    - match: 'SSMM S 0000 00 NC.*'
      handler: |
        respond('SSMM ACK \r')

    # Open mic count set
    - match: 'NOOM S 0000 00 NC.*'
      handler: |
        respond('NOOM ACK \r')

    # Network settings write (the driver's on_connect notification arming)
    - match: 's_network S 0000 00 NC.*'
      handler: |
        respond('s_network ACK \r')

    # Level meter interval write
    - match: 's_level_meter_interval S 0000 00 NC.*'
      handler: |
        respond('s_level_meter_interval ACK \r')

    # Preset recall (recall updates state, which emits the MD notice)
    - match: 'CALLP S 0000 00 NC (\d) ?'
      handler: |
        state['last_recalled_preset'] = int(match.group(1))
        respond('CALLP ACK \r')

    # Preset save
    - match: 'REGIP S 0000 00 NC.*'
      handler: |
        respond('REGIP ACK \r')

    # Partial preset recall
    - match: 'CALLPP S 0000 00 NC.*'
      handler: |
        respond('CALLPP ACK \r')

    # Identify
    - match: 'identify S 0000 00 NC.*'
      handler: |
        respond('identify ACK \r')

    # Reboot
    - match: 'reboot S 0000 00 NC.*'
      handler: |
        respond('reboot ACK \r')

  error_modes:
    communication_timeout:
      description: "Mixer stops responding"
      behavior: no_response
