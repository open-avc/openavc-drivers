    type: boolean
    label: Input 5 Mute
    help: "True when input 5 is muted."
  input_6_mute:
    type: boolean
    label: Input 6 Mute
    help: "True when input 6 is muted."
  input_7_mute:
    type: boolean
    label: Input 7 Mute
    help: "True when input 7 is muted."
  input_8_mute:
    type: boolean
    label: Input 8 Mute
