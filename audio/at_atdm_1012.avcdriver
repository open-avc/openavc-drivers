# Audio-Technica ATDM-1012 Digital SmartMixer Driver
#
# Controls Audio-Technica ATDM-1012 and ATDM-1012DAN automatic mixers
# over TCP (port 17300).
#
# Protocol reference: IP Control Protocol Specification ATDM-1012 V1.0
#
# Command format (Set):  <command> S <modelID> <unitNo> NC <params> \r
# Command format (Get):  <command> O <modelID> <unitNo> NC <params> \r
# Response ACK:          <command> ACK \r
# Response NAK:          <command> NAK <error_code> \r
# Answer:                <command> <modelID> <unitNo> NC <params> \r
#
# All fields are space-delimited (0x20), INCLUDING a trailing space before
# the CR — the spec's own examples end "<params> \r", and this grammar
# family NAKs 04 on parametered commands without it (hardware-verified on
# the ATDM-0604a, which shares the protocol generation). Parameters are
# comma-separated; a parameter may be omitted (left empty between commas)
# to leave that field unchanged on a Set.
#
# The ATDM-1012 supports two command styles:
#   Short (individual):  SICL, GICL, SOCL, GOCL, etc. — used here for
#                        fast level/mute control
#   Verbose (shared):    s_input_gain_level, g_output_level, etc. — same
#                        as ATDM-0604, used for detailed settings
#
# Key concepts:
#   - 10 mic/line inputs (0-9), 2 stereo inputs (10-11), 8 sub-inputs (12-19)
#   - 8 outputs (0-7), 2 stereo outputs (8-9)
#   - 12 mix buses with per-input bus assign
#   - 4 SmartMix groups with Gate or Gain Share modes
#   - 8 operator pages with 8 faders each
#   - 8 presets + 40 partial presets
#   - Fader values: 0 = mute(-inf), 1-511 = -120dB to +10dB (0.25dB steps)
#   - Push notifications: the mixer multicasts MD state-change notices over
#     UDP (factory default 225.0.0.100:17000) — never on the TCP control
#     connection. This driver joins that group (push: block) and arms the
#     "IP Control Setting Notification" flag from on_connect via an
#     s_network omission write. The push surface is spec-derived (no bench
#     hardware for this model): the runtime-only (no-reboot) behavior of
#     the flag write is verified on the ATDM-0604a only and assumed here —
#     if this model applies it only after the reboot its spec calls for,
#     the write is harmless (ACK) and notices simply stay off until enabled
#     in Web Remote. Level meters (level_meter_notice, 42 values at the
#     meter interval) ride the same channel and are opt-in via the Enable
#     Level Meters config field; when off the arming write omits the Audio
#     Level Notification field entirely so another controller's meter feed
#     is never disturbed. Polling stays on as the baseline resync for
#     networks that filter multicast.
#   - Max 5 simultaneous TCP connections
#
# No device_settings on purpose: every writable-and-readable config surface
# (bus assign GBUS, SmartMix GSMM/GNOOM + per-group s_smart_mix_general,
# operator faders GOPL/GOPM) carries a channel/group/page dimension, and a
# flat setting cannot take a dimension. Modeling those axes is child-entity
# territory — the audio-consoles CE pass decides that.

id: at_atdm_1012
name: Audio-Technica ATDM-1012
manufacturer: Audio-Technica
category: audio
version: 1.6.0
author: OpenAVC
min_platform_version: "0.23.0"
description: >
  Controls Audio-Technica ATDM-1012 and ATDM-1012DAN Digital SmartMixers
  via TCP with real-time multicast push updates. Input/output level and
  mute control, bus assign, SmartMix configuration, operator faders,
  preset recall, and optional live level meters.

source_url: https://docs.audio-technica.com/all/IP_Control_Protocol_Specification_-_ATDM-1012_ATDM-1012DAN.pdf
tags: [mixer, smartmixer, conferencing, automixer, dante]
verified: false
simulated: true
ports: [17300]
compatible_models:
  - manufacturer: Audio-Technica
    models: [ATDM-1012, ATDM-1012DAN]
    confidence: untested

transport: tcp
delimiter: "\r"

help:
  overview: >
    Controls Audio-Technica ATDM-1012 / ATDM-1012DAN Digital SmartMixers.
    The ATDM-1012 is a 10-input, 8-output automatic mixer with 12 mix buses,
    designed for conference rooms, courtrooms, and council chambers.
    The DAN variant adds Dante audio networking.
  setup: >
    1. Connect the ATDM-1012 to the network (default control port 17300).
    2. Configure the mixer's IP address via the front panel or Web Remote.
    3. To let OpenAVC find the mixer in a network scan, enable
       "Allow Discovery" (UPnP) in the mixer's network settings.
    4. Input channels: 1-10 (mic/line), ST1, ST2, Sub 1-8.
       Output channels: 1-8, ST1, ST2.
    5. Front-panel and Web Remote changes appear in OpenAVC instantly:
       the mixer multicasts change notices (factory default group
       225.0.0.100, port 17000) and OpenAVC listens automatically. If you
       changed the multicast address or port in Web Remote's network
       settings, set the matching values in this device's Notification
       Group / Notification Port fields. The mixer and the OpenAVC server
       must be on the same VLAN, and switches with IGMP snooping need an
       IGMP querier — if notices are filtered, control still works and
       changes appear at the poll interval instead.
    6. Enable Level Meters (off by default) streams live input/output
       meters into OpenAVC at about two updates per second — bind panel
       meter elements to the meter state values.
    7. The ATDM-1012DAN uses the same protocol with added Dante settings.

discovery:
  # Passive: the Audio-Technica control-unit family advertises one shared
  # UPnP URN when "Allow Discovery" is enabled; the modelName in the
  # description XML names the exact model (URN + XML shape captured from
  # ATDM-0604a hardware; the 1012's modelName strings are inferred from the
  # same UPnP stack and, being exact matches, never fire if wrong).
  #
  # Active probe: input channel 7 exists only on the 10-input 1012 family —
  # both 6-input models answer it NAK 04 (hardware-verified on the 0604a),
  # so a channel-7 answer positively identifies the 1012. The previous probe
  # (g_deviceid answers) misidentified the ATDM-0604a as a 1012: the 0604a
  # shares the new protocol generation and answers g_deviceid too.
  # The ATDM-1012DAN variant adds a Dante card and would advertise Dante's
  # `_netaudio._tcp` mDNS service alongside other Dante-enabled gear, but
  # that's a generic Dante signal not specific to this driver — claiming it
  # would over-match.
  ssdp:
    - device_type: "urn:schemas-upnp-org:device:ATCUDevice:1"
      model: "ATDM-1012"
    - device_type: "urn:schemas-upnp-org:device:ATCUDevice:1"
      model: "ATDM-1012DAN"
  tcp_probe:
    port: 17300
    send_ascii: "g_input_gain_level O 0000 00 NC 7 \r"
    expect_regex: 'g_input_gain_level 0000 \S+ NC 7,'
    extract_manufacturer: "Audio-Technica"
  oui:
    - "00:0a:45"
  port_open:
    - 17300
  manufacturer_alias:
    - "audio-technica"
    - "audio technica"
    - "at"

default_config:
  host: ""
  port: 17300
  poll_interval: 15
  inter_command_delay: 0.05
  notification_group: "225.0.0.100"
  notification_port: 17000
  enable_level_meters: false

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 17300
    label: Port
  poll_interval:
    type: integer
    default: 15
    min: 0
    label: Poll Interval (sec)
  inter_command_delay:
    type: number
    default: 0.05
    label: Inter-Command Delay (sec)
  notification_group:
    type: string
    default: "225.0.0.100"
    label: Notification Group
    help: >
      Multicast address the mixer sends its change notices to (Web Remote
      network settings). Leave at the factory default unless it was changed
      on the mixer.
  notification_port:
    type: integer
    default: 17000
    min: 1
    max: 65535
    label: Notification Port
    help: "UDP port for the mixer's multicast notices (factory default 17000)."
  enable_level_meters:
    type: boolean
    default: false
    label: Enable Level Meters
    help: >
      Stream live input/output level meters into OpenAVC (about two updates
      per second). Uses the mixer's Audio Level Notification; leave off if
      you don't bind meters on a panel.

# Rendered against config at connect: empty while Enable Level Meters is
# off, "1" when on — so the on_connect arming write below OMITS the Audio
# Level Notification field (leaving it as-is for other controllers)
# instead of writing 0.
config_derived:
  meters_flag: "{enable_level_meters:d}"

# Join the mixer's notice group while connected. MD frames feed the
# response rules below; only frames from this device's own address are
# accepted.
push:
  type: multicast
  group: "{notification_group}"
  port: "{notification_port}"

# Arm "IP Control Setting Notification" (field 7) — and, only when meters
# are enabled, "Audio Level Notification" (field 8) — via the s_network
# omission write (Table 4-118: the same 19-field layout as the ATDM-0604a).
# Applying without a reboot is verified on the ATDM-0604a only and assumed
# here; if this model honors the flag only after the reboot its spec calls
# for, the write is harmless (ACK) and notices simply stay off until
# enabled in Web Remote.
on_connect:
  - 's_network S 0000 00 NC ,,,,,,1,{meters_flag},,,,,,,,,,, \r'

