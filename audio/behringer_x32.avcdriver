# Subscribe to feedback on connect, query console info
on_connect:
  - "/xremote"
  - "/info"

# Renew subscription every 9 seconds (X32 expires after ~10s).
# The name queries are the read-back path for the channel/bus name
# device settings: the console never echoes a client's own set back,
# so each poll cycle re-reads the names (48 tiny UDP datagrams).
polling:
  queries:
    - "renew"
    - "/ch/01/config/name"
    - "/ch/02/config/name"
    - "/ch/03/config/name"
    - "/ch/04/config/name"
    - "/ch/05/config/name"
    - "/ch/06/config/name"
    - "/ch/07/config/name"
    - "/ch/08/config/name"
    - "/ch/09/config/name"
    - "/ch/10/config/name"
    - "/ch/11/config/name"
    - "/ch/12/config/name"
    - "/ch/13/config/name"
    - "/ch/14/config/name"
    - "/ch/15/config/name"
    - "/ch/16/config/name"
    - "/ch/17/config/name"
    - "/ch/18/config/name"
    - "/ch/19/config/name"
    - "/ch/20/config/name"
    - "/ch/21/config/name"
    - "/ch/22/config/name"
    - "/ch/23/config/name"
    - "/ch/24/config/name"
    - "/ch/25/config/name"
    - "/ch/26/config/name"
    - "/ch/27/config/name"
    - "/ch/28/config/name"
    - "/ch/29/config/name"
    - "/ch/30/config/name"
    - "/ch/31/config/name"
    - "/ch/32/config/name"
    - "/bus/01/config/name"
    - "/bus/02/config/name"
    - "/bus/03/config/name"
    - "/bus/04/config/name"
    - "/bus/05/config/name"
    - "/bus/06/config/name"
    - "/bus/07/config/name"
    - "/bus/08/config/name"
    - "/bus/09/config/name"
    - "/bus/10/config/name"
    - "/bus/11/config/name"
    - "/bus/12/config/name"
    - "/bus/13/config/name"
    - "/bus/14/config/name"
    - "/bus/15/config/name"
    - "/bus/16/config/name"

# ── QUICK ACTIONS ──
actions:
  - id: recall_scene
    icon: bookmark
  - id: clear_solo
    icon: headphones
  - id: mute_main_st
    icon: volume-x
  - id: unmute_main_st
    icon: volume-2

# ── LIVENESS WATCHDOG ──
# /info is a documented request/response (the console answers with an
# /info message carrying server version/name/model/firmware), unlike
# /xremote which registers silently. UDP never surfaces a dead peer on
# its own, so probe every 15 s; two silent probes force a reconnect
# with a typed no_response fault. The expect is anchored to the reply
# address (an OSC packet leads with its ASCII address).
liveness:
  send: "/info"
  expect: '^/info'
  interval: 15
  timeout: 5
  max_failures: 2

responses:
  # Console info (4 string args: server version, server name, model, firmware)
  - address: "/info"
    mappings:
      - arg: 2
        state: console_model
        type: string
      - arg: 3
        state: firmware_version
        type: string

  # Scene/show
  - address: "/-show/prepos/current"
    mappings:
      - arg: 0
        state: current_scene
        type: integer
  - address: "/-show/showfile/show/name"
    mappings:
      - arg: 0
        state: show_name
        type: string

  # ── Channel 01-32 faders ──
  - address: "/ch/01/mix/fader"
    mappings:
      - arg: 0
        state: ch01_fader
        type: float
  - address: "/ch/02/mix/fader"
    mappings:
      - arg: 0
        state: ch02_fader
        type: float
  - address: "/ch/03/mix/fader"
    mappings:
      - arg: 0
        state: ch03_fader
        type: float
  - address: "/ch/04/mix/fader"
