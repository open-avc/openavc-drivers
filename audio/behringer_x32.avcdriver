    dca7_mute: true
    dca8_fader: 0.0
    dca8_mute: true
    # Aux inputs 1-8: all muted at -inf
    auxin01_fader: 0.0
    auxin01_mute: true
    auxin02_fader: 0.0
    auxin02_mute: true
    auxin03_fader: 0.0
    auxin03_mute: true
    auxin04_fader: 0.0
    auxin04_mute: true
    auxin05_fader: 0.0
