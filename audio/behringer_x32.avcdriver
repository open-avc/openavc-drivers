    # FX returns 1-8: all muted at -inf
    fxrtn01_fader: 0.0
    fxrtn01_mute: true
    fxrtn02_fader: 0.0
    fxrtn02_mute: true
    fxrtn03_fader: 0.0
    fxrtn03_mute: true
    fxrtn04_fader: 0.0
    fxrtn04_mute: true
    fxrtn05_fader: 0.0
    fxrtn05_mute: true
