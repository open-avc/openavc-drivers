      label: Ch 3 Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: ch03_mute
      label: Ch 3 Mute
    - type: slider
      key: ch04_fader
      label: Ch 4 Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: ch04_mute
      label: Ch 4 Mute
    - type: slider
      key: ch05_fader
      label: Ch 5 Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: ch05_mute
      label: Ch 5 Mute
    - type: slider
      key: ch06_fader
      label: Ch 6 Fader
      min: 0
