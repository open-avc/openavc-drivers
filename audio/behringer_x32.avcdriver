# ── SIMULATOR ──
# The auto-generator handles most behavior from the responses section:
# - Messages with args → update state, echo back
# - Messages without args → respond with current state (query)
# The simulator section adds controls for the Simulator UI and
# initial state values matching a realistic X32 default scene.

simulator:
  push_state: true
  initial_state:
    console_model: X32
    firmware_version: "4.06"
    current_scene: 0
    show_name: "Default Show"
    # Channels 1-8: unmuted at unity
    ch01_fader: 0.75
    ch01_mute: false
    ch01_name: "Ch 1"
    ch02_fader: 0.75
    ch02_mute: false
    ch02_name: "Ch 2"
    ch03_fader: 0.75
    ch03_mute: false
    ch03_name: "Ch 3"
    ch04_fader: 0.75
    ch04_mute: false
    ch04_name: "Ch 4"
    ch05_fader: 0.75
    ch05_mute: false
    ch05_name: "Ch 5"
    ch06_fader: 0.75
    ch06_mute: false
    ch06_name: "Ch 6"
    ch07_fader: 0.75
    ch07_mute: false
    ch07_name: "Ch 7"
    ch08_fader: 0.75
    ch08_mute: false
    ch08_name: "Ch 8"
    # Channels 9-32: muted at -inf
    ch09_fader: 0.0
    ch09_mute: true
    ch09_name: "Ch 9"
    ch10_fader: 0.0
    ch10_mute: true
    ch10_name: "Ch 10"
    ch11_fader: 0.0
    ch11_mute: true
    ch11_name: "Ch 11"
    ch12_fader: 0.0
    ch12_mute: true
