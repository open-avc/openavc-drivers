      key: ch08_mute
      label: Ch 8 Mute
    # Bus 1-4 faders and mutes
    - type: slider
      key: bus01_fader
      label: Bus 1 Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: bus01_mute
      label: Bus 1 Mute
    - type: slider
      key: bus02_fader
      label: Bus 2 Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: bus02_mute
      label: Bus 2 Mute
    - type: slider
      key: bus03_fader
      label: Bus 3 Fader
      min: 0
      max: 1
