# Behringer X32 Digital Mixer — OSC Driver
#
# Controls Behringer X32 and X32 Compact digital mixing consoles via OSC
# over UDP. Also compatible with Midas M32 (same protocol).
#
# Protocol reference: Patrick-Gilles Maillot's Unofficial X32/M32 OSC
# Remote Protocol (github.com/pmaillot/X32-Behringer)
#
# The X32 does NOT send unsolicited updates. You must send /xremote
# every <=10 seconds to receive feedback. This driver handles that
# automatically via polling.
#
# Strips are child entities: 32 input channels, 8 aux ins, 8 FX returns,
# 16 mix buses, 6 matrices, 8 DCAs, and the stereo/mono mains, each with
# fader, mute, and name. Wildcard OSC response rules route by address
# segment (/ch/07/mix/fader -> channel 7), so one rule covers a whole
# strip family. Children are labelled by the console's own scribble-strip
# names (label_field: name).
#
# Liveness: /xremote gets no direct reply and UDP sends always "succeed",
# so a console that dropped off the network stayed online forever. The
# liveness: block probes /info (a documented request/response) every 15 s
# and flips the device offline with a typed no_response fault after two
# silent probes.
#
# Read-back note: the console echoes parameter changes only to OTHER
# subscribed clients, never back to the sender. The per-child poll
# queries (fader/mute/name every cycle) are the read-back path for this
# driver's own writes, including renames.
#
# Querying values: send any address with no arguments to get the
# current value back.

id: behringer_x32
name: Behringer X32 Digital Mixer
manufacturer: Behringer
category: audio
version: 2.0.0
author: OpenAVC
description: >-
  Controls Behringer X32 and X32 Compact digital mixing consoles via OSC.
  32 input channels, 8 aux ins, 8 FX returns, 16 mix buses, 6 matrices,
  8 DCAs, and stereo/mono mains as child entities with fader, mute, and
  console-side names, plus scene recall and a liveness watchdog. Also
  compatible with Midas M32.

source_url: https://sites.google.com/site/patrickmaillot/x32
tags: [mixer, console, osc, midas]
verified: false
simulated: true
ports: [10023]
# 0.23.0 ships the OSC child-routing runtime (child_set on address rules,
# segment ids, {child_id:02d} poll templates, literal id rosters).
min_platform_version: "0.23.0"
compatible_models:
  - manufacturer: Behringer
    models: [X32, X32 Compact, X32 Producer, X32 Rack, X32 Core]
    confidence: untested
  - manufacturer: Midas
    models: [M32, M32 LIVE, M32R, M32C]
    confidence: untested
    notes: Identical OSC protocol to X32.

transport: osc

help:
  overview: >-
    Controls a Behringer X32 or X32 Compact digital mixer over the network
    using the OSC (Open Sound Control) protocol. Every strip is a child
    entity — all 32 input channels, 8 aux ins, 8 FX returns, 16 mix buses,
    6 matrices, 8 DCAs, and the stereo/mono mains — with fader, mute, and
    the console's own scribble-strip name as the child label.
  setup: >-
    1. Connect the X32 to the same network as the OpenAVC server.
    2. On the X32, go to Setup > Network and note the IP address.
    3. Enter the IP address in the device config. The default port is 10023.
    4. The driver will automatically subscribe to feedback and start
       receiving fader/mute updates. Strip names load on connect and
       become the child labels.

discovery:
  # X32 / M32 speak OSC and do NOT advertise on the network — the OSC
  # spec is push-from-controller only. Hint-only by design (Behringer's
  # protocol manual has no announce message, and X32 doesn't dial out
  # either). Match by Behringer Spezielle Studiotechnik OUI + OSC port
  # + manufacturer alias.
  oui:
    - "00:15:64"
  port_open:
    - 10023
  manufacturer_alias:
    - "behringer"
    - "music tribe"
    - "midas"

default_config:
  host: ""
  port: 10023
  poll_interval: 9

config_schema:
  host:
    type: string
    required: true
    label: IP Address
    description: X32 network IP address (Setup > Network on the console)
  port:
    type: integer
    default: 10023
    label: OSC Port
    description: Default is 10023 for X32/M32, 10024 for X-Air series

state_variables:
  # Console info
  console_model:
    type: string
    label: Console Model
    help: "Console model string reported by /info."
  firmware_version:
    type: string
    label: Firmware Version
    help: "Console firmware version reported by /info."

  # Scene/show
  current_scene:
    type: integer
    label: Current Scene
    help: "Index of the currently-loaded scene."
  show_name:
    type: string
    label: Show Name
    help: "Display name of the currently-loaded show."

# ── CHILD ENTITIES ──
# One type per strip class (the console's own families). Every type
# carries fader/mute/name; children are labelled by the console's
# scribble-strip names (label_field: name), which load on connect.
child_entity_types:
  channel:
    label: Channel
    label_plural: Channels
    id_format: { type: integer, min: 1, max: 32, pad_width: 2 }
    label_field: name
    state_variables:
      fader:
        type: number
        label: Fader
        min: 0
        max: 1
        step: 0.01
        control: true
        help: "Fader level (0.0 = -inf dB, 0.75 = 0 dB, 1.0 = +10 dB)."
      mute:
        type: boolean
        label: Mute
        control: true
        cloud_priority: high
        help: "True when the channel is muted."
      name:
        type: string
        label: Name
        cloud_priority: low
        help: "Console scribble-strip name (12 characters max)."
    instances:
      count: 32
      label: "Ch {id}"
  aux_in:
    label: Aux In
    label_plural: Aux Ins
    id_format: { type: integer, min: 1, max: 8, pad_width: 2 }
    label_field: name
    state_variables:
      fader:
        type: number
        label: Fader
        min: 0
        max: 1
        step: 0.01
        control: true
        help: "Fader level (0.0 = -inf dB, 0.75 = 0 dB, 1.0 = +10 dB)."
      mute:
        type: boolean
        label: Mute
        control: true
        cloud_priority: high
        help: "True when the aux input is muted."
      name:
        type: string
        label: Name
        cloud_priority: low
        help: "Console scribble-strip name (12 characters max)."
    instances:
      count: 8
      label: "Aux {id}"
  fx_return:
    label: FX Return
    label_plural: FX Returns
    id_format: { type: integer, min: 1, max: 8, pad_width: 2 }
    label_field: name
    state_variables:
      fader:
        type: number
        label: Fader
        min: 0
        max: 1
        step: 0.01
        control: true
        help: "Fader level (0.0 = -inf dB, 0.75 = 0 dB, 1.0 = +10 dB)."
      mute:
        type: boolean
        label: Mute
        control: true
        cloud_priority: high
        help: "True when the FX return is muted."
      name:
        type: string
        label: Name
        cloud_priority: low
        help: "Console scribble-strip name (12 characters max)."
    instances:
      count: 8
      label: "FX Rtn {id}"
  bus:
    label: Bus
    label_plural: Buses
    id_format: { type: integer, min: 1, max: 16, pad_width: 2 }
    label_field: name
    state_variables:
      fader:
        type: number
        label: Fader
        min: 0
        max: 1
        step: 0.01
        control: true
        help: "Fader level (0.0 = -inf dB, 0.75 = 0 dB, 1.0 = +10 dB)."
      mute:
        type: boolean
        label: Mute
        control: true
        cloud_priority: high
        help: "True when the bus is muted."
      name:
        type: string
        label: Name
        cloud_priority: low
        help: "Console scribble-strip name (12 characters max)."
    instances:
      count: 16
      label: "Bus {id}"
  matrix:
    label: Matrix
    label_plural: Matrices
    id_format: { type: integer, min: 1, max: 6, pad_width: 2 }
    label_field: name
    state_variables:
      fader:
        type: number
        label: Fader
        min: 0
        max: 1
        step: 0.01
        control: true
        help: "Fader level (0.0 = -inf dB, 0.75 = 0 dB, 1.0 = +10 dB)."
      mute:
        type: boolean
        label: Mute
        control: true
        cloud_priority: high
        help: "True when the matrix is muted."
      name:
        type: string
        label: Name
        cloud_priority: low
        help: "Console scribble-strip name (12 characters max)."
    instances:
      count: 6
      label: "Matrix {id}"
  dca:
    label: DCA
    label_plural: DCAs
    id_format: { type: integer, min: 1, max: 8 }
    label_field: name
    state_variables:
      fader:
        type: number
        label: Fader
        min: 0
        max: 1
        step: 0.01
        control: true
        help: "DCA fader level (0.0 = -inf dB, 0.75 = 0 dB, 1.0 = +10 dB)."
      mute:
        type: boolean
        label: Mute
        control: true
        cloud_priority: high
        help: "True when the DCA is muted."
      name:
        type: string
        label: Name
        cloud_priority: low
        help: "Console scribble-strip name (12 characters max)."
    instances:
      count: 8
      label: "DCA {id}"
  main:
    label: Main
    label_plural: Mains
    id_format: { type: string }
    label_field: name
    state_variables:
      fader:
        type: number
        label: Fader
        min: 0
        max: 1
        step: 0.01
        control: true
        help: "Main fader level (0.0 = -inf dB, 0.75 = 0 dB, 1.0 = +10 dB)."
      mute:
        type: boolean
        label: Mute
        control: true
        cloud_priority: high
        help: "True when the main output is muted."
      name:
        type: string
        label: Name
        cloud_priority: low
        help: "Console scribble-strip name (12 characters max)."
    instances:
      ids: [st, m]
      label: "Main {id}"

commands:
  renew:
    label: Renew Subscription
    address: "/xremote"
    help: "Re-arm the console's feedback subscription (expires after ~10 s; the poll cycle sends this automatically)."

  query_info:
    label: Query Console Info
    address: "/info"
    help: "Ask the console for its model and firmware version."

  # ── Scene / snippet / cue recall (0-99 per the protocol doc) ──
  recall_scene:
    label: Recall Scene
    address: "/-action/goscene"
    args:
      - type: i
        value: "{scene}"
    params:
      scene:
        type: integer
        label: Scene (0-99)
        min: 0
        max: 99
    help: "Load a scene from the console's scene list."

  recall_snippet:
    label: Recall Snippet
    address: "/-action/gosnippet"
    args:
      - type: i
        value: "{snippet}"
    params:
      snippet:
        type: integer
        label: Snippet (0-99)
        min: 0
        max: 99
    help: "Load a snippet from the console's snippet list."

  recall_cue:
    label: Recall Cue
    address: "/-action/gocue"
    args:
      - type: i
        value: "{cue}"
    params:
      cue:
        type: integer
        label: Cue (0-99)
        min: 0
        max: 99
    help: "Fire a cue from the console's cue list."

  clear_solo:
    label: Clear All Solos
    address: "/-action/clearsolo"
    args:
      - type: i
        value: "1"
    help: "Release every active solo on the console."

  # ── Input channels 1-32 ──
  set_ch_fader:
    label: Set Channel Fader
    address: "/ch/{channel:02d}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      channel:
        type: child_id
        child_type: channel
        label: Channel
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_ch:
    label: Mute Channel
    address: "/ch/{channel:02d}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      channel:
        type: child_id
        child_type: channel
        label: Channel

  unmute_ch:
    label: Unmute Channel
    address: "/ch/{channel:02d}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      channel:
        type: child_id
        child_type: channel
        label: Channel

  rename_ch:
    label: Rename Channel
    address: "/ch/{channel:02d}/config/name"
    args:
      - type: s
        value: "{name}"
    params:
      channel:
        type: child_id
        child_type: channel
        label: Channel
      name:
        type: string
        label: Name
        description: "12 characters max on-console"

  # ── Aux ins 1-8 ──
  set_auxin_fader:
    label: Set Aux In Fader
    address: "/auxin/{auxin:02d}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      auxin:
        type: child_id
        child_type: aux_in
        label: Aux In
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_auxin:
    label: Mute Aux In
    address: "/auxin/{auxin:02d}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      auxin:
        type: child_id
        child_type: aux_in
        label: Aux In

  unmute_auxin:
    label: Unmute Aux In
    address: "/auxin/{auxin:02d}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      auxin:
        type: child_id
        child_type: aux_in
        label: Aux In

  rename_auxin:
    label: Rename Aux In
    address: "/auxin/{auxin:02d}/config/name"
    args:
      - type: s
        value: "{name}"
    params:
      auxin:
        type: child_id
        child_type: aux_in
        label: Aux In
      name:
        type: string
        label: Name
        description: "12 characters max on-console"

  # ── FX returns 1-8 ──
  set_fxrtn_fader:
    label: Set FX Return Fader
    address: "/fxrtn/{fxrtn:02d}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      fxrtn:
        type: child_id
        child_type: fx_return
        label: FX Return
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_fxrtn:
    label: Mute FX Return
    address: "/fxrtn/{fxrtn:02d}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      fxrtn:
        type: child_id
        child_type: fx_return
        label: FX Return

  unmute_fxrtn:
    label: Unmute FX Return
    address: "/fxrtn/{fxrtn:02d}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      fxrtn:
        type: child_id
        child_type: fx_return
        label: FX Return

  rename_fxrtn:
    label: Rename FX Return
    address: "/fxrtn/{fxrtn:02d}/config/name"
    args:
      - type: s
        value: "{name}"
    params:
      fxrtn:
        type: child_id
        child_type: fx_return
        label: FX Return
      name:
        type: string
        label: Name
        description: "12 characters max on-console"

  # ── Mix buses 1-16 ──
  set_bus_fader:
    label: Set Bus Fader
    address: "/bus/{bus:02d}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      bus:
        type: child_id
        child_type: bus
        label: Bus
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_bus:
    label: Mute Bus
    address: "/bus/{bus:02d}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      bus:
        type: child_id
        child_type: bus
        label: Bus

  unmute_bus:
    label: Unmute Bus
    address: "/bus/{bus:02d}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      bus:
        type: child_id
        child_type: bus
        label: Bus

  rename_bus:
    label: Rename Bus
    address: "/bus/{bus:02d}/config/name"
    args:
      - type: s
        value: "{name}"
    params:
      bus:
        type: child_id
        child_type: bus
        label: Bus
      name:
        type: string
        label: Name
        description: "12 characters max on-console"

  # ── Matrices 1-6 ──
  set_mtx_fader:
    label: Set Matrix Fader
    address: "/mtx/{mtx:02d}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      mtx:
        type: child_id
        child_type: matrix
        label: Matrix
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_mtx:
    label: Mute Matrix
    address: "/mtx/{mtx:02d}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      mtx:
        type: child_id
        child_type: matrix
        label: Matrix

  unmute_mtx:
    label: Unmute Matrix
    address: "/mtx/{mtx:02d}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      mtx:
        type: child_id
        child_type: matrix
        label: Matrix

  rename_mtx:
    label: Rename Matrix
    address: "/mtx/{mtx:02d}/config/name"
    args:
      - type: s
        value: "{name}"
    params:
      mtx:
        type: child_id
        child_type: matrix
        label: Matrix
      name:
        type: string
        label: Name
        description: "12 characters max on-console"

  # ── DCAs 1-8 (addresses are unpadded per the protocol tree) ──
  set_dca_fader:
    label: Set DCA Fader
    address: "/dca/{dca}/fader"
    args:
      - type: f
        value: "{level}"
    params:
      dca:
        type: child_id
        child_type: dca
        label: DCA
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_dca:
    label: Mute DCA
    address: "/dca/{dca}/on"
    args:
      - type: i
        value: "0"
    params:
      dca:
        type: child_id
        child_type: dca
        label: DCA

  unmute_dca:
    label: Unmute DCA
    address: "/dca/{dca}/on"
    args:
      - type: i
        value: "1"
    params:
      dca:
        type: child_id
        child_type: dca
        label: DCA

  rename_dca:
    label: Rename DCA
    address: "/dca/{dca}/config/name"
    args:
      - type: s
        value: "{name}"
    params:
      dca:
        type: child_id
        child_type: dca
        label: DCA
      name:
        type: string
        label: Name
        description: "12 characters max on-console"

  # ── Mains (st = stereo, m = mono) ──
  set_main_fader:
    label: Set Main Fader
    address: "/main/{main}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      main:
        type: child_id
        child_type: main
        label: Main
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_main:
    label: Mute Main
    address: "/main/{main}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      main:
        type: child_id
        child_type: main
        label: Main

  unmute_main:
    label: Unmute Main
    address: "/main/{main}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      main:
        type: child_id
        child_type: main
        label: Main

  rename_main:
    label: Rename Main
    address: "/main/{main}/config/name"
    args:
      - type: s
        value: "{name}"
    params:
      main:
        type: child_id
        child_type: main
        label: Main
      name:
        type: string
        label: Name
        description: "12 characters max on-console"

  # No-param main-stereo mute pair kept for the quick-action strip
  # (actions fire commands directly; these avoid a param prompt).
  mute_main_st:
    label: Mute Main Stereo
    address: "/main/st/mix/on"
    args:
      - type: i
        value: "0"

  unmute_main_st:
    label: Unmute Main Stereo
    address: "/main/st/mix/on"
    args:
      - type: i
        value: "1"

on_connect:
  - "/xremote"
  - "/info"
  # Populate every strip immediately (name first so child labels appear,
  # then fader/mute). The poll cycle repeats these as the read-back path.
  - { each_child: channel, send: "/ch/{child_id:02d}/config/name" }
  - { each_child: channel, send: "/ch/{child_id:02d}/mix/fader" }
  - { each_child: channel, send: "/ch/{child_id:02d}/mix/on" }
  - { each_child: aux_in, send: "/auxin/{child_id:02d}/config/name" }
  - { each_child: aux_in, send: "/auxin/{child_id:02d}/mix/fader" }
  - { each_child: aux_in, send: "/auxin/{child_id:02d}/mix/on" }
  - { each_child: fx_return, send: "/fxrtn/{child_id:02d}/config/name" }
  - { each_child: fx_return, send: "/fxrtn/{child_id:02d}/mix/fader" }
  - { each_child: fx_return, send: "/fxrtn/{child_id:02d}/mix/on" }
  - { each_child: bus, send: "/bus/{child_id:02d}/config/name" }
  - { each_child: bus, send: "/bus/{child_id:02d}/mix/fader" }
  - { each_child: bus, send: "/bus/{child_id:02d}/mix/on" }
  - { each_child: matrix, send: "/mtx/{child_id:02d}/config/name" }
  - { each_child: matrix, send: "/mtx/{child_id:02d}/mix/fader" }
  - { each_child: matrix, send: "/mtx/{child_id:02d}/mix/on" }
  - { each_child: dca, send: "/dca/{child_id}/config/name" }
  - { each_child: dca, send: "/dca/{child_id}/fader" }
  - { each_child: dca, send: "/dca/{child_id}/on" }
  - { each_child: main, send: "/main/{child_id}/config/name" }
  - { each_child: main, send: "/main/{child_id}/mix/fader" }
  - { each_child: main, send: "/main/{child_id}/mix/on" }

# Renew subscription every 9 seconds (X32 expires after ~10s) and re-read
# every strip's fader/mute/name. The console never echoes a client's own
# set back, so this poll cycle is the read-back path for this driver's
# writes (~240 tiny UDP datagrams per cycle — far lighter than the
# console's own remote apps).
polling:
  queries:
    - "renew"
    - { each_child: channel, send: "/ch/{child_id:02d}/config/name" }
    - { each_child: channel, send: "/ch/{child_id:02d}/mix/fader" }
    - { each_child: channel, send: "/ch/{child_id:02d}/mix/on" }
    - { each_child: aux_in, send: "/auxin/{child_id:02d}/config/name" }
    - { each_child: aux_in, send: "/auxin/{child_id:02d}/mix/fader" }
    - { each_child: aux_in, send: "/auxin/{child_id:02d}/mix/on" }
    - { each_child: fx_return, send: "/fxrtn/{child_id:02d}/config/name" }
    - { each_child: fx_return, send: "/fxrtn/{child_id:02d}/mix/fader" }
    - { each_child: fx_return, send: "/fxrtn/{child_id:02d}/mix/on" }
    - { each_child: bus, send: "/bus/{child_id:02d}/config/name" }
    - { each_child: bus, send: "/bus/{child_id:02d}/mix/fader" }
    - { each_child: bus, send: "/bus/{child_id:02d}/mix/on" }
    - { each_child: matrix, send: "/mtx/{child_id:02d}/config/name" }
    - { each_child: matrix, send: "/mtx/{child_id:02d}/mix/fader" }
    - { each_child: matrix, send: "/mtx/{child_id:02d}/mix/on" }
    - { each_child: dca, send: "/dca/{child_id}/config/name" }
    - { each_child: dca, send: "/dca/{child_id}/fader" }
    - { each_child: dca, send: "/dca/{child_id}/on" }
    - { each_child: main, send: "/main/{child_id}/config/name" }
    - { each_child: main, send: "/main/{child_id}/mix/fader" }
    - { each_child: main, send: "/main/{child_id}/mix/on" }

# ── QUICK ACTIONS ──
actions:
  - id: recall_scene
    icon: bookmark
  - id: clear_solo
    icon: headphones
  - id: mute_main_st
    icon: volume-x
  - id: unmute_main_st
    icon: volume-2

# ── LIVENESS WATCHDOG ──
# /info is a documented request/response (the console answers with an
# /info message carrying server version/name/model/firmware), unlike
# /xremote which registers silently. UDP never surfaces a dead peer on
# its own, so probe every 15 s; two silent probes force a reconnect
# with a typed no_response fault. The expect is anchored to the reply
# address (an OSC packet leads with its ASCII address).
liveness:
  send: "/info"
  expect: '^/info'
  interval: 15
  timeout: 5
  max_failures: 2

# One wildcard rule per strip family routes into child state by address
# segment: in /ch/07/mix/fader, segment 1 (0-based over the /-split
# address) is "07" — the channel's local id. The console reports mute as
# on (1 = unmuted, 0 = muted), hence the inverting value map.
responses:
  # Console info (4 string args: server version, server name, model, firmware)
  - address: "/info"
    mappings:
      - arg: 2
        state: console_model
        type: string
      - arg: 3
        state: firmware_version
        type: string

  # Scene/show
  - address: "/-show/prepos/current"
    mappings:
      - arg: 0
        state: current_scene
        type: integer
  - address: "/-show/showfile/show/name"
    mappings:
      - arg: 0
        state: show_name
        type: string

  # ── Input channels 1-32 ──
  - address: "/ch/*/mix/fader"
    child_set:
      - { type: channel, id: { segment: 1 }, state: { fader: { arg: 0 } } }
  - address: "/ch/*/mix/on"
    child_set:
      - type: channel
        id: { segment: 1 }
        state:
          mute: { arg: 0, map: { "0": "true", "1": "false" } }
  - address: "/ch/*/config/name"
    child_set:
      - { type: channel, id: { segment: 1 }, state: { name: { arg: 0 } } }

  # ── Aux ins 1-8 ──
  - address: "/auxin/*/mix/fader"
    child_set:
      - { type: aux_in, id: { segment: 1 }, state: { fader: { arg: 0 } } }
  - address: "/auxin/*/mix/on"
    child_set:
      - type: aux_in
        id: { segment: 1 }
        state:
          mute: { arg: 0, map: { "0": "true", "1": "false" } }
  - address: "/auxin/*/config/name"
    child_set:
      - { type: aux_in, id: { segment: 1 }, state: { name: { arg: 0 } } }

  # ── FX returns 1-8 ──
  - address: "/fxrtn/*/mix/fader"
    child_set:
      - { type: fx_return, id: { segment: 1 }, state: { fader: { arg: 0 } } }
  - address: "/fxrtn/*/mix/on"
    child_set:
      - type: fx_return
        id: { segment: 1 }
        state:
          mute: { arg: 0, map: { "0": "true", "1": "false" } }
  - address: "/fxrtn/*/config/name"
    child_set:
      - { type: fx_return, id: { segment: 1 }, state: { name: { arg: 0 } } }

  # ── Mix buses 1-16 ──
  - address: "/bus/*/mix/fader"
    child_set:
      - { type: bus, id: { segment: 1 }, state: { fader: { arg: 0 } } }
  - address: "/bus/*/mix/on"
    child_set:
      - type: bus
        id: { segment: 1 }
        state:
          mute: { arg: 0, map: { "0": "true", "1": "false" } }
  - address: "/bus/*/config/name"
    child_set:
      - { type: bus, id: { segment: 1 }, state: { name: { arg: 0 } } }

  # ── Matrices 1-6 ──
  - address: "/mtx/*/mix/fader"
    child_set:
      - { type: matrix, id: { segment: 1 }, state: { fader: { arg: 0 } } }
  - address: "/mtx/*/mix/on"
    child_set:
      - type: matrix
        id: { segment: 1 }
        state:
          mute: { arg: 0, map: { "0": "true", "1": "false" } }
  - address: "/mtx/*/config/name"
    child_set:
      - { type: matrix, id: { segment: 1 }, state: { name: { arg: 0 } } }

  # ── DCAs 1-8 (no mix/ level in the address tree) ──
  - address: "/dca/*/fader"
    child_set:
      - { type: dca, id: { segment: 1 }, state: { fader: { arg: 0 } } }
  - address: "/dca/*/on"
    child_set:
      - type: dca
        id: { segment: 1 }
        state:
          mute: { arg: 0, map: { "0": "true", "1": "false" } }
  - address: "/dca/*/config/name"
    child_set:
      - { type: dca, id: { segment: 1 }, state: { name: { arg: 0 } } }

  # ── Mains (segment 1 is the string id: st / m) ──
  - address: "/main/*/mix/fader"
    child_set:
      - { type: main, id: { segment: 1 }, state: { fader: { arg: 0 } } }
  - address: "/main/*/mix/on"
    child_set:
      - type: main
        id: { segment: 1 }
        state:
          mute: { arg: 0, map: { "0": "true", "1": "false" } }
  - address: "/main/*/config/name"
    child_set:
      - { type: main, id: { segment: 1 }, state: { name: { arg: 0 } } }

