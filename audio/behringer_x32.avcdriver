# Behringer X32 Digital Mixer — OSC Driver
#
# Controls Behringer X32 and X32 Compact digital mixing consoles via OSC
# over UDP. Also compatible with Midas M32 (same protocol).
#
# Protocol reference: Patrick-Gilles Maillot's Unofficial X32/M32 OSC
# Remote Protocol (github.com/pmaillot/X32-Behringer)
#
# The X32 does NOT send unsolicited updates. You must send /xremote
# every <=10 seconds to receive feedback. This driver handles that
# automatically via polling.
#
# Querying values: send any address with no arguments to get the
# current value back.
#
# Full console coverage: 32 input channels, 16 mix buses, 6 matrices,
# 8 DCAs, 8 aux inputs, 8 FX returns, main stereo, main mono.

id: behringer_x32
name: Behringer X32 Digital Mixer
manufacturer: Behringer
category: audio
version: 1.5.1
author: OpenAVC
description: >-
  Controls Behringer X32 and X32 Compact digital mixing consoles via OSC.
  32 input channels, 16 mix buses, 6 matrices, 8 DCAs, 8 aux inputs,
  8 FX returns, main stereo and mono outputs. Also compatible with Midas M32.

source_url: https://sites.google.com/site/patrickmaillot/x32
tags: [mixer, console, osc, midas]
verified: false
simulated: true
ports: [10023]
min_platform_version: 0.6.0
compatible_models:
  - manufacturer: Behringer
    models: [X32, X32 Compact, X32 Producer, X32 Rack, X32 Core]
    confidence: untested
  - manufacturer: Midas
    models: [M32, M32 LIVE, M32R, M32C]
    confidence: untested
    notes: Identical OSC protocol to X32.

transport: osc

help:
  overview: >-
    Controls a Behringer X32 or X32 Compact digital mixer over the network
    using the OSC (Open Sound Control) protocol. Full console coverage
    including all 32 input channels, 16 mix buses, 6 matrices, 8 DCAs,
    8 aux inputs, 8 FX returns, and main stereo/mono outputs.
  setup: >-
    1. Connect the X32 to the same network as the OpenAVC server.
    2. On the X32, go to Setup > Network and note the IP address.
    3. Enter the IP address in the device config. The default port is 10023.
    4. The driver will automatically subscribe to feedback and start
       receiving fader/mute updates.

discovery:
  # X32 / M32 speak OSC and do NOT advertise on the network — the OSC
  # spec is push-from-controller only. Hint-only by design (Behringer's
  # protocol manual has no announce message, and X32 doesn't dial out
  # either). Match by Behringer Spezielle Studiotechnik OUI + OSC port
  # + manufacturer alias.
  oui:
    - "00:15:64"
  port_open:
    - 10023
  manufacturer_alias:
    - "behringer"
    - "music tribe"
    - "midas"

default_config:
  host: ""
  port: 10023
  poll_interval: 9

config_schema:
  host:
    type: string
    required: true
    label: IP Address
    description: X32 network IP address (Setup > Network on the console)
  port:
    type: integer
    default: 10023
    label: OSC Port
    description: Default is 10023 for X32/M32, 10024 for X-Air series

state_variables:
  # Console info
  console_model:
    type: string
    label: Console Model
  firmware_version:
    type: string
    label: Firmware Version

  # Scene/show
  current_scene:
    type: integer
    label: Current Scene
  show_name:
    type: string
    label: Show Name

  # ── Input Channels 1-32 ──
  ch01_fader:
    type: number
    label: Ch 01 Fader
    min: 0
    max: 1
  ch01_mute:
    type: boolean
    label: Ch 01 Mute
  ch01_name:
    type: string
    label: Ch 01 Name
  ch02_fader:
    type: number
    label: Ch 02 Fader
    min: 0
    max: 1
  ch02_mute:
    type: boolean
    label: Ch 02 Mute
  ch02_name:
