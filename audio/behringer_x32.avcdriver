commands:
  # Subscription renewal (called by polling)
  renew:
    label: Renew Subscription
    address: "/xremote"

  query_info:
    label: Query Console Info
    address: "/info"

  # ── Scene/Show commands ──
  recall_scene:
    label: Recall Scene
    address: "/-action/goscene"
    args:
      - type: i
        value: "{scene}"
    params:
      scene:
        type: integer
        label: Scene Number (0-99)

  recall_snippet:
    label: Recall Snippet
    address: "/-action/gosnippet"
    args:
      - type: i
        value: "{snippet}"
    params:
      snippet:
        type: integer
        label: Snippet Number (0-99)

  recall_cue:
    label: Recall Cue
    address: "/-action/gocue"
    args:
      - type: i
        value: "{cue}"
    params:
      cue:
        type: integer
        label: Cue Number (0-99)

  clear_solo:
    label: Clear All Solo
    address: "/-action/clearsolo"
    args:
      - type: i
        value: "1"

  # ── Channel commands ──
  # Channel faders (0.0 = -inf, 1.0 = +10 dB, 0.75 ≈ 0 dB)
  set_ch_fader:
    label: Set Channel Fader
    address: "/ch/{channel}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      channel:
        type: string
        label: Channel (01-32)
        description: "Two-digit format: 01, 02, ... 32"
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  # Channel mute (0 = muted, 1 = unmuted)
  mute_ch:
    label: Mute Channel
    address: "/ch/{channel}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      channel:
        type: string
        label: Channel (01-32)

  unmute_ch:
    label: Unmute Channel
    address: "/ch/{channel}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      channel:
        type: string
        label: Channel (01-32)

  # ── Bus commands ──
  set_bus_fader:
    label: Set Bus Fader
    address: "/bus/{bus}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      bus:
        type: string
        label: Bus (01-16)
        description: "Two-digit format: 01, 02, ... 16"
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_bus:
    label: Mute Bus
    address: "/bus/{bus}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      bus:
        type: string
        label: Bus (01-16)

  unmute_bus:
    label: Unmute Bus
    address: "/bus/{bus}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      bus:
        type: string
        label: Bus (01-16)

  # ── Matrix commands ──
  set_mtx_fader:
    label: Set Matrix Fader
    address: "/mtx/{mtx}/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      mtx:
        type: string
        label: Matrix (01-06)
        description: "Two-digit format: 01, 02, ... 06"
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_mtx:
    label: Mute Matrix
    address: "/mtx/{mtx}/mix/on"
    args:
      - type: i
        value: "0"
    params:
      mtx:
        type: string
        label: Matrix (01-06)

  unmute_mtx:
    label: Unmute Matrix
    address: "/mtx/{mtx}/mix/on"
    args:
      - type: i
        value: "1"
    params:
      mtx:
        type: string
        label: Matrix (01-06)

  # ── DCA commands ──
  set_dca_fader:
    label: Set DCA Fader
    address: "/dca/{dca}/fader"
    args:
      - type: f
        value: "{level}"
    params:
      dca:
        type: string
        label: DCA (1-8)
        description: "Single digit: 1, 2, ... 8"
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_dca:
    label: Mute DCA
    address: "/dca/{dca}/on"
    args:
      - type: i
        value: "0"
    params:
      dca:
        type: string
        label: DCA (1-8)

  unmute_dca:
    label: Unmute DCA
    address: "/dca/{dca}/on"
    args:
      - type: i
        value: "1"
    params:
      dca:
        type: string
        label: DCA (1-8)

  # ── Main stereo output ──
  set_main_st_fader:
    label: Set Main Stereo Fader
    address: "/main/st/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_main_st:
    label: Mute Main Stereo
    address: "/main/st/mix/on"
    args:
      - type: i
        value: "0"

  unmute_main_st:
    label: Unmute Main Stereo
    address: "/main/st/mix/on"
    args:
      - type: i
        value: "1"

  # ── Main mono output ──
  set_main_m_fader:
    label: Set Main Mono Fader
    address: "/main/m/mix/fader"
    args:
      - type: f
        value: "{level}"
    params:
      level:
        type: number
        label: Level (0.0-1.0)
        min: 0.0
        max: 1.0
        description: "0.0 = -inf, 0.75 = 0 dB, 1.0 = +10 dB"

  mute_main_m:
    label: Mute Main Mono
    address: "/main/m/mix/on"
    args:
      - type: i
        value: "0"

  unmute_main_m:
    label: Unmute Main Mono
    address: "/main/m/mix/on"
    args:
      - type: i
        value: "1"

# Subscribe to feedback on connect, query console info
on_connect:
  - "/xremote"
  - "/info"

# Renew subscription every 9 seconds (X32 expires after ~10s)
polling:
  interval: 9
  queries:
    - "renew"

responses:
  # Console info (4 string args: server version, server name, model, firmware)
  - address: "/info"
    mappings:
      - arg: 2
        state: console_model
        type: string
      - arg: 3
        state: firmware_version
        type: string

  # Scene/show
  - address: "/-show/prepos/current"
    mappings:
      - arg: 0
        state: current_scene
        type: integer
  - address: "/-show/showfile/show/name"
    mappings:
      - arg: 0
        state: show_name
        type: string

  # ── Channel 01-32 faders ──
  - address: "/ch/01/mix/fader"
