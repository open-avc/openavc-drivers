      key: dca3_mute
      label: DCA 3 Mute
    - type: slider
      key: dca4_fader
      label: DCA 4 Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: dca4_mute
      label: DCA 4 Mute
    # Main outputs
    - type: slider
      key: main_st_fader
      label: Main Stereo Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: main_st_mute
      label: Main Stereo Mute
    - type: slider
      key: main_m_fader
      label: Main Mono Fader
      min: 0
      max: 1
      step: 0.01
    - type: toggle
      key: main_m_mute
      label: Main Mono Mute

  # Per-strip OSC behavior. child_set-only response rules build no
  # auto-generated sim handlers (those come from `mappings:`), so these
  # script handlers own the strip addresses: SET + echo when args arrive,
  # answer the current value on a bare query — mirroring the real
  # console's query convention. Per-strip state lives in the flat sim
  # keys above (ch01_fader, dca1_mute, main_st_fader, ...) — the sim
  # models the device, independent of the driver's child state names.
  command_handlers:
    - address: "/ch/*"
      handler: |
        seg = address.split("/")
        n = seg[2]
        node = "/".join(seg[3:])
        if node == "mix/fader":
            key = "ch" + n + "_fader"
            if args:
                state[key] = float(args[0][1])
                respond(address, args)
            else:
                respond(address, [("f", float(state.get(key, 0.0)))])
        elif node == "mix/on":
            key = "ch" + n + "_mute"
            if args:
                state[key] = int(args[0][1]) == 0
                respond(address, args)
            else:
                respond(address, [("i", 0 if state.get(key, False) else 1)])
        elif node == "config/name":
            key = "ch" + n + "_name"
            if args:
                state[key] = str(args[0][1])[:12]
                respond(address, args)
            else:
                respond(address, [("s", str(state.get(key, "Ch " + n.lstrip("0"))))])
    - address: "/auxin/*"
      handler: |
        seg = address.split("/")
        n = seg[2]
        node = "/".join(seg[3:])
        if node == "mix/fader":
            key = "auxin" + n + "_fader"
            if args:
                state[key] = float(args[0][1])
                respond(address, args)
            else:
                respond(address, [("f", float(state.get(key, 0.0)))])
        elif node == "mix/on":
            key = "auxin" + n + "_mute"
            if args:
                state[key] = int(args[0][1]) == 0
                respond(address, args)
            else:
                respond(address, [("i", 0 if state.get(key, False) else 1)])
        elif node == "config/name":
            key = "auxin" + n + "_name"
            if args:
                state[key] = str(args[0][1])[:12]
                respond(address, args)
            else:
                respond(address, [("s", str(state.get(key, "Aux " + n.lstrip("0"))))])
    - address: "/fxrtn/*"
      handler: |
        seg = address.split("/")
        n = seg[2]
        node = "/".join(seg[3:])
        if node == "mix/fader":
            key = "fxrtn" + n + "_fader"
            if args:
                state[key] = float(args[0][1])
                respond(address, args)
            else:
                respond(address, [("f", float(state.get(key, 0.0)))])
        elif node == "mix/on":
            key = "fxrtn" + n + "_mute"
            if args:
                state[key] = int(args[0][1]) == 0
                respond(address, args)
            else:
                respond(address, [("i", 0 if state.get(key, False) else 1)])
        elif node == "config/name":
            key = "fxrtn" + n + "_name"
            if args:
                state[key] = str(args[0][1])[:12]
                respond(address, args)
            else:
                respond(address, [("s", str(state.get(key, "FX " + n.lstrip("0"))))])
    - address: "/bus/*"
      handler: |
        seg = address.split("/")
        n = seg[2]
        node = "/".join(seg[3:])
        if node == "mix/fader":
            key = "bus" + n + "_fader"
            if args:
                state[key] = float(args[0][1])
                respond(address, args)
            else:
                respond(address, [("f", float(state.get(key, 0.0)))])
        elif node == "mix/on":
            key = "bus" + n + "_mute"
            if args:
                state[key] = int(args[0][1]) == 0
                respond(address, args)
            else:
                respond(address, [("i", 0 if state.get(key, False) else 1)])
        elif node == "config/name":
            key = "bus" + n + "_name"
            if args:
                state[key] = str(args[0][1])[:12]
                respond(address, args)
            else:
                respond(address, [("s", str(state.get(key, "Bus " + n.lstrip("0"))))])
    - address: "/mtx/*"
      handler: |
        seg = address.split("/")
        n = seg[2]
        node = "/".join(seg[3:])
        if node == "mix/fader":
            key = "mtx" + n + "_fader"
            if args:
                state[key] = float(args[0][1])
                respond(address, args)
            else:
                respond(address, [("f", float(state.get(key, 0.0)))])
        elif node == "mix/on":
            key = "mtx" + n + "_mute"
            if args:
                state[key] = int(args[0][1]) == 0
                respond(address, args)
            else:
                respond(address, [("i", 0 if state.get(key, False) else 1)])
        elif node == "config/name":
            key = "mtx" + n + "_name"
            if args:
                state[key] = str(args[0][1])[:12]
                respond(address, args)
            else:
                respond(address, [("s", str(state.get(key, "Mtx " + n.lstrip("0"))))])
    - address: "/dca/*"
      handler: |
        seg = address.split("/")
        n = seg[2]
        node = "/".join(seg[3:])
        if node == "fader":
            key = "dca" + n + "_fader"
            if args:
                state[key] = float(args[0][1])
                respond(address, args)
            else:
                respond(address, [("f", float(state.get(key, 0.0)))])
        elif node == "on":
            key = "dca" + n + "_mute"
            if args:
                state[key] = int(args[0][1]) == 0
                respond(address, args)
            else:
                respond(address, [("i", 0 if state.get(key, False) else 1)])
        elif node == "config/name":
            key = "dca" + n + "_name"
            if args:
                state[key] = str(args[0][1])[:12]
                respond(address, args)
            else:
                respond(address, [("s", str(state.get(key, "DCA " + n)))])
    - address: "/main/*"
      handler: |
        seg = address.split("/")
        n = seg[2]
        node = "/".join(seg[3:])
        if node == "mix/fader":
            key = "main_" + n + "_fader"
            if args:
                state[key] = float(args[0][1])
                respond(address, args)
            else:
                respond(address, [("f", float(state.get(key, 0.0)))])
        elif node == "mix/on":
            key = "main_" + n + "_mute"
            if args:
                state[key] = int(args[0][1]) == 0
                respond(address, args)
            else:
                respond(address, [("i", 0 if state.get(key, False) else 1)])
        elif node == "config/name":
            key = "main_" + n + "_name"
            if args:
                state[key] = str(args[0][1])[:12]
                respond(address, args)
            else:
                respond(address, [("s", str(state.get(key, "Main" if n == "st" else "Mono")))])
