    # Main outputs
    main_st_fader: 0.75
    main_st_mute: false
    main_m_fader: 0.0
    main_m_mute: true

  delays:
    command_response: 0.005

  controls:
    # Channel 1-8 faders and mutes
    - type: slider
      key: ch01_fader
