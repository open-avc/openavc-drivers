    channel.4.tx_battery_percent: 85
    channel.4.tx_low_battery: false
    channel.4.tx_af_peak: false
    channel.4.sync_ignore_mute_config: false
    channel.4.sync_ignore_cable_emulation: false
    channel.4.sync_ignore_lowcut: false
