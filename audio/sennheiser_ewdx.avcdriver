on_connect:
  - query_identity
  - query_site
  - query_state
  - query_firmware
  - query_ssc_version
  - query_rf
  - query_transmission
  - query_identification

# The device-level resources only: a channel's GET body carries no channel
# number to route by, so channel and transmitter state comes from the
# session, which resends everything on every reopen.
polling:
  queries:
    - query_state
    - query_firmware
    - query_identification
    - query_transmission
    - query_site

# ── Simulator ──────────────────────────────────────────────────────────
# One dispatcher handler plays the receiver: it parses the synthesized
# request line, answers GETs from state, applies PUTs to state and, like
# the real receiver, sends the changed resource on the subscription stream
# afterwards. The subscription requests record what the driver asked for
# and answer with the current value of every newly subscribed resource,
# which is what makes the driver's state complete after a (re)open. The
# push block's session header and opening event come from the platform.
#
# Fidelity gaps, on purpose: any session id is accepted (a real receiver
# answers 422 for an unknown one), Basic auth is not checked, and a value
# the receiver would refuse (a gain between 3 dB steps) is stored as sent.
# Toggling a warning flag from the Simulator UI sends that one flag as the
# whole warnings array.
