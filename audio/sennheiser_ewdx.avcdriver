  command_handlers:
    # One dispatcher for every request: the synthesized line is
    # "METHOD /path|body". A matched script handler ends dispatch, so the
    # whole protocol lives in this one block.
    - match: '(?s:.+)'
      handler: |
        def _run():
            line = match.group(0)
            method, _sep, rest = line.partition(" ")
            path, _sep, body = rest.partition("|")
            path = path.split("?")[0]
            data = None
            if body:
                try:
                    data = json.loads(body)
                except ValueError:
                    data = None

            def roster():
                # The simulated receiver's channel count is the device
                # config's channel_count (2 or 4), like picking the model.
                try:
                    n = int(config.get("channel_count", 2) or 2)
                except (TypeError, ValueError):
                    n = 2
                return 4 if n >= 4 else 2

            def key(n, var):
                return "channel." + str(int(n) + 1) + "." + var

            def get(k, default=None):
                return state.get(k, default)

            def product():
                return "EWDX4CHDS" if roster() == 4 else "EWDX2CHDS"

            # ── Bodies, as the receiver's GET would answer them ──
            def body_identity():
                return {"product": product(), "hardwareRevision": get("hardware_revision"),
                        "serial": get("serial"), "vendor": get("vendor")}

            def body_site():
                return {"deviceName": get("device_name"), "location": get("location"),
                        "position": get("position")}

            def body_state():
                return {"state": get("device_state"), "warnings": []}

            def body_firmware():
                return {"deviceVersion": get("firmware_version"), "danteVersion": get("dante_version"),
                        "state": get("firmware_update_state"), "progress": get("firmware_update_progress"),
                        "lastStatus": get("firmware_last_status")}

            def body_rf():
                return {"code": get("rf_code"), "ranges": [{"start": get("rf_range_start_khz"),
                        "end": get("rf_range_end_khz"), "stepSize": get("rf_range_step_khz")}]}

            def body_transmission():
                return {"mode": get("transmission_mode"), "presetSpacing": get("preset_spacing_khz")}

            def body_channel(n):
                return {"name": get(key(n, "name")), "mute": get(key(n, "mute")),
                        "mates": [get(key(n, "mate"))], "gain": get(key(n, "gain")),
                        "audio": [get(key(n, "audio_output"))],
                        "outputLevel": get(key(n, "output_level")), "eventCounter": 0}

            def body_warnings(n):
                flags = []
                for name, var in (("Aes256Error", "aes256_error"), ("LowSignal", "low_signal"),
                                  ("NoLink", "no_link"), ("RfPeak", "rf_peak"), ("AfPeak", "af_peak")):
                    if get(key(n, var)):
                        flags.append(name)
                return flags

            def body_rf_channel(n):
                out = {"frequency": get(key(n, "frequency_khz")),
                       "presets": {"type": get(key(n, "preset_type"))}}
                if out["presets"]["type"] != "None":
                    out["presets"]["bank"] = get(key(n, "preset_bank"))
                    out["presets"]["channel"] = get(key(n, "preset_channel"))
                return out

            def body_sync(n):
                return {"muteConfig": get(key(n, "sync_mute_config")),
                        "cableEmulation": get(key(n, "sync_cable_emulation")),
                        "lowcut": get(key(n, "sync_lowcut")), "lock": get(key(n, "sync_lock")),
                        "trim": get(key(n, "sync_trim")), "led": get(key(n, "sync_led")),
                        "muteConfigTs": get(key(n, "sync_mute_config_ts"))}

            IGNORE = (("muteConfig", "mute_config"), ("cableEmulation", "cable_emulation"),
                      ("lowcut", "lowcut"), ("lock", "lock"), ("trim", "trim"), ("led", "led"),
                      ("name", "name"), ("frequency", "frequency"))

            def body_ignore(n):
                return dict((wire, get(key(n, "sync_ignore_" + var))) for wire, var in IGNORE)

            def body_tx(n):
                if not get(key(n, "tx_linked")):
                    return None
                out = {"type": get(key(n, "tx_type")), "capsule": get(key(n, "tx_capsule")),
                       "name": get(key(n, "tx_name")), "version": get(key(n, "tx_version")),
                       "mute": get(key(n, "tx_mute")), "identification": get(key(n, "tx_identifying")),
                       "lowcut": get(key(n, "tx_lowcut")), "trim": get(key(n, "tx_trim")),
                       "led": get(key(n, "tx_led")), "lock": get(key(n, "tx_lock"))}
                ttype = str(out["type"])
                if ttype.startswith("EW_DX_TS"):
                    out["cableEmulation"] = "Off"
                    out["muteConfigTableStand"] = get(key(n, "tx_mute_config_table_stand"))
                elif ttype in ("EW_DX_SK", "EW_DX_SK_3_PIN"):
                    out["cableEmulation"] = get(key(n, "tx_cable_emulation"))
                    out["muteConfig"] = get(key(n, "tx_mute_config"))
                elif ttype == "EW_DX_SKM_S":
                    out["muteConfig"] = get(key(n, "tx_mute_config"))
                return out

            def body_battery(n):
                if not get(key(n, "tx_linked")):
                    return None
                return {"type": get(key(n, "tx_battery_type")), "lifetime": get(key(n, "tx_battery_minutes")),
                        "gauge": get(key(n, "tx_battery_percent"))}

            def body_tx_warnings(n):
                if not get(key(n, "tx_linked")):
                    return None
                flags = []
                for name, var in (("LowBattery", "tx_low_battery"), ("AfPeak", "tx_af_peak")):
                    if get(key(n, var)):
                        flags.append(name)
                return flags

            def body_meter(n, var):
                return {"value": get(key(n, var))}

            METERS = (("signalStrengthIndicator", "rssi_dbm"), ("signalQualityIndicator", "rsqi_percent"),
                      ("diversityIndicator", "diversity"), ("level", "level_dbfs"))

            def channel_ok(n):
                return 0 <= int(n) < roster()

            def resource(p):
                """The GET body of one resource path, or None when the receiver has no such resource."""
                if p == "/api/device/identity":
                    return body_identity()
                if p == "/api/device/site":
                    return body_site()
                if p == "/api/device/state":
                    return body_state()
                if p == "/api/device/identification":
                    return {"visual": get("identifying")}
                if p == "/api/firmware/update/state":
                    return body_firmware()
                if p == "/api/ssc/version":
                    return {"protocol": get("ssc_protocol_version"), "schema": get("ssc_schema_version")}
                if p == "/api/rf":
                    return body_rf()
                if p == "/api/rf/transmission":
                    return body_transmission()
                if p == "/api/rf/encryption":
                    return {"enabled": get("encryption_enabled")}
                if p == "/api/ssc/legacyMode":
                    return {"enabled": get("legacy_mode_enabled")}
                if p == "/api/rf/presets/factory/banks/0":
                    return [470200 + 400 * i for i in range(20)]
                m = re.match(r"^/api/channel/(\d)(?:/(\w+))?$", p)
                if m and channel_ok(m.group(1)):
                    n, sub = m.group(1), m.group(2)
                    if sub is None:
                        return body_channel(n)
                    if sub == "warnings":
                        return body_warnings(n)
                    if sub == "identify":
                        return {"enabled": get(key(n, "identifying"))}
                    for res, var in METERS:
                        if sub == res:
                            return body_meter(n, var)
                    return None
                m = re.match(r"^/api/rf/channels/(\d)$", p)
                if m and channel_ok(m.group(1)):
                    return body_rf_channel(m.group(1))
                m = re.match(r"^/api/rf/presets/user/channels/(\d)/banks(?:/0)?$", p)
                if m and channel_ok(m.group(1)):
                    return [0] if p.endswith("banks") else [470200, 470600, 471000]
                m = re.match(r"^/api/syncSettings/(\d)(/ignore)?$", p)
                if m and channel_ok(m.group(1)):
                    return body_ignore(m.group(1)) if m.group(2) else body_sync(m.group(1))
                if p == "/api/transmitters":
                    out = []
                    for n in range(roster()):
                        tx = body_tx(n)
                        if tx is not None:
                            out.append({"id": n, "transmitter": tx})
                    return out
                m = re.match(r"^/api/transmitters/(\d)(?:/(battery|warnings))?$", p)
                if m and channel_ok(m.group(1)):
                    n, sub = m.group(1), m.group(2)
                    if sub is None:
                        return body_tx(n)
                    if sub == "battery":
                        return body_battery(n)
                    return body_tx_warnings(n)
                return None

            def send(p):
                """One subscription notification: {path: body}."""
                b = resource(p)
                if b is not None:
                    notify(json.dumps({p: b}))

            def send_transmitters():
                # A subscription to the control resource reports every existing
                # subresource and the resources below it (SSCv2 spec).
                for n in range(roster()):
                    if get(key(n, "tx_linked")):
                        for p in ("/api/transmitters/%d" % n, "/api/transmitters/%d/battery" % n,
                                  "/api/transmitters/%d/warnings" % n):
                            send(p)

            # ── Subscription session ──
            m = re.match(r"^/api/ssc/state/subscriptions/([0-9a-fA-F-]{36})(/add|/remove)?$", path)
            if m:
                current = [p for p in str(get("subscribed_paths", "")).split(",") if p]
                if method == "DELETE":
                    state["subscribed_paths"] = ""
                    respond("")
                    return
                if method == "GET" and not m.group(2):
                    respond(json.dumps(current))
                    return
                if method == "PUT" and isinstance(data, list):
                    wanted = [str(p) for p in data]
                    if m.group(2) == "/add":
                        new = [p for p in wanted if p not in current]
                        current = current + new
                    elif m.group(2) == "/remove":
                        current = [p for p in current if p not in wanted]
                        new = []
                    else:
                        new = [p for p in wanted if p not in current]
                        current = wanted
                    state["subscribed_paths"] = ",".join(current)
                    for p in new:
                        if p == "/api/transmitters":
                            send_transmitters()
                        else:
                            send(p)
                    respond("")
                    return
                respond("")
                return

            # ── Reads ──
            if method == "GET":
                b = resource(path)
                if b is not None:
                    respond(json.dumps(b))
                return

            if method != "PUT" or not isinstance(data, dict):
                return

            # ── Writes: apply, acknowledge, then notify the whole resource ──
            def apply(fields):
                for wire, k in fields:
                    if wire in data:
                        state[k] = data[wire]

            if path == "/api/device/identification":
                apply((("visual", "identifying"),))
                respond("")
                send(path)
                return
            if path == "/api/rf/transmission":
                apply((("mode", "transmission_mode"),))
                state["preset_spacing_khz"] = 50 if get("transmission_mode") == "LinkDensity" else 25
                respond("")
                send(path)
                return
            if path == "/api/rf/encryption":
                apply((("enabled", "encryption_enabled"),))
                respond("")
                send(path)
                return
            m = re.match(r"^/api/channel/(\d)(?:/(identify|restore|channelSorting))?$", path)
            if m and channel_ok(m.group(1)):
                n, sub = m.group(1), m.group(2)
                if sub is None:
                    apply((("name", key(n, "name")), ("mute", key(n, "mute")), ("gain", key(n, "gain")),
                           ("outputLevel", key(n, "output_level"))))
                    respond("")
                    send("/api/channel/" + n)
                elif sub == "identify":
                    apply((("enabled", key(n, "identifying")),))
                    respond("")
                    send(path)
                elif sub == "restore":
                    state[key(n, "gain")] = 18
                    state[key(n, "output_level")] = 0
                    state[key(n, "mute")] = False
                    respond("")
                    send("/api/channel/" + n)
                else:
                    respond("")
                return
            m = re.match(r"^/api/rf/channels/(\d)/(frequency|preset)$", path)
            if m and channel_ok(m.group(1)):
                n, sub = m.group(1), m.group(2)
                if sub == "frequency":
                    apply((("frequency", key(n, "frequency_khz")),))
                    state[key(n, "preset_type")] = "None"
                else:
                    apply((("type", key(n, "preset_type")), ("bank", key(n, "preset_bank")),
                           ("channel", key(n, "preset_channel"))))
                    state[key(n, "frequency_khz")] = 470200 + 400 * (int(get(key(n, "preset_channel"), 1)) - 1)
                respond("")
                send("/api/rf/channels/" + n)
                return
            m = re.match(r"^/api/rf/presets/user/channels/(\d)/banks/0$", path)
            if m and channel_ok(m.group(1)):
                respond("")
                return
            m = re.match(r"^/api/syncSettings/(\d)(/ignore)?$", path)
            if m and channel_ok(m.group(1)):
                n = m.group(1)
                if m.group(2):
                    apply(tuple((wire, key(n, "sync_ignore_" + var)) for wire, var in IGNORE))
                else:
                    apply((("muteConfig", key(n, "sync_mute_config")),
                           ("cableEmulation", key(n, "sync_cable_emulation")),
                           ("lowcut", key(n, "sync_lowcut")), ("lock", key(n, "sync_lock")),
                           ("trim", key(n, "sync_trim")), ("led", key(n, "sync_led")),
                           ("muteConfigTs", key(n, "sync_mute_config_ts"))))
                respond("")
                send(path)
                return

        _run()
