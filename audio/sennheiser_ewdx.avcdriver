    channel.4.sync_ignore_trim: false
    channel.4.sync_ignore_led: false
    channel.4.sync_ignore_name: false
    channel.4.sync_ignore_frequency: false

  delays:
    command_response: 0.02

  # Changes made from the Simulator UI reach the stream through these; a
  # PUT from the driver is answered by the dispatcher below, which sends the
  # whole resource.
