# Shure Networked Audio Device Driver
#
# Controls Shure networked audio products over TCP (port 2202).
# Covers MXA910/920/710 ceiling microphones, ANI interfaces,
# P300 IntelliMix processor, and SCM820 automixer.
#
# Protocol reference: Shure Command Strings Reference
# https://pubs.shure.com/guide/commandstrings
# (pubs.shure.com renders client-side; wire formats cross-checked against
# mature open-source control implementations tested on real hardware.)
#
# Command format: < <COMMAND> <CHANNEL> <VALUE> >
# Response format: < REP <COMMAND> <CHANNEL> <VALUE> >
#
# Notes:
#   - Commands are wrapped in angle brackets: < ... >
#   - Spaces between fields
#   - Channel numbers are 1-based (use 0 for all channels / device level)
#   - GET commands use the same format as SET but without the value
#   - String values in REP lines are brace-wrapped ({My Mic}) and may be
#     space-padded; the response rules strip both.
#   - The device-name property is DEVICE_ID on every covered model
#     (MXA / P300 / ANI / SCM820). There is no DEVICE_NAME property.
#   - Unsupported properties answer < REP ERR > — benign, ignored. The
#     surface below is family-mixed: DEVICE_AUDIO_MUTE / PRESET / LED_*
#     are MXA / P300 / ANI; SCM820 mutes per channel and has no presets.
#
# Push vs poll: the device pushes < REP ... > lines on state changes made
# from other controllers (Shure Designer, web UI), and the same response
# rules parse them. Because pushes are unsolicited, a silent link drop is
# otherwise invisible — the liveness block probes DEVICE_ID as a heartbeat.

id: shure_network
name: Shure Networked Devices
manufacturer: Shure
category: audio
version: 1.6.0
author: OpenAVC
description: >
  Controls Shure networked audio devices over TCP (port 2202).
  Covers MXA910/920/710 ceiling microphone arrays, ANI interfaces,
  P300 IntelliMix processor, and SCM820 automixer.

source_url: https://pubs.shure.com/guide/commandstrings
tags: [ceiling-mic, wireless-mic, intellimix]
verified: false
simulated: true
protocols: [shure_dcs]
ports: [2202]
min_platform_version: "0.22.0"
compatible_models:
  - manufacturer: Shure
    models:
      - MXA910
      - MXA920
      - MXA710
      - ANI22
      - ANI4IN
      - ANI4OUT
      - P300 IntelliMix
      - SCM820
    confidence: untested

transport: tcp
delimiter: ">"

discovery:
  # Shure documentation does not advertise a custom `_shure._tcp`
  # namespace — Web Device Discovery / Designer enumerate devices via
  # standard mDNS (`_http._tcp` on UDP 5353) plus TXT/hostname filters.
  # The `_shure-mxa._tcp`, `_axient-d._tcp`, `_intellimix._tcp` and
  # `_shure-control._tcp` candidates return zero hits across IANA,
  # vendor docs, and GitHub code search — they are not real registered
  # service types. We do an active DCS query on TCP/2202 plus the
  # OUI / hostname / manufacturer-alias hints.
  #   Common IP ports doc:
  #     content-files.shure.com/FileRepository/common-ip-ports-v2.pdf
  #   System API / device-discovery-lifecycle:
  #     shure.stoplight.io
  tcp_probe:
    port: 2202
    send_ascii: "< GET DEVICE_ID >\r\n"
    expect_regex: '<\s*REP\s+DEVICE_ID'
    extract_manufacturer: "Shure"
    extract:
      device_name:
        regex: '<\s*REP\s+DEVICE_ID\s+\{?\s*([^{}>]+?)\s*\}?\s*>'
  oui:
    - "00:0e:dd"   # Shure Incorporated (legacy MA-L)
    - "d8:34:ee"   # Shure Incorporated (current MXA / AD product blocks)
  hostname:
    - "^MXA"
    - "^ANI"
    - "^AD4"
    - "^ULXD"
    - "^MXW"
    - "^P300"
    - "^IMX"
  port_open:
    - 2202
  manufacturer_alias:
    - "shure"
    - "shure incorporated"

default_config:
  host: ""
  port: 2202
  poll_interval: 10

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 2202
    label: Port
  poll_interval:
    type: integer
    default: 10
    min: 0
    label: Poll Interval (sec)

on_connect:
  - "< GET ALL >"

state_variables:
  device_name:
    type: string
    label: Device Name
    help: "Friendly device name configured on the Shure device (the DEVICE_ID property)."
  mute:
    type: boolean
    label: Mute State
    help: "Device-level mute. True when DEVICE_AUDIO_MUTE is ON. (MXA / P300 / ANI; the SCM820 mutes per channel instead.)"
  audio_mute:
    type: boolean
    label: Audio Mute
    help: "Audio output mute, mirror of `mute` exposed for compatibility with templates that bind to audio_mute."
  led_brightness:
    type: integer
    label: LED Brightness
    help: "Device LED brightness: 0 = disabled, 1 = dim, 2 = default. Not reported by every model."
  firmware:
    type: string
    label: Firmware Version
    help: "Firmware version string reported by the device (FW_VER)."
  meter_level:
    type: integer
    label: Meter Level (dB)
    help: "Latest audio meter reading in dB, sampled from the device's level stream."

commands:
  mute_on:
    label: Mute
    send: "< SET DEVICE_AUDIO_MUTE ON >"

  mute_off:
    label: Unmute
    send: "< SET DEVICE_AUDIO_MUTE OFF >"

  mute_toggle:
    label: Toggle Mute
    send: "< SET DEVICE_AUDIO_MUTE TOGGLE >"

  # Channel-level mute (for multi-channel devices like MXA910; channel 0 = all)
  channel_mute_on:
    label: Channel Mute On
    send: "< SET {channel} AUDIO_MUTE ON >"
    params:
      channel:
        type: integer
        required: true
        label: Channel Number
        min: 0

  channel_mute_off:
    label: Channel Mute Off
    send: "< SET {channel} AUDIO_MUTE OFF >"
    params:
      channel:
        type: integer
        required: true
        label: Channel Number
        min: 0

  # LED behavior is configured per mute state: the muted and unmuted looks
  # each carry their own state (on/off/flashing) and color.
  set_led_state:
    label: Set LED State
    send: "< SET LED_STATE_{which} {state} >"
    params:
      which:
        type: enum
        values: ["MUTED", "UNMUTED"]
        required: true
        label: Mute State to Configure
      state:
        type: enum
        values: ["ON", "OFF", "FLASHING"]
        required: true
        label: LED State

  set_led_color:
    label: Set LED Color
    send: "< SET LED_COLOR_{which} {color} >"
    params:
      which:
        type: enum
        values: ["MUTED", "UNMUTED"]
        required: true
        label: Mute State to Configure
      color:
        type: enum
        values: ["RED", "ORANGE", "GOLD", "YELLOW", "YELLOWGREEN", "GREEN",
                 "TURQUOISE", "POWDERBLUE", "CYAN", "SKYBLUE", "BLUE", "PURPLE",
                 "LIGHTPURPLE", "VIOLET", "ORCHID", "PINK", "WHITE"]
        required: true
        label: LED Color

  set_led_brightness:
    label: Set LED Brightness
    send: "< SET LED_BRIGHTNESS {level} >"
    params:
      level:
        type: integer
        required: true
        label: Brightness (0=off, 1=dim, 2=default)
        min: 0
        max: 2

  flash_on:
    label: Flash LEDs (Identify)
    send: "< SET FLASH ON >"

  flash_off:
    label: Stop Flashing
    send: "< SET FLASH OFF >"

  # Gain control (IntelliMix P300)
  set_gain:
    label: Set Input Gain
    send: "< SET {channel} AUDIO_GAIN_HI_RES {level} >"
    params:
      channel:
        type: integer
        required: true
        label: Channel Number
      level:
        type: integer
        required: true
        label: Gain (dB * 10)
        description: "Gain in tenths of dB, e.g., -120 = -12.0 dB"

  recall_preset:
    label: Recall Preset
    send: "< SET PRESET {preset} >"
    params:
      preset:
        type: integer
        required: true
        label: Preset Number
        min: 1
        max: 10
        description: "Presets 1-10 (MXA, P300, ANI; the SCM820 has no presets)."

device_settings:
  led_brightness:
    type: integer
    label: LED Brightness
    help: "Device LED brightness: 0 = disabled, 1 = dim, 2 = default."
    state_key: led_brightness
    default: 2
    min: 0
    max: 2
    setup: false
    write:
      send: "< SET LED_BRIGHTNESS {value} >"

# Everyday actions for the device card: device mute pair, identify, preset.
actions:
  - id: mute_on
    icon: mic-off
  - id: mute_off
    icon: mic
  - id: flash_on
    icon: sun
  - id: recall_preset
    icon: bookmark

responses:
  # Device name: < REP DEVICE_ID {name} > (braces optional, value may be padded)
  - match: 'REP DEVICE_ID \{?\s*([^{}]+?)\s*\}?\s*$'
    set: { device_name: "$1" }

  # Device mute: < REP DEVICE_AUDIO_MUTE ON > or OFF
  - match: 'REP DEVICE_AUDIO_MUTE ON'
    set: { mute: "true", audio_mute: "true" }
  - match: 'REP DEVICE_AUDIO_MUTE OFF'
    set: { mute: "false", audio_mute: "false" }

  # LED brightness: < REP LED_BRIGHTNESS 2 >
  - match: 'REP LED_BRIGHTNESS (\d)'
    set: { led_brightness: "$1" }

  # Firmware version: < REP FW_VER {x.x.x} >
  - match: 'REP FW_VER \{?\s*([^{}\s]+)'
    set: { firmware: "$1" }

polling:
  queries:
    - "< GET DEVICE_AUDIO_MUTE >"
    - "< GET DEVICE_ID >"
    - "< GET LED_BRIGHTNESS >"

# The device pushes REP lines only for changes made elsewhere, so an idle,
# untouched system exchanges no traffic — and a silently dropped link (no
# FIN) would otherwise go unnoticed until the next command failed. Probe
# the universal DEVICE_ID property; K missed probes drop the connection
# with a typed no_response fault and reconnect.
liveness:
  send: "< GET DEVICE_ID >"
  expect: 'REP DEVICE_ID'
  interval: 30
  timeout: 5
  max_failures: 2

# ── SIMULATOR DEFINITION ──

simulator:
  push_state: true
  initial_state:
    device_name: "MXA920-SIM"
    mute: false
    audio_mute: false
    led_brightness: 2
    firmware: "4.6.11"
    meter_level: -42

  delays:
    command_response: 0.02

  controls:
    - type: toggle
      key: mute
      label: Device Mute
    - type: indicator
      key: meter_level
      label: Level (dB)
    - type: indicator
      key: led_brightness
      label: LED Brightness
    - type: indicator
      key: device_name
      label: Device Name
    - type: indicator
      key: firmware
      label: Firmware

  notifications:
    mute:
      'true': '< REP DEVICE_AUDIO_MUTE ON >'
      'false': '< REP DEVICE_AUDIO_MUTE OFF >'
    audio_mute:
      'true': '< REP DEVICE_AUDIO_MUTE ON >'
      'false': '< REP DEVICE_AUDIO_MUTE OFF >'

  command_handlers:
    # GET queries — respond with REP format
    # Patterns include < > framing since that's part of the on-wire protocol.
    # String values respond brace-wrapped like real hardware.
    - match: '< GET DEVICE_AUDIO_MUTE >'
      handler: |
        val = "ON" if state["mute"] else "OFF"
        respond(f"< REP DEVICE_AUDIO_MUTE {val} >")

    - match: '< GET DEVICE_ID >'
      handler: |
        respond(f'< REP DEVICE_ID {{{state["device_name"]}}} >')

    - match: '< GET FW_VER >'
      handler: |
        respond(f'< REP FW_VER {{{state["firmware"]}}} >')

    - match: '< GET LED_BRIGHTNESS >'
      handler: |
        respond(f'< REP LED_BRIGHTNESS {state["led_brightness"]} >')

    - match: '< GET ALL >'
      handler: |
        val = "ON" if state["mute"] else "OFF"
        respond(
            f'< REP DEVICE_ID {{{state["device_name"]}}} >'
            f'< REP DEVICE_AUDIO_MUTE {val} >'
            f'< REP FW_VER {{{state["firmware"]}}} >'
            f'< REP LED_BRIGHTNESS {state["led_brightness"]} >'
        )

    # SET device mute
    - match: '< SET DEVICE_AUDIO_MUTE (ON|OFF|TOGGLE) >'
      handler: |
        action = match.group(1)
        if action == "ON":
            state["mute"] = True
            state["audio_mute"] = True
        elif action == "OFF":
            state["mute"] = False
            state["audio_mute"] = False
        elif action == "TOGGLE":
            state["mute"] = not state["mute"]
            state["audio_mute"] = state["mute"]
        val = "ON" if state["mute"] else "OFF"
        respond(f"< REP DEVICE_AUDIO_MUTE {val} >")

    # SET channel mute
    - match: '< SET (\d+) AUDIO_MUTE (ON|OFF) >'
      handler: |
        channel = match.group(1)
        action = match.group(2)
        respond(f"< REP {channel} AUDIO_MUTE {action} >")

    # SET LED behavior per mute state
    - match: '< SET LED_STATE_(MUTED|UNMUTED) (ON|OFF|FLASHING) >'
      handler: |
        which = match.group(1)
        led = match.group(2)
        respond(f"< REP LED_STATE_{which} {led} >")

    - match: '< SET LED_COLOR_(MUTED|UNMUTED) (\w+) >'
      handler: |
        which = match.group(1)
        color = match.group(2)
        respond(f"< REP LED_COLOR_{which} {color} >")

    # SET LED brightness
    - match: '< SET LED_BRIGHTNESS (\d) >'
      handler: |
        state["led_brightness"] = int(match.group(1))
        respond(f'< REP LED_BRIGHTNESS {state["led_brightness"]} >')

    # Flash (identify) — real hardware auto-clears after 30s
    - match: '< SET FLASH (ON|OFF) >'
      handler: |
        respond(f"< REP FLASH {match.group(1)} >")

    # SET gain
    - match: '< SET (\d+) AUDIO_GAIN_HI_RES (-?\d+) >'
      handler: |
        channel = match.group(1)
        level = match.group(2)
        respond(f"< REP {channel} AUDIO_GAIN_HI_RES {level} >")

    # Recall preset
    - match: '< SET PRESET (\d+) >'
      handler: |
        preset = match.group(1)
        respond(f"< REP PRESET {preset} >")

  error_modes:
    communication_timeout:
      behavior: no_response
      description: "Device stops responding to all commands (network issue or device crash)"
