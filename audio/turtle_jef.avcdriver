# Turtle AV JEF Dante Enabled Mic Preamp Driver
#
# Controls the Turtle AV JEF, a one-input Dante microphone preamp, over its
# ASCII command port (default TCP 8000).
#
# Sources.
#   - Commands, parameters and ranges: the JEF's own command list, printed by
#     the unit in answer to `help` (header "Help Info TAV-JEF Audio Bridge",
#     firmware Web V1.10.04, MCU V2.0.0, DEP V1.3.3.5_20260115). TurtleAV
#     sent it on 2026-11-16, because the JEF user guide covers only the Web
#     GUI.
#   - How the unit answers: TurtleAV says the JEF's API is the same as the
#     Mineola Dante Bridge's, whose user guide ("7. API Control Command",
#     `source_url`) gives the reply form "<channel> <field>: <value>"
#     ("XLR IN1 gain: 10dB", "XLR IN1 mute: on"). The JEF's list prints no
#     replies, so every rule matches the field ("gain:", "mute:") and never the
#     channel name, which the JEF lets you change. The only JEF replies on
#     record are the two header lines of its command list, read below.
#
# Covered: input gain (-60 to +12 dB), gain steps, mute, 48V phantom power,
# sensitivity (five levels), input name; the 8-band parametric EQ (each band,
# EQ on/off, clear); the expander and the compressor (on/off, settings,
# clear); presets 1-8 (save, recall, clear, name); model, firmware, reboot,
# and the unit's command list and status report.
# Not covered: factory reset (`reset`, `reset all` wait for a typed "Yes");
# the network and password blocks (commissioning, as in turtle_bt_wallplate).
# `raw_command` reaches them.
#
# Inferred, to confirm against a unit:
#   - The on/off replies for EQ, expander and compressor ("... EQ active: on",
#     "... expander active: on", "... compressor active: on") follow the
#     Mineola form. If the JEF words them otherwise, those three readings stay
#     empty and a Device Audit shows the reply unread.
#   - The answers to a settings read (`get input exp setting` and the like)
#     carry several values each and are not parsed.
#   - The gain step answer ("Increase ... gain: 5dB") prints the step in the
#     Mineola document's examples, not the level, so the level is read back.
#
# Push vs poll: POLL. Request/response only.
#
# Line ending: not stated. CRLF is what the Dante Bluetooth Wallplate (same
# TurtleAV firmware family: MCU/Web/DEP versions, TCP and Telnet ports, the
# same command grammar) takes on the bench; replies are framed on LF and
# trimmed, so a CRLF or LF reply reads the same.
#
# Format: YAML. One channel, text request/response, one reply line per value:
# nothing here needs Python.

id: turtle_jef
name: Turtle AV JEF Dante Mic Preamp
manufacturer: TurtleAV
category: audio
version: 2.0.0
author: OpenAVC
min_platform_version: "0.36.0"
description: >
  Controls the Turtle AV JEF Dante Enabled Mic Preamp over its TCP control
  port. Input gain, mute, 48V phantom power and sensitivity; the 8-band
  parametric EQ, expander and compressor; presets 1-8 with names; and reboot.

source_url: https://turtleav.com/download/262/mineola-2x2/28704/mineola-2x2-user-guide.pdf
tags: [dante, microphone, preamp, audio, mic, dsp]
verified: false
simulated: true
ports: [8000]
compatible_models:
  - manufacturer: TurtleAV
    models: [JEF]
    confidence: untested
    notes: >
      Built from the command list a JEF prints (firmware Web V1.10.04) and
      the reply form of the Mineola Dante Bridge, which TurtleAV says the JEF
      shares. Not yet run against a JEF.

transport: tcp
delimiter: "\n"

help:
  overview: >
    Controls the Turtle AV JEF, a Dante microphone preamp with one XLR input.
    Use it to set the input gain and sensitivity, mute the microphone, switch
    48V phantom power, adjust the 8-band EQ, expander and compressor, and
    save, recall and name presets. Dante routing, sample rate and latency are
    set in Dante Controller.
  setup: >
    1. Connect the JEF's Dante PRIMARY (PoE) port to a PoE network switch.
    2. Find the JEF's IP address in Dante Controller (Device Info tab). The
       JEF uses DHCP out of the box.
    3. Enter that IP address here. The control port is 8000 unless it was
       changed on the JEF's Network page.
    4. No password is needed for control. The Admin and User logins protect
       the JEF's web page only.

discovery:
  # Active identify probe: the JEF answers `help` with its command list,
  # whose first line is "Help Info TAV-JEF Audio Bridge" (TurtleAV's capture,
  # firmware Web V1.10.04). Matched anywhere in the reply, not as a prefix.
  # Hostname: the JEF guide gives its IP Hostname as "TAV-JEF-XXXXX.local"
  # (e.g. TAV-JEF-0046F), changeable on its Network page, so a soft hint.
  # OUI: TurtleAV's IEEE block is the MA-M 18:66:96:1 (the /24 around it is
  # split among other companies); whether a JEF's MAC is in it is not known.
  tcp_probe:
    port: 8000
    send_ascii: "help\r\n"
    expect_regex: "Info TAV-JEF\\b"
    timeout_ms: 2000
    extract:
      model:
        regex: 'Info (TAV-JEF[\w-]*)'
        group: 1
  hostname:
    - "^TAV-JEF-"
    - "^tav-jef-"
  oui:
    - "18:66:96:1"
  manufacturer_alias:
    - "turtleav"
    - "turtle av"
    - "turtle"

default_config:
  host: ""
  port: 8000
  poll_interval: 5

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 8000
    label: Port
    help: "The JEF's TCP control port (default 8000, set on its Network page)."
  poll_interval:
    type: integer
    default: 5
    min: 0
    label: Poll Interval (sec)

on_connect:
  - query_model
  - query_firmware

state_variables:
  model:
    type: string
    label: Model
    help: "The model name the JEF reports."
  firmware_web:
    type: string
    label: Web Firmware
  firmware_mcu:
    type: string
    label: MCU Firmware
  firmware_dep:
    type: string
    label: Dante Firmware
    help: "The Dante (DEP) firmware version."

  gain:
    type: number
    label: Input Gain
    min: -60
    max: 12
    step: 0.1
    unit: dB
    control: true
    help: "Microphone input gain, -60 to +12 dB."
  mute:
    type: boolean
    label: Input Mute
    control: true
    cloud_priority: high
    help: "True when the microphone input is muted."
  phantom_power:
    type: boolean
    label: Phantom Power
    control: true
    cloud_priority: high
    help: "True when 48V phantom power is on at the XLR input."
  sensitivity:
    type: string
    label: Input Sensitivity
    help: "The input sensitivity the JEF reports, in its own words (for example -20dBu)."
  eq_active:
    type: boolean
    label: EQ On
    control: true
    help: "True when the input's parametric EQ is on."
  expander_active:
    type: boolean
    label: Expander On
    control: true
    help: "True when the input's expander is on."
  compressor_active:
    type: boolean
    label: Compressor On
    control: true
    help: "True when the input's compressor is on."

commands:
  # ── Status queries (the poll and start-up run these by name) ──
  query_model:
    label: Query Model
    send: 'get type\r\n'
    query_for: model
    help: "Reads the model name the JEF reports."

  query_firmware:
    label: Query Firmware
    send: 'get fw version\r\n'
    query_for: firmware_web
    help: "Reads the JEF's Web, MCU and Dante firmware versions."

  query_input_gain:
    label: Query Input Gain
    send: 'get input gain\r\n'
    query_for: gain
    help: "Reads the microphone input gain."

  query_input_mute:
    label: Query Input Mute
    send: 'get input mute\r\n'
    query_for: mute
    help: "Reads whether the microphone input is muted."

  query_phantom_power:
    label: Query Phantom Power
    send: 'get input phantom power\r\n'
    query_for: phantom_power
    help: "Reads whether 48V phantom power is on."

  query_sensitivity:
    label: Query Input Sensitivity
    send: 'get input sensitivity\r\n'
    query_for: sensitivity
    help: "Reads the input sensitivity the JEF is set to."

  query_eq_active:
    label: Query EQ On
    send: 'get input eq active\r\n'
    query_for: eq_active
    help: "Reads whether the input's EQ is on."

  query_expander_active:
    label: Query Expander On
    send: 'get input exp active\r\n'
    query_for: expander_active
    help: "Reads whether the input's expander is on."

  query_compressor_active:
    label: Query Compressor On
    send: 'get input comp active\r\n'
    query_for: compressor_active
    help: "Reads whether the input's compressor is on."

  # ── The unit's own reports ──
  list_commands:
    label: List API Commands
    send: 'help\r\n'
    help: >
      Asks the JEF to list every command it takes. The list shows in the
      device's traffic log and in a Device Audit report.

  read_status:
    label: Read Full Status
    send: 'status\r\n'
    help: >
      Asks the JEF for its full status report. The report shows in the
      device's traffic log and in a Device Audit report.

  # ── Input ──
  set_input_gain:
    label: Set Input Gain
    send: 'set input gain {value}\r\n'
    sets: { gain: "{value}" }
    help: "Set the microphone input gain, -60 to +12 dB in 0.1 dB steps."
    params:
      value:
        type: number
        required: true
        label: Gain (dB)
        min: -60
        max: 12

  input_gain_up:
    label: Input Gain Up
    send: 'set input gain+\r\n'
    read_back: query_input_gain
    help: "Raise the input gain by 1 dB."

  input_gain_down:
    label: Input Gain Down
    send: 'set input gain-\r\n'
    read_back: query_input_gain
    help: "Lower the input gain by 1 dB."

  mute_on:
    label: Mute Input
    send: 'set input mute on\r\n'
    sets: { mute: true }
    help: "Mute the microphone input."

  mute_off:
    label: Unmute Input
    send: 'set input mute off\r\n'
    sets: { mute: false }
    help: "Unmute the microphone input."

  phantom_power_on:
    label: Phantom Power On
    send: 'set input phantom power on\r\n'
    sets: { phantom_power: true }
    help: "Turn on 48V phantom power at the XLR input. The 48V LED on the JEF lights."

  phantom_power_off:
    label: Phantom Power Off
    send: 'set input phantom power off\r\n'
    sets: { phantom_power: false }
    help: "Turn off 48V phantom power at the XLR input. The 48V LED on the JEF goes out."

  set_input_sensitivity:
    label: Set Input Sensitivity
    send: 'set input sensitivity {level}\r\n'
    read_back: query_sensitivity
    help: "Set the input sensitivity. Use 0 dBu for line level and -40 dBu for the quietest microphones."
    params:
      level:
        type: enum
        required: true
        label: Sensitivity
        values:
          - { value: "1", label: "0 dBu" }
          - { value: "2", label: "-10 dBu" }
          - { value: "3", label: "-20 dBu" }
          - { value: "4", label: "-30 dBu" }
          - { value: "5", label: "-40 dBu" }

  set_input_name:
    label: Set Input Name
    send: 'set input name {name}\r\n'
    help: "Name the input channel: up to 32 characters, with no spaces."
    params:
      name:
        type: string
        required: true
        label: Name
        # The JEF's list shows the name as one word (`set input name y`).
        pattern: '[^ ]{1,32}'

  # ── Parametric EQ (band 0 = all bands) ──
  eq_on:
    label: EQ On
    send: 'set input eq active on\r\n'
    sets: { eq_active: true }
    help: "Turn the input's parametric EQ on."

  eq_off:
    label: EQ Off
    send: 'set input eq active off\r\n'
    sets: { eq_active: false }
    help: "Turn the input's parametric EQ off."

  eq_band_on:
    label: EQ Band On
    send: 'set input eq {band} on\r\n'
    help: "Turn on one EQ band, or all of them."
    params:
      band:
        type: enum
        required: true
        label: Band
        values:
          - { value: "0", label: "All bands" }
          - "1"
          - "2"
          - "3"
          - "4"
          - "5"
          - "6"
          - "7"
          - "8"

  eq_band_off:
    label: EQ Band Off
    send: 'set input eq {band} off\r\n'
    help: "Turn off one EQ band, or all of them."
    params:
      band:
        type: enum
        required: true
        label: Band
        values:
          - { value: "0", label: "All bands" }
          - "1"
          - "2"
          - "3"
          - "4"
          - "5"
          - "6"
          - "7"
          - "8"

  set_eq_band:
    label: Set EQ Band
    send: 'set input eq {band} typ {type} frq {freq} val {gain} q {q}\r\n'
    help: "Set one EQ band's filter type, frequency, gain and Q, or all bands at once."
    params:
      band:
        type: enum
        required: true
        label: Band
        values:
          - { value: "0", label: "All bands" }
          - "1"
          - "2"
          - "3"
          - "4"
          - "5"
          - "6"
          - "7"
          - "8"
      type:
        type: enum
        required: true
        label: Filter Type
        values:
          - { value: "1", label: "Parametric" }
          - { value: "2", label: "Lowpass" }
          - { value: "3", label: "Highpass" }
          - { value: "4", label: "Low Shelf" }
          - { value: "5", label: "High Shelf" }
      freq:
        type: integer
        required: true
        label: Frequency (Hz)
        min: 20
        max: 80000
      gain:
        type: number
        required: true
        label: Gain (dB)
        min: -15
        max: 15
      q:
        type: number
        required: true
        label: Q
        min: 0.02
        max: 16

  eq_clear:
    label: Clear EQ
    confirm: "Sets every EQ band on the input back to flat, losing its settings."
    send: 'set input eq clear\r\n'
    help: "Clear the input's EQ settings."

  # ── Expander ──
  expander_on:
    label: Expander On
    send: 'set input exp active on\r\n'
    sets: { expander_active: true }
    help: "Turn the input's expander on."

  expander_off:
    label: Expander Off
    send: 'set input exp active off\r\n'
    sets: { expander_active: false }
    help: "Turn the input's expander off."

  set_expander:
    label: Set Expander
    send: 'set input exp thr {threshold} r {ratio} ht {hold} dec {decay}\r\n'
    help: "Set the expander's threshold, ratio, hold time and decay."
    params:
      threshold:
        type: number
        required: true
        label: Threshold (dB)
        min: -60
        max: 0
      ratio:
        type: number
        required: true
        label: Ratio
        min: 1
        max: 20
      hold:
        type: integer
        required: true
        label: Hold Time (ms)
        min: 1
        max: 2000
      decay:
        type: integer
        required: true
        label: Decay (dB/s)
        min: 1
        max: 120

  expander_clear:
    label: Clear Expander
    confirm: "Puts the expander's threshold, ratio, hold time and decay back to their defaults."
    send: 'set input exp clear\r\n'
    help: "Clear the expander's settings."

  # ── Compressor ──
  compressor_on:
    label: Compressor On
    send: 'set input comp active on\r\n'
    sets: { compressor_active: true }
    help: "Turn the input's compressor on."

  compressor_off:
    label: Compressor Off
    send: 'set input comp active off\r\n'
    sets: { compressor_active: false }
    help: "Turn the input's compressor off."

  set_compressor:
    label: Set Compressor
    send: 'set input comp thr {threshold} r {ratio} att {attack} re {release}\r\n'
    help: "Set the compressor's threshold, ratio, attack time and release time."
    params:
      threshold:
        type: number
        required: true
        label: Threshold (dB)
        min: -60
        max: 0
      ratio:
        type: number
        required: true
        label: Ratio
        min: 1
        max: 20
      attack:
        type: integer
        required: true
        label: Attack (ms)
        min: 1
        max: 500
      release:
        type: integer
        required: true
        label: Release (ms)
        min: 1
        max: 2000

  compressor_clear:
    label: Clear Compressor
    confirm: "Puts the compressor's threshold, ratio, attack and release back to their defaults."
    send: 'set input comp clear\r\n'
    help: "Clear the compressor's settings."

  # ── Presets (1-8) ──
  preset_recall:
    label: Recall Preset
    send: 'set preset recall {preset}\r\n'
    # A recall changes everything but the network settings, and its answer
    # carries none of the new values.
    read_back:
      - query_input_gain
      - query_input_mute
      - query_phantom_power
      - query_sensitivity
      - query_eq_active
      - query_expander_active
      - query_compressor_active
    help: "Recall a saved preset. Everything but the network settings changes."
    params:
      preset:
        type: integer
        required: true
        label: Preset
        min: 1
        max: 8

  preset_save:
    label: Save Preset
    confirm: "Saves the JEF's current settings over this preset, replacing what it held."
    send: 'set preset save {preset}\r\n'
    help: "Save the current settings (all but the network settings) to a preset."
    params:
      preset:
        type: integer
        required: true
        label: Preset
        min: 1
        max: 8

  preset_clear:
    label: Clear Preset
    confirm: "Erases this preset from the JEF."
    send: 'set preset clear {preset}\r\n'
    help: "Erase a saved preset."
    params:
      preset:
        type: integer
        required: true
        label: Preset
        min: 1
        max: 8

  set_preset_name:
    label: Set Preset Name
    send: 'set preset {preset} name {name}\r\n'
    help: "Name a preset: up to 16 characters, with no spaces."
    params:
      preset:
        type: integer
        required: true
        label: Preset
        min: 1
        max: 8
      name:
        type: string
        required: true
        label: Name
        # The JEF's list shows the name as one word (`set preset x name y`).
        pattern: '[^ ]{1,16}'

  # ── System ──
  reboot:
    label: Reboot
    send: 'reboot\r\n'
    help: "Reboot the JEF. Audio stops until it has started again."

  raw_command:
    label: Send Raw Command
    send: '{command}\r\n'
    help: >
      Send a command to the JEF exactly as written, without the line
      ending. For settings this driver does not offer, such as the network
      settings.
    params:
      command:
        type: string
        required: true
        label: Command
        trim: false

device_settings:
  gain:
    type: number
    min: -60
    max: 12
    label: Input Gain (dB)
    help: "Microphone input gain, -60 to +12 dB."
    state_key: gain
    default: 0
    setup: false
    write:
      send: 'set input gain {value}\r\n'

actions:
  - id: mute_on
    icon: mic-off
  - id: mute_off
    icon: mic

responses:
  # First match wins, so the order matters.
  # gain+ / gain- answer with the step ("Increase ... gain: 5dB"), not the
  # level: read but not stored. The command reads the level back.
  - match: '^(?:Increase|Decrease)\b.*\bgain:'
    set: {}
  - match: '\bgain:\s*(-?\d+(?:\.\d+)?)\s*dB'
    set: { gain: "$1" }

  - match: 'phantom power:\s*on\b'
    set: { phantom_power: "true" }
  - match: 'phantom power:\s*off\b'
    set: { phantom_power: "false" }
  - match: '\bmute:\s*on\b'
    set: { mute: "true" }
  - match: '\bmute:\s*off\b'
    set: { mute: "false" }
  - match: 'sensitivity:\s*(\S+)'
    set: { sensitivity: "$1" }

  # EQ, expander and compressor on/off: the wording is inferred from the
  # Mineola form (see the header). Ahead of the EQ acknowledgement below.
  - match: '\bEQ [Aa]ctive:\s*on\b'
    set: { eq_active: "true" }
  - match: '\bEQ [Aa]ctive:\s*off\b'
    set: { eq_active: "false" }
  - match: '\b[Ee]xp(?:ander)? [Aa]ctive:\s*on\b'
    set: { expander_active: "true" }
  - match: '\b[Ee]xp(?:ander)? [Aa]ctive:\s*off\b'
    set: { expander_active: "false" }
  - match: '\b[Cc]omp(?:ressor)? [Aa]ctive:\s*on\b'
    set: { compressor_active: "true" }
  - match: '\b[Cc]omp(?:ressor)? [Aa]ctive:\s*off\b'
    set: { compressor_active: "false" }

  # The first two lines of the JEF's command list (and, in the Mineola form,
  # its status report): "Help Info TAV-JEF Audio Bridge" and
  # "Web V1.10.04 MCU V2.0.0 DEP V1.3.3.5_20260115".
  - match: '^(?:Help|Status) Info (\S+)'
    set: { model: "$1" }
  - match: '^Web ([Vv]\S+)\s+MCU ([Vv]\S+)\s+DEP ([Vv]\S+)'
    set: { firmware_web: "$1", firmware_mcu: "$2", firmware_dep: "$3" }

  # `get fw version`, in the Mineola form ("Web: V1.00.02").
  - match: '\b(?:Web|WEB):\s*(V\S+)'
    set: { firmware_web: "$1" }
  - match: '\bMCU:\s*(V\S+)'
    set: { firmware_mcu: "$1" }
  - match: '\bDEP:\s*(V\S+)'
    set: { firmware_dep: "$1" }

  # Acknowledgements that carry no value: EQ, expander, compressor, names,
  # presets, reboot.
  - match: '\bEQ\b'
    set: {}
  - match: 'Type:\s*\d+,\s*Frequency:'
    set: {}
  - match: '\b(?:[Ee]xpander|[Cc]ompressor)\b'
    set: {}
  - match: '^Set .* name to '
    set: {}
  - match: '^(?:Save to|Recall|Clear) preset \d+'
    set: {}
  - match: '^(?:Reboot|System Initializing|Initialization Finished)'
    set: {}

  # A line of the command list: a command code, two or more spaces, and its
  # description. A refusal that echoes a command does not have that shape.
  - match: '^(?:\?|(?:help|get|set|status|reboot|reset)\b).*?\s{2,}[A-Z][a-z]'
    set: {}

  # `get type` answers a bare model token on its own line (the JEF's list
  # header names it TAV-JEF). The token must hold a digit or a hyphen, so a
  # bare word such as an error reply is not read as a model. Last.
  - match: '^([A-Z][A-Z0-9]*[0-9-][A-Z0-9-]*)$'
    set: { model: "$1" }

polling:
  queries:
    - query_input_gain
    - query_input_mute
    - query_phantom_power
    - query_sensitivity
    - query_eq_active
    - query_expander_active
    - query_compressor_active

# ── SIMULATOR ──
# Sends the JEF's wire forms and answers in the Mineola reply form, with
# "Input" as the channel name. The command list opens with the two header
# lines the JEF prints; the rest of each answer is inferred (see the header).
simulator:
  initial_state:
    model: "TAV-JEF"
    firmware_web: "V1.10.04"
    firmware_mcu: "V2.0.0"
    firmware_dep: "V1.3.3.5_20260115"
    gain: 0
    mute: false
    phantom_power: false
    sensitivity: "-20dBu"
    eq_active: false
    expander_active: false
    compressor_active: false

  delays:
    command_response: 0.02

  controls:
    - type: slider
      key: gain
      label: Input Gain
      min: -60
      max: 12
      step: 1
    - type: toggle
      key: mute
      label: Input Mute
    - type: toggle
      key: phantom_power
      label: Phantom Power
    - type: select
      key: sensitivity
      label: Input Sensitivity
      options: ["0dBu", "-10dBu", "-20dBu", "-30dBu", "-40dBu"]
    - type: toggle
      key: eq_active
      label: EQ On
    - type: toggle
      key: expander_active
      label: Expander On
    - type: toggle
      key: compressor_active
      label: Compressor On

  command_handlers:
    # ── System ──
    - match: 'get type ?'
      handler: |
        respond(f'{state["model"]}\r\n')

    - match: 'get fw version ?'
      handler: |
        respond(
            f'Web: {state["firmware_web"]}\r\n'
            f'MCU: {state["firmware_mcu"]}\r\n'
            f'DEP: {state["firmware_dep"]}\r\n'
        )

    # The command list: the JEF's two header lines, then a few of its lines.
    - match: '(?:help|\?) ?'
      handler: |
        respond(
            f'Help Info {state["model"]} Audio Bridge\r\n'
            f'Web {state["firmware_web"]} MCU {state["firmware_mcu"]} DEP {state["firmware_dep"]}\r\n'
            'get type                             Get device model\r\n'
            'status                               Get device current status\r\n'
            'get fw version                       Get firmware version\r\n'
            'reboot                               Reboot the device\r\n'
            'set input gain x                     Set input gain to x\r\n'
            'get input gain                       Get input gain value\r\n'
            'set input mute on/off                Set input mute on/off\r\n'
            'get input mute                       Get input mute on/off\r\n'
        )

    - match: 'status ?'
      handler: |
        def _run():
            onoff = lambda key: 'on' if state[key] else 'off'
            respond(
                f'Status Info {state["model"]} Audio Bridge\r\n'
                f'Web {state["firmware_web"]} MCU {state["firmware_mcu"]} DEP {state["firmware_dep"]}\r\n'
                f'Input gain: {state["gain"]}dB\r\n'
                f'Input mute: {onoff("mute")}\r\n'
                f'Input phantom power: {onoff("phantom_power")}\r\n'
                f'Input sensitivity: {state["sensitivity"]}\r\n'
            )
        _run()

    - match: 'reboot ?'
      handler: |
        respond(
            'Reboot...\r\n'
            'System Initializing...\r\n'
            'Initialization Finished!\r\n'
        )

    # ── Input ──
    - match: 'get input gain ?'
      handler: |
        respond(f'Input gain: {state["gain"]}dB\r\n')

    - match: 'set input gain (-?[\d.]+) ?'
      handler: |
        def _run():
            val = round(max(-60.0, min(12.0, float(match.group(1)))), 1)
            if val == int(val):
                val = int(val)
            state['gain'] = val
            respond(f'Input gain: {val}dB\r\n')
        _run()

    # The Mineola document's examples answer a step with the step itself.
    - match: 'set input gain([+-])([\d.]*) ?'
      handler: |
        def _run():
            step = float(match.group(2)) if match.group(2) else 1.0
            if step == int(step):
                step = int(step)
            up = match.group(1) == '+'
            new = state['gain'] + (step if up else -step)
            new = round(max(-60.0, min(12.0, new)), 1)
            if new == int(new):
                new = int(new)
            state['gain'] = new
            word = 'Increase' if up else 'Decrease'
            shown = step if up else -step
            respond(f'{word} input gain: {shown}dB\r\n')
        _run()

    - match: 'get input mute ?'
      handler: |
        respond(f'Input mute: {"on" if state["mute"] else "off"}\r\n')

    - match: 'set input mute (on|off) ?'
      handler: |
        state['mute'] = match.group(1) == 'on'
        respond(f'Input mute: {match.group(1)}\r\n')

    - match: 'get input phantom power ?'
      handler: |
        respond(f'Input phantom power: {"on" if state["phantom_power"] else "off"}\r\n')

    - match: 'set input phantom power (on|off) ?'
      handler: |
        state['phantom_power'] = match.group(1) == 'on'
        respond(f'Input phantom power: {match.group(1)}\r\n')

    - match: 'get input sensitivity ?'
      handler: |
        respond(f'Input sensitivity: {state["sensitivity"]}\r\n')

    # The JEF list: 1:0dBu, 2:-10dBu, 3:-20dBu, 4:-30dBu, 5:-40dBu.
    - match: 'set input sensitivity ([1-5]) ?'
      handler: |
        words = {'1': '0dBu', '2': '-10dBu', '3': '-20dBu', '4': '-30dBu', '5': '-40dBu'}
        state['sensitivity'] = words[match.group(1)]
        respond(f'Input sensitivity: {state["sensitivity"]}\r\n')

    - match: 'set input name (.+?) ?'
      handler: |
        respond(f'Set input channel name to {match.group(1)}\r\n')

    # ── EQ ──
    - match: 'get input eq active ?'
      handler: |
        respond(f'Input EQ active: {"on" if state["eq_active"] else "off"}\r\n')

    - match: 'set input eq active (on|off) ?'
      handler: |
        state['eq_active'] = match.group(1) == 'on'
        respond(f'Input EQ active: {match.group(1)}\r\n')

    - match: 'set input eq (\d) (on|off) ?'
      handler: |
        band = 'all' if match.group(1) == '0' else match.group(1)
        respond(f'Input EQ {band}: {match.group(2)}\r\n')

    - match: 'set input eq (\d) typ (\S+) frq (\S+) val (\S+) q (\S+) ?'
      handler: |
        respond(
            'Input EQ :\r\n'
            f'Type: {match.group(2)}, Frequency: {match.group(3)}Hz, '
            f'Value: {match.group(4)}dB, Q: {match.group(5)}\r\n'
        )

    - match: 'set input eq clear ?'
      handler: |
        respond('Clear input EQ\r\n')

    # ── Expander ──
    - match: 'get input exp active ?'
      handler: |
        respond(f'Input expander active: {"on" if state["expander_active"] else "off"}\r\n')

    - match: 'set input exp active (on|off) ?'
      handler: |
        state['expander_active'] = match.group(1) == 'on'
        respond(f'Input expander active: {match.group(1)}\r\n')

    - match: 'set input exp thr (\S+) r (\S+) ht (\S+) dec (\S+) ?'
      handler: |
        respond(
            f'Input expander threshold: {match.group(1)}dB, ratio: {match.group(2)}, '
            f'hold time: {match.group(3)}ms, decay: {match.group(4)}dB/s\r\n'
        )

    - match: 'set input exp clear ?'
      handler: |
        respond('Clear input expander\r\n')

    # ── Compressor ──
    - match: 'get input comp active ?'
      handler: |
        respond(f'Input compressor active: {"on" if state["compressor_active"] else "off"}\r\n')

    - match: 'set input comp active (on|off) ?'
      handler: |
        state['compressor_active'] = match.group(1) == 'on'
        respond(f'Input compressor active: {match.group(1)}\r\n')

    - match: 'set input comp thr (\S+) r (\S+) att (\S+) re (\S+) ?'
      handler: |
        respond(
            f'Input compressor threshold: {match.group(1)}dB, ratio: {match.group(2)}, '
            f'attack time: {match.group(3)}ms, release time: {match.group(4)}ms\r\n'
        )

    - match: 'set input comp clear ?'
      handler: |
        respond('Clear input compressor\r\n')

    # ── Presets (acknowledged, not modelled) ──
    - match: 'set preset save (\d) ?'
      handler: |
        respond(f'Save to preset {match.group(1)}\r\n')

    - match: 'set preset recall (\d) ?'
      handler: |
        respond(f'Recall preset {match.group(1)}\r\n')

    - match: 'set preset clear (\d) ?'
      handler: |
        respond(f'Clear preset {match.group(1)}\r\n')

    - match: 'set preset (\d) name (.+?) ?'
      handler: |
        respond(f'Set preset {match.group(1)} name to {match.group(2)}\r\n')

  error_modes:
    communication_timeout:
      description: "The JEF stops answering"
      behavior: no_response
