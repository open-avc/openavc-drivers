on_connect:
  - "devstatus runmode\n"
  - "devinfo protocolver\n"
  - "devinfo version\n"
  - "devinfo productname\n"
  - "devinfo serialno\n"
  - "devinfo deviceid\n"
  - "devinfo devicename\n"
  - "sscurrent\n"


commands:

  # ── System / device info ──

  query_runmode:
    label: Query Run Mode
    send: "devstatus runmode\n"
    help: "Query whether the device is in normal, emergency, or update mode."

  query_protocol_version:
    label: Query Protocol Version
    send: "devinfo protocolver\n"

  query_firmware_version:
    label: Query Firmware Version
    send: "devinfo version\n"

  query_product_name:
    label: Query Product Name
    send: "devinfo productname\n"

  query_serial_number:
    label: Query Serial Number
    send: "devinfo serialno\n"

  query_device_id:
    label: Query Unit ID
    send: "devinfo deviceid\n"

  query_device_name:
    label: Query Device Name
    send: "devinfo devicename\n"

  set_normal_mode:
    label: Set Normal Run Mode
    send: "devmode normal\n"
    help: "Exit emergency mode (MTX3 / MTX5-D / MRX7-D only)."

  set_emergency_mode:
    label: Set Emergency Run Mode
    send: "devmode emergency\n"
    help: "Activate the device's emergency-broadcast mode (MTX3 / MTX5-D / MRX7-D only). Invalid on XMV / EXi8 / EXo8."

  heart_beat:
    label: Heart Beat (Keepalive)
    send: "\n"
    help: "Send a bare LF as a heart-beat. Required only when keepalive is enabled on the device (scpmode keepalive)."

  enable_keepalive:
    label: Enable Keepalive
    send: "scpmode keepalive {timeout_ms}\n"
    help: "Enable RCP-level keepalive on the device. The device will drop the connection if no command/heart-beat arrives within the timeout (msec)."
    params:
      timeout_ms:
        type: integer
        required: true
        default: 5000
        min: 1000
        label: Timeout (ms)

  set_value_mode_raw:
    label: Use Raw Values for Notifications
    send: "scpmode valuetype raw\n"

  set_value_mode_normalized:
    label: Use Normalized Values for Notifications
    send: "scpmode valuetype normalized\n"

  # ── Preset / Snapshot ──

  query_current_preset:
    label: Query Current Preset
    send: "sscurrent\n"

  recall_preset:
    label: Recall Preset
    send: "ssrecall {index}\n"
    help: "Recall the preset at the given index (1..50, MTX/MRX only)."
    params:
      index:
        type: integer
        required: true
        min: 1
        max: 50
        label: Preset Index

  query_preset_count:
    label: Query Preset Count
    send: "ssnum\n"

  query_preset_info:
    label: Query Nth Preset Info
    send: "ssinfo {index}\n"
    help: "Get title and attribute of preset at the given index."
    params:
      index:
        type: integer
        required: true
        min: 1
        label: Preset Index

  recall_snapshot:
    label: Recall Snapshot (MRX7-D)
    send: "ssrecall_ex list {index}\n"
    help: "Recall a Snapshot or SnapshotGroup assigned to the given index in the Remote Control Setup List. MRX7-D only."
    params:
      index:
        type: integer
        required: true
        min: 1
        label: Snapshot Index

  # ── Index-based parameter control (MRX7-D Remote Control Setup List) ──

  set_index:
    label: Set Index Value (Raw)
    send: "set MTX:Index_{index} 0 0 {value}\n"
    help: "Set parameter assigned to Index N in the Remote Control Setup List using a raw value. Faders are in 0.01 dB units (e.g. -7760 = -77.60 dB)."
    params:
      index:
        type: integer
        required: true
        min: 1
        max: 32
        label: Index
      value:
        type: integer
        required: true
        label: Raw Value

  set_index_normalized:
    label: Set Index Value (Normalized)
    send: "setn MTX:Index_{index} 0 0 {value}\n"
    help: "Set parameter assigned to Index N using a normalized value (0..1000, default resolution)."
    params:
      index:
        type: integer
        required: true
        min: 1
        max: 32
        label: Index
      value:
        type: integer
        required: true
        min: 0
        max: 1023
        label: Normalized Value

  inc_index:
    label: Increment Index Value (Relative)
    send: "setr MTX:Index_{index} 0 0 {step}\n"
    help: "Adjust the parameter by a relative step (positive or negative). Fader-type parameters only. Range 0..1023; e.g. step=64 yields 16 level steps."
    params:
      index:
        type: integer
        required: true
        min: 1
        max: 32
        label: Index
      step:
        type: integer
        required: true
        label: Step (signed)

  query_index:
    label: Query Index Value (Raw)
    send: "get MTX:Index_{index} 0 0\n"
    params:
      index:
        type: integer
        required: true
        min: 1
        max: 32
        label: Index

  query_index_normalized:
    label: Query Index Value (Normalized)
    send: "getn MTX:Index_{index} 0 0\n"
    params:
      index:
        type: integer
        required: true
        min: 1
        max: 32
        label: Index

  # ── Generic full-address parameter control (MTX3/MTX5-D/XMV/EXi8/EXo8) ──

  set_param:
    label: Set Parameter (Full Address)
    send: "set {address} 0 0 {value}\n"
    help: "Set a parameter using its full address (MTX:mem_MemNo/UniqueId/ElmNo/Xpos/Ypos/PrmNo/IndexNo). Look up in section 7 of the RCP spec."
    params:
      address:
        type: string
        required: true
        label: Parameter Address
        description: "e.g. MTX:mem_512/60000/0/0/0/0/0"
      value:
        type: integer
        required: true
        label: Raw Value

  set_param_normalized:
    label: Set Parameter (Normalized)
    send: "setn {address} 0 0 {value}\n"
    params:
      address:
        type: string
        required: true
        label: Parameter Address
      value:
        type: integer
        required: true
        min: 0
        max: 1023
        label: Normalized Value

  inc_param:
    label: Increment Parameter (Relative)
    send: "setr {address} 0 0 {step}\n"
    params:
      address:
        type: string
        required: true
        label: Parameter Address
      step:
        type: integer
        required: true
        label: Step (signed)

  query_param:
    label: Query Parameter (Raw)
    send: "get {address} 0 0\n"
    params:
      address:
        type: string
        required: true
        label: Parameter Address

  query_param_normalized:
    label: Query Parameter (Normalized)
    send: "getn {address} 0 0\n"
    params:
      address:
        type: string
        required: true
        label: Parameter Address

  # ── Scheduler ──

  enable_scheduler:
    label: Enable Scheduler
    send: "set MTX:EvntScd_On 0 0 1\n"

  disable_scheduler:
    label: Disable Scheduler
    send: "set MTX:EvntScd_On 0 0 0\n"

  query_scheduler_status:
    label: Query Scheduler Status
    send: "get MTX:EvntScd_On 0 0\n"

  # ── Meter control ──

  start_meter:
    label: Start Meter Stream
    send: "mtrstart {address} {interval_ms}\n"
    help: "Begin meter data transmission for the given meter address. Meter pushes auto-stop after 10 seconds; re-issue periodically to keep them flowing."
    params:
      address:
        type: string
        required: true
        label: Meter Address
        description: "e.g. MTX:mtr_512/20020/meter, or MTX:Index_2 (MRX7-D)"
      interval_ms:
        type: integer
        required: true
        default: 1000
        min: 100
        label: Interval (ms)

  stop_meter:
    label: Stop Meter Stream
    send: "mtrstop {address}\n"
    params:
      address:
        type: string
        required: true
        label: Meter Address

  # ── Raw escape hatch ──

  raw_rcp:
    label: Send Raw RCP Command
    send: "{command}\n"
    help: "Send an arbitrary RCP command exactly as written. The trailing LF is added automatically. Useful for parameter addresses or commands not modeled above."
    params:
      command:
        type: string
        required: true
        label: Command


responses:

  # ── Device status notifications ──

  - match: '(?:NOTIFY|OK) devstatus runmode "([^"]*)"'
    set: { device_runmode: "$1" }

  - match: '(?:NOTIFY|OK) devstatus error "([^"]*)"'
    set: { device_error: "$1" }

  - match: '(?:NOTIFY|OK) devstatus fs "([^"]*)"'
    set: { device_fs: "$1" }

  - match: '(?:NOTIFY|OK) devstatus lockstatus "([^"]*)"'
    set: { device_lockstatus: "$1" }

  # ── Device info ──

  - match: 'OK devinfo protocolver "([^"]*)"'
    set: { protocol_version: "$1" }

  - match: 'OK devinfo version "([^"]*)"'
    set: { firmware_version: "$1" }

  - match: 'OK devinfo productname "([^"]*)"'
    set: { product_name: "$1" }

  - match: 'OK devinfo serialno "([^"]*)"'
    set: { serial_number: "$1" }

  - match: 'OK devinfo deviceid "([^"]*)"'
    set: { device_id: "$1" }

  - match: 'OK devinfo devicename "([^"]*)"'
    set: { device_name: "$1" }

  # ── Preset / Snapshot ──

  - match: '(?:NOTIFY|OK) sscurrent (\d+)'
    set: { current_preset: "$1" }

  - match: '(?:NOTIFY|OK) ssrecall (\d+)'
    set: { current_preset: "$1" }

  - match: '(?:NOTIFY|OK) sscurrent_ex list (\d+)'
    set: { current_snapshot: "$1" }

  - match: '(?:NOTIFY|OK) ssrecall_ex list (\d+)'
    set: { current_snapshot: "$1" }

  # ── Scheduler ──
  # Use a regex capture so the value passes through type coercion (boolean).
  - match: '(?:NOTIFY set|OK set|OK get) MTX:EvntScd_On 0 0 (\d+)'
    set: { scheduler_enabled: "$1" }

  # ── Generic raw-address parameter responses (MTX/XMV/EXi8/EXo8) ──
  # Fall-through patterns that record the most recent parameter response so
  # integrators using set_param / query_param can see the value reflected
  # in state. Index_N responses also match these but are overridden by the
  # per-index patterns below.

  - match: 'OK get (MTX:mem_\S+) 0 0 (-?\d+)'
    set: { last_param_address: "$1", last_param_value: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr) (MTX:mem_\S+) 0 0 (-?\d+) "([^"]*)"'
    set: { last_param_address: "$1", last_param_value: "$2", last_param_string: "$3" }

  # ── Index-based parameter responses (MRX7-D) ──

  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_1 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_1: "$1", index_1_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_2 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_2: "$1", index_2_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_3 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_3: "$1", index_3_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_4 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_4: "$1", index_4_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_5 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_5: "$1", index_5_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_6 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_6: "$1", index_6_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_7 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_7: "$1", index_7_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_8 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_8: "$1", index_8_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_9 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_9: "$1", index_9_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_10 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_10: "$1", index_10_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_11 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_11: "$1", index_11_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_12 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_12: "$1", index_12_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_13 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_13: "$1", index_13_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_14 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_14: "$1", index_14_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_15 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_15: "$1", index_15_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_16 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_16: "$1", index_16_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_17 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_17: "$1", index_17_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_18 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_18: "$1", index_18_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_19 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_19: "$1", index_19_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_20 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_20: "$1", index_20_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_21 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_21: "$1", index_21_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_22 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_22: "$1", index_22_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_23 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_23: "$1", index_23_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_24 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_24: "$1", index_24_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_25 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_25: "$1", index_25_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_26 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_26: "$1", index_26_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_27 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_27: "$1", index_27_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_28 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_28: "$1", index_28_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_29 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_29: "$1", index_29_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_30 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_30: "$1", index_30_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_31 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_31: "$1", index_31_string: "$2" }
  - match: '(?:NOTIFY set|OK set|OK setr|OK setn|OKm setn|OKm setr|OK get|OK getn) MTX:Index_32 0 0 (-?\d+)(?: "([^"]*)")?'
    set: { index_32: "$1", index_32_string: "$2" }

polling:
  interval: 30
  queries:
    - "devstatus runmode\n"
    - "devstatus error\n"
    - "devstatus fs\n"
    - "devstatus lockstatus\n"
    - "sscurrent\n"

    - "get MTX:Index_1 0 0\n"
    - "get MTX:Index_2 0 0\n"
    - "get MTX:Index_3 0 0\n"
    - "get MTX:Index_4 0 0\n"
    - "get MTX:Index_5 0 0\n"
    - "get MTX:Index_6 0 0\n"
    - "get MTX:Index_7 0 0\n"
    - "get MTX:Index_8 0 0\n"
    - "get MTX:Index_9 0 0\n"
    - "get MTX:Index_10 0 0\n"
    - "get MTX:Index_11 0 0\n"
    - "get MTX:Index_12 0 0\n"
    - "get MTX:Index_13 0 0\n"
    - "get MTX:Index_14 0 0\n"
    - "get MTX:Index_15 0 0\n"
    - "get MTX:Index_16 0 0\n"
    - "get MTX:Index_17 0 0\n"
    - "get MTX:Index_18 0 0\n"
    - "get MTX:Index_19 0 0\n"
    - "get MTX:Index_20 0 0\n"
    - "get MTX:Index_21 0 0\n"
    - "get MTX:Index_22 0 0\n"
    - "get MTX:Index_23 0 0\n"
    - "get MTX:Index_24 0 0\n"
    - "get MTX:Index_25 0 0\n"
    - "get MTX:Index_26 0 0\n"
    - "get MTX:Index_27 0 0\n"
    - "get MTX:Index_28 0 0\n"
    - "get MTX:Index_29 0 0\n"
    - "get MTX:Index_30 0 0\n"
    - "get MTX:Index_31 0 0\n"
    - "get MTX:Index_32 0 0\n"

# ── SIMULATOR DEFINITION ──

simulator:
  push_state: false  # We push manually via explicit handlers (NOTIFY format).

  initial_state:
    device_runmode: "normal"
    device_error: "none"
    device_fs: "48kHz"
    device_lockstatus: "lock"
    protocol_version: "4.0.0"
    firmware_version: "4.10"
    product_name: "MRX7-D"
    serial_number: "ZA01234567"
    device_id: "001"
    device_name: "MRX7-D"
    current_preset: 1
    current_snapshot: 1
    scheduler_enabled: false
    last_param_address: ""
    last_param_value: ""
    last_param_string: ""

    index_1: 0
    index_1_string: "0.00"
    index_2: 0
    index_2_string: "0.00"
    index_3: 0
    index_3_string: "0.00"
    index_4: 0
    index_4_string: "0.00"
    index_5: 0
    index_5_string: "0.00"
    index_6: 0
    index_6_string: "0.00"
    index_7: 0
    index_7_string: "0.00"
    index_8: 0
    index_8_string: "0.00"
    index_9: 0
    index_9_string: "0.00"
    index_10: 0
    index_10_string: "0.00"
    index_11: 0
    index_11_string: "0.00"
    index_12: 0
    index_12_string: "0.00"
    index_13: 0
    index_13_string: "0.00"
    index_14: 0
    index_14_string: "0.00"
    index_15: 0
    index_15_string: "0.00"
    index_16: 0
    index_16_string: "0.00"
    index_17: 0
    index_17_string: "0.00"
    index_18: 0
    index_18_string: "0.00"
    index_19: 0
    index_19_string: "0.00"
    index_20: 0
    index_20_string: "0.00"
    index_21: 0
    index_21_string: "0.00"
    index_22: 0
    index_22_string: "0.00"
    index_23: 0
    index_23_string: "0.00"
    index_24: 0
    index_24_string: "0.00"
    index_25: 0
    index_25_string: "0.00"
    index_26: 0
    index_26_string: "0.00"
    index_27: 0
    index_27_string: "0.00"
    index_28: 0
    index_28_string: "0.00"
    index_29: 0
    index_29_string: "0.00"
    index_30: 0
    index_30_string: "0.00"
    index_31: 0
    index_31_string: "0.00"
    index_32: 0
    index_32_string: "0.00"

  delays:
    command_response: 0.01

  controls:
    - type: indicator
      key: device_runmode
      label: Run Mode
    - type: indicator
      key: product_name
      label: Product
    - type: indicator
      key: firmware_version
      label: Firmware
    - type: indicator
      key: current_preset
      label: Current Preset
    - type: indicator
      key: current_snapshot
      label: Current Snapshot (MRX7-D)
    - type: slider
      key: index_1
      label: Index 1 (Raw)
      min: -13801
      max: 1000
      step: 1
    - type: slider
      key: index_2
      label: Index 2 (Raw)
      min: -13801
      max: 1000
      step: 1
    - type: slider
      key: index_3
      label: Index 3 (Raw)
      min: -13801
      max: 1000
      step: 1


  command_handlers:

    # devstatus runmode
    - match: '^devstatus runmode$'
      handler: |
        respond(f'OK devstatus runmode "{state["device_runmode"]}"\n')

    # devstatus error
    - match: '^devstatus error$'
      handler: |
        respond(f'OK devstatus error "{state["device_error"]}"\n')

    # devstatus fs
    - match: '^devstatus fs$'
      handler: |
        respond(f'OK devstatus fs "{state["device_fs"]}"\n')

    # devstatus lockstatus
    - match: '^devstatus lockstatus$'
      handler: |
        respond(f'OK devstatus lockstatus "{state["device_lockstatus"]}"\n')

    # devmode normal | emergency
    - match: '^devmode (normal|emergency|update)$'
      handler: |
        mode = match.group(1)
        state["device_runmode"] = mode
        # Real device sends both the OK ack and a NOTIFY push. The simulator's
        # script handler only returns a single response; concatenate them so
        # the driver's line parser sees both events.
        respond(f'OK devmode {mode}\nNOTIFY devstatus runmode "{mode}"\n')

    # devinfo queries
    - match: '^devinfo (protocolver|version|productname|serialno|deviceid|devicename|paramsetver)$'
      handler: |
        key = match.group(1)
        m = {
            "protocolver": ("protocol_version", state["protocol_version"]),
            "version": ("firmware_version", state["firmware_version"]),
            "productname": ("product_name", state["product_name"]),
            "serialno": ("serial_number", state["serial_number"]),
            "deviceid": ("device_id", state["device_id"]),
            "devicename": ("device_name", state["device_name"]),
            "paramsetver": (None, "MTX:1.2.0"),
        }
        _, value = m[key]
        respond(f'OK devinfo {key} "{value}"\n')

    # scpmode (encoding | valuetype | resolution | keepalive)
    - match: '^scpmode (encoding|valuetype|resolution|keepalive) (\S.*)$'
      handler: |
        kind = match.group(1)
        arg = match.group(2)
        respond(f'OK scpmode {kind} {arg}\n')

    # sscurrent (no args) — return current preset
    - match: '^sscurrent$'
      handler: |
        respond(f'OK sscurrent {int(state["current_preset"])} unmodified\n')

    # ssrecall <index> — recall preset, push notification + sscurrent
    - match: '^ssrecall (\d+)$'
      handler: |
        idx = int(match.group(1))
        state["current_preset"] = idx
        respond(f'OK ssrecall {idx}\nNOTIFY sscurrent {idx}\n')

    # ssrecall_ex list <index> — MRX7-D snapshot
    - match: '^ssrecall_ex list (\d+)$'
      handler: |
        idx = int(match.group(1))
        state["current_snapshot"] = idx
        respond(f'OK ssrecall_ex list {idx}\nNOTIFY sscurrent_ex list {idx}\n')

    # ssnum
    - match: '^ssnum$'
      handler: |
        respond('OK ssnum 50\n')

    # ssinfo <index>
    - match: '^ssinfo (\d+)$'
      handler: |
        idx = int(match.group(1))
        respond(f'OK ssinfo {idx} "{idx}" user "Preset {idx}" ""\n')

    # set MTX:Index_N 0 0 <value>
    - match: '^set MTX:Index_(\d+) 0 0 (-?\d+)$'
      handler: |
        idx = int(match.group(1))
        val = int(match.group(2))
        # Clamp fader values to the documented -INFINITY..+10dB range.
        if val < -13801:
            val = -13801
        if val > 1000:
            val = 1000
        key = f"index_{idx}"
        skey = f"index_{idx}_string"
        if key in state:
            state[key] = val
            # Format: -7760 -> "-77.60", 1000 -> "10.00", -13801 -> "-INFINITY"
            if val <= -13801:
                disp = "-INFINITY"
            else:
                disp = f"{val/100:.2f}"
            state[skey] = disp
            respond(f'OK set MTX:Index_{idx} 0 0 {val} "{disp}"\n')
        else:
            respond(f'NOTIFY error "Index_{idx} out of range"\n')

    # setn MTX:Index_N 0 0 <normalized>
    - match: '^setn MTX:Index_(\d+) 0 0 (-?\d+)$'
      handler: |
        idx = int(match.group(1))
        nval = int(match.group(2))
        if nval < 0: nval = 0
        if nval > 1023: nval = 1023
        # Map normalized 0..1000 onto fader range -INFINITY (raw -13801)..+10dB (raw 1000).
        # Spec: 0 -> -INF, 500 -> -inflection, 804 -> 0dB, 1000 -> +10dB.
        # Simplified linear mapping for simulator: 0 -> -13801, 1000 -> 1000.
        raw = int(round(-13801 + (nval / 1000.0) * (1000 - (-13801))))
        key = f"index_{idx}"
        skey = f"index_{idx}_string"
        if key in state:
            state[key] = raw
            if raw <= -13801:
                disp = "-INFINITY"
            else:
                disp = f"{raw/100:.2f}"
            state[skey] = disp
            tag = "OKm" if (nval == 1023) else "OK"
            respond(f'{tag} setn MTX:Index_{idx} 0 0 {nval} "{disp}"\n')
        else:
            respond(f'NOTIFY error "Index_{idx} out of range"\n')

    # setr MTX:Index_N 0 0 <step>
    - match: '^setr MTX:Index_(\d+) 0 0 (-?\d+)$'
      handler: |
        idx = int(match.group(1))
        step = int(match.group(2))
        key = f"index_{idx}"
        skey = f"index_{idx}_string"
        if key in state:
            cur = int(state[key])
            new = cur + step
            clamped = False
            if new < -13801:
                new = -13801
                clamped = True
            if new > 1000:
                new = 1000
                clamped = True
            state[key] = new
            if new <= -13801:
                disp = "-INFINITY"
            else:
                disp = f"{new/100:.2f}"
            state[skey] = disp
            tag = "OKm" if clamped else "OK"
            respond(f'{tag} setr MTX:Index_{idx} 0 0 {new}\n')
        else:
            respond(f'NOTIFY error "Index_{idx} out of range"\n')

    # get MTX:Index_N 0 0
    - match: '^get MTX:Index_(\d+) 0 0$'
      handler: |
        idx = int(match.group(1))
        key = f"index_{idx}"
        if key in state:
            respond(f'OK get MTX:Index_{idx} 0 0 {int(state[key])}\n')
        else:
            respond(f'NOTIFY error "Index_{idx} out of range"\n')

    # getn MTX:Index_N 0 0
    - match: '^getn MTX:Index_(\d+) 0 0$'
      handler: |
        idx = int(match.group(1))
        key = f"index_{idx}"
        if key in state:
            raw = int(state[key])
            # Reverse-map raw -13801..1000 -> normalized 0..1000.
            nval = int(round((raw - (-13801)) / (1000 - (-13801)) * 1000))
            if nval < 0: nval = 0
            if nval > 1000: nval = 1000
            respond(f'OK getn MTX:Index_{idx} 0 0 {nval}\n')
        else:
            respond(f'NOTIFY error "Index_{idx} out of range"\n')

    # set/get for MTX:EvntScd_On (scheduler)
    - match: '^set MTX:EvntScd_On 0 0 (\d+)$'
      handler: |
        v = int(match.group(1))
        state["scheduler_enabled"] = bool(v)
        respond(f'OK set MTX:EvntScd_On 0 0 {v} "{v}"\n')
    - match: '^get MTX:EvntScd_On 0 0$'
      handler: |
        v = 1 if state["scheduler_enabled"] else 0
        respond(f'OK get MTX:EvntScd_On 0 0 {v}\n')

    # Generic raw-address parameter set/get for the MTX/XMV side.
    # The simulator doesn't model the full MTX/XMV parameter space; it just
    # echoes a plausible response. Drivers using set_param / query_param can
    # round-trip and see last_param_* state vars updated.
    - match: '^set (MTX:mem_\S+) 0 0 (-?\d+)$'
      handler: |
        addr = match.group(1)
        val = int(match.group(2))
        respond(f'OK set {addr} 0 0 {val} "{val/100:.2f}"\n')
    - match: '^get (MTX:mem_\S+) 0 0$'
      handler: |
        addr = match.group(1)
        respond(f'OK get {addr} 0 0 0\n')
    - match: '^setn (MTX:mem_\S+) 0 0 (-?\d+)$'
      handler: |
        addr = match.group(1)
        val = int(match.group(2))
        respond(f'OK setn {addr} 0 0 {val} "0.00"\n')
    - match: '^getn (MTX:mem_\S+) 0 0$'
      handler: |
        addr = match.group(1)
        respond(f'OK getn {addr} 0 0 0\n')
    - match: '^setr (MTX:mem_\S+) 0 0 (-?\d+)$'
      handler: |
        addr = match.group(1)
        step = int(match.group(2))
        respond(f'OK setr {addr} 0 0 {step}\n')

    # mtrstart / mtrstop — acknowledge but don't actually push meter values
    # (meter stream isn't useful in the simulator UI).
    - match: '^mtrstart (\S+) (\d+)$'
      handler: |
        addr = match.group(1)
        respond(f'OK mtrstart {addr}\n')
    - match: '^mtrstop (\S+)$'
      handler: |
        addr = match.group(1)
        respond(f'OK mtrstop {addr}\n')

    # event-based commands (time, DST, audio player) — minimal stubs.
    - match: '^event (MTX:[\w\d]+) "([^"]*)"$'
      handler: |
        ev = match.group(1)
        arg = match.group(2)
        respond(f'OK event {ev} "caught"\n')

    # Heart-beat (bare LF after stripping the delimiter is an empty string)
    - match: '^$'
      handler: |
        # No response to heart-beat per spec.
        pass

    # Catch-all — log and don't respond. Real device responds with NG <line>.
    - match: '.+'
      handler: |
        # Optional: emit an NG line for completely unrecognized commands.
        # Real device returns "ERROR Generic Error" or similar. Stay quiet.
        pass

  error_modes:
    communication_timeout:
      behavior: no_response
      description: "Device stops responding (network drop, processor crash, or RCP keepalive timeout)."
    runmode_emergency:
      behavior: custom
      description: "Device in emergency mode — only emergency-related commands accepted."

