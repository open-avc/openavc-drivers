              {
                "required": ["expect"]
              },
              {
                "required": ["expect_regex"]
              },
              {
                "required": ["expect_hex"]
              }
            ]
          }
        }
      ],
      "description": "TCP probe. Connect-only probes may omit send and expect. If it sends bytes, exactly one matcher is required."
    },
