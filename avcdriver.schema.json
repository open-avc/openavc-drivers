    "tcpProbe": {
      "type": "object",
      "required": ["port"],
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "send_hex": {
          "type": "string"
        },
        "send_ascii": {
          "type": "string"
        },
        "expect": {
          "type": "string",
          "minLength": 1
        },
        "expect_regex": {
          "type": "string",
          "minLength": 1
        },
        "expect_hex": {
          "type": "string"
        },
        "cross_vendor": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/extractField"
          }
        },
        "extract_manufacturer": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "required": ["send_hex", "send_ascii"]
