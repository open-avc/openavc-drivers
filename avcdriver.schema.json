            "minimum": 1,
            "maximum": 65535,
            "not": {
              "enum": [22, 80, 443, 8000, 8080, 8443, 8888]
            }
          },
          "description": "Open-port hints. Generic admin/web/SSH ports are disallowed."
        },
        "manufacturer_alias": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Vendor-string aliases matched against discovered banners/TXT records."
        },
        "snmp_pen": {
          "type": "integer",
          "minimum": 1,
          "description": "SNMP private enterprise number."
        }
      },
      "description": "Discovery fingerprints and hints. Unknown keys are rejected by the platform and the catalog validator."
    },
