# LG SICP (Serial Interface Communication Protocol) Driver
#
# Controls LG commercial displays over TCP (port 9761) or RS-232 (9600 8N1).
# Covers webOS Signage displays, LED, and OLED commercial series.
#
# Protocol reference: LG Commercial Display RS-232C/IP Control Manual
#
# Command format: <cmd1><cmd2> <set_id> <data><CR>
#   cmd1+cmd2: two-character command code
#   set_id: display ID (01-99, or 00 for all)
#   data: command parameter (two hex digits)
#
# Response format: <cmd2> <set_id> OK<data>x  or  <cmd2> <set_id> NG<data>x
#   x = end delimiter
#
# Note: set_id is typically "01" for single-display control.

id: lg_sicp
name: LG SICP Display
manufacturer: LG
category: display
version: 1.5.0
author: OpenAVC
description: >
  Controls LG commercial displays via SICP over TCP (port 9761).
  Supports power, input, volume, mute, and screen mute.
  Covers webOS Signage, LED, and OLED commercial series.

source_url: https://aca.im/driver_docs/LG/SM_models.pdf
tags: [display, signage, sicp]
verified: false
simulated: true
ports: [9761]
compatible_models:
  - manufacturer: LG
    models:
      - webOS Signage displays
      - LED Commercial series
      - OLED Commercial series
    confidence: untested

transport: tcp
delimiter: "x"

help:
  overview: >
    Controls LG commercial displays via the SICP protocol. Supports power,
    input selection, volume, mute, and screen mute. Covers webOS Signage,
    LED, and OLED commercial series.
  setup: >
    1. Connect the LG display to the network.
    2. Default control port is 9761.
    3. Set the Display ID (01-99, or 00 for broadcast to all displays).

discovery:
  # LG SICP has no announcement (vs. webOS, which advertises via SSDP
  # for Smart TVs — that's a different driver, not commercial signage).
  # Hint-only via the comprehensive LG OUI list + open SICP port +
  # manufacturer alias. The OUI list is broad and intentionally
  # surfaces as a `possible (candidate: lg_sicp)` rather than a
  # confident match.
  oui:
    - "00:05:c9"
    - "00:e0:91"
    - "10:68:3f"
    - "2c:54:cf"
    - "34:4d:f7"
    - "38:8c:50"
    - "58:a2:b5"
    - "64:99:5d"
    - "a8:23:fe"
    - "bc:f1:71"
  port_open:
    - 9761
  manufacturer_alias:
    - "lg"
    - "lg electronics"

default_config:
  host: ""
  port: 9761
  set_id: "01"
  poll_interval: 15

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 9761
    label: Port
  set_id:
    type: string
    default: "01"
    label: Display ID
    description: "01-99, or 00 for broadcast to all displays"
  poll_interval:
    type: integer
    default: 15
    min: 0
    label: Poll Interval (sec)

state_variables:
  power:
    type: enum
    values: ["off", "on"]
    label: Power State
    help: "Display power state — 'on' when the panel is powered, 'off' in standby."
  input:
    type: string
    label: Input Source
    help: "Active input source reported by the display (HDMI 1, HDMI 2, DisplayPort, etc.)."
  volume:
    type: integer
    label: Volume
    help: "Audio volume on a 0–100 scale."
  mute:
    type: boolean
    label: Audio Mute
    help: "True when the audio output is muted."
  screen_mute:
    type: boolean
    label: Screen Mute
    help: "True when the screen image is blanked (backlight on, content hidden)."

commands:
  power_on:
    label: Power On
    send: "ka {set_id} 01\r"
    help: "Turn on the display."

  power_off:
    label: Power Off
    send: "ka {set_id} 00\r"
    help: "Turn off the display (standby)."

  set_input_hdmi1:
    label: Input HDMI 1
    send: "xb {set_id} 90\r"
    help: "Switch to HDMI 1 input."

  set_input_hdmi2:
    label: Input HDMI 2
    send: "xb {set_id} 91\r"
    help: "Switch to HDMI 2 input."

  set_input_hdmi3:
    label: Input HDMI 3
    send: "xb {set_id} 92\r"
    help: "Switch to HDMI 3 input."

  set_input_dp:
    label: Input DisplayPort
    send: "xb {set_id} D0\r"
    help: "Switch to DisplayPort input."

  set_input_dvi:
    label: Input DVI
    send: "xb {set_id} 80\r"
    help: "Switch to DVI input."

  set_input_url:
    label: Input URL Launcher
    send: "xb {set_id} E0\r"
    help: "Switch to URL Launcher (webOS app)."

  set_volume:
    label: Set Volume
    send: "kf {set_id} {level:02x}\r"
    help: "Set the display speaker volume."
    params:
      level:
        type: integer
        required: true
        label: Volume (0-100)
        min: 0
        max: 100
        help: "Volume level 0-100"

  mute_on:
    label: Mute On
    send: "ke {set_id} 00\r"
    help: "Mute the display audio."

  mute_off:
    label: Mute Off
    send: "ke {set_id} 01\r"
    help: "Unmute the display audio."

  screen_mute_on:
    label: Screen Mute On (blank screen)
    send: "kd {set_id} 01\r"
    help: "Blank the screen (display stays on, useful for presentations)."

  screen_mute_off:
    label: Screen Mute Off
    send: "kd {set_id} 00\r"
    help: "Restore the screen from blank."

# Quick actions — promote power, the two most-used HDMI inputs, audio mute,
# and screen blank (a common presentation control on signage) to the card.
actions:
  - id: power_on
    icon: power
  - id: power_off
    icon: power-off
  - id: set_input_hdmi1
    icon: monitor
  - id: set_input_hdmi2
    icon: monitor
  - id: mute_on
    icon: volume-x
  - id: mute_off
    icon: volume-2
  - id: screen_mute_on
    icon: eye-off
  - id: screen_mute_off
    icon: eye

responses:
  # Power query response: "a 01 OK01" (on) or "a 01 OK00" (off)
  - match: 'a \d+ OK01'
    set: { power: "on" }
  - match: 'a \d+ OK00'
    set: { power: "off" }

  # Volume response: "f 01 OK32" (volume = 0x32 = 50)
  # KNOWN LIMITATION: Real LG hardware returns hex volume values (e.g. "32"
  # for volume 50), but YAML drivers cannot hex-decode. The stored value will
  # be the raw hex string. The simulator compensates by responding in decimal.
  # For accurate volume with real hardware, use a Python driver instead.
  - match: 'f \d+ OK(\w{2})'
    set: { volume: "$1" }

  # Mute response: "e 01 OK00" (muted) "e 01 OK01" (unmuted)
  - match: 'e \d+ OK00'
    set: { mute: true }
  - match: 'e \d+ OK01'
    set: { mute: false }

  # Screen mute response: "d 01 OK01" (on/blanked) "d 01 OK00" (off/visible)
  - match: 'd \d+ OK01'
    set: { screen_mute: true }
  - match: 'd \d+ OK00'
    set: { screen_mute: false }

  # Input query response: "b 01 OK90" (HDMI 1)
  - match: 'b \d+ OK90'
    set: { input: "HDMI 1" }
  - match: 'b \d+ OK91'
    set: { input: "HDMI 2" }
  - match: 'b \d+ OK92'
    set: { input: "HDMI 3" }
  - match: 'b \d+ OKD0'
    set: { input: "DisplayPort" }
  - match: 'b \d+ OK80'
    set: { input: "DVI" }
  - match: 'b \d+ OKE0'
    set: { input: "URL Launcher" }

polling:
  queries:
    - "ka {set_id} FF\r"
    - "kf {set_id} FF\r"
    - "ke {set_id} FF\r"
    - "kd {set_id} FF\r"
    - "xb {set_id} FF\r"

# ── SIMULATOR DEFINITION ──

simulator:
  initial_state:
    power: "off"
    input: "HDMI 1"
    volume: 32
    mute: false
    screen_mute: false

  delays:
    command_response: 0.025

  controls:
    - type: power
      key: power
    - type: select
      key: input
      label: Input
      options: ["HDMI 1", "HDMI 2", "HDMI 3", "DisplayPort", "DVI", "URL Launcher"]
    - type: slider
      key: volume
      label: Volume
      min: 0
      max: 100
    - type: toggle
      key: mute
      label: Audio Mute
    - type: toggle
      key: screen_mute
      label: Screen Mute

  command_handlers:
    # Power query (ka XX FF) — respond with current power state
    - match: 'ka (\d+) FF'
      handler: |
        sid = match.group(1)
        val = "01" if state["power"] == "on" else "00"
        respond(f"a {sid} OK{val}x")

    # Power on (ka XX 01)
    - match: 'ka (\d+) 01'
      handler: |
        sid = match.group(1)
        state["power"] = "on"
        respond(f"a {sid} OK01x")

    # Power off (ka XX 00)
    - match: 'ka (\d+) 00'
      handler: |
        sid = match.group(1)
        state["power"] = "off"
        respond(f"a {sid} OK00x")

    # Volume query (kf XX FF) — respond with current volume as 2-digit decimal
    # Note: Real LG uses hex, but the YAML driver's response parser can't
    # convert hex→decimal, so the simulator uses decimal for consistency.
    - match: 'kf (\d+) FF'
      handler: |
        sid = match.group(1)
        vol_str = format(state["volume"], "02d")
        respond(f"f {sid} OK{vol_str}x")

    # Set volume (kf XX <hex>) — accept hex from driver, store as decimal
    - match: 'kf (\d+) ([0-9a-fA-F]{2})'
      handler: |
        sid = match.group(1)
        vol = int(match.group(2), 16)
        vol = max(0, min(100, vol))
        state["volume"] = vol
        vol_str = format(vol, "02d")
        respond(f"f {sid} OK{vol_str}x")

    # Mute query (ke XX FF) — respond with mute state
    - match: 'ke (\d+) FF'
      handler: |
        sid = match.group(1)
        val = "00" if state["mute"] else "01"
        respond(f"e {sid} OK{val}x")

    # Mute on (ke XX 00)
    - match: 'ke (\d+) 00'
      handler: |
        sid = match.group(1)
        state["mute"] = True
        respond(f"e {sid} OK00x")

    # Mute off (ke XX 01)
    - match: 'ke (\d+) 01'
      handler: |
        sid = match.group(1)
        state["mute"] = False
        respond(f"e {sid} OK01x")

    # Input select (xb XX <code>) — common input codes
    - match: 'xb (\d+) ([0-9a-fA-F]{2})'
      handler: |
        sid = match.group(1)
        code = match.group(2).upper()
        input_map = {
            "90": "HDMI 1", "91": "HDMI 2", "92": "HDMI 3",
            "D0": "DisplayPort", "80": "DVI", "E0": "URL Launcher"
        }
        state["input"] = input_map.get(code, f"Input 0x{code}")
        respond(f"b {sid} OK{code}x")

    # Screen mute query (kd XX FF)
    - match: 'kd (\d+) FF'
      handler: |
        sid = match.group(1)
        val = "01" if state["screen_mute"] else "00"
        respond(f"d {sid} OK{val}x")

    # Screen mute on (kd XX 01)
    - match: 'kd (\d+) 01'
      handler: |
        sid = match.group(1)
        state["screen_mute"] = True
        respond(f"d {sid} OK01x")

    # Screen mute off (kd XX 00)
    - match: 'kd (\d+) 00'
      handler: |
        sid = match.group(1)
        state["screen_mute"] = False
        respond(f"d {sid} OK00x")

    # Input query (xb XX FF) — respond with current input code
    - match: 'xb (\d+) FF'
      handler: |
        sid = match.group(1)
        reverse_map = {
            "HDMI 1": "90", "HDMI 2": "91", "HDMI 3": "92",
            "DisplayPort": "D0", "DVI": "80", "URL Launcher": "E0"
        }
        code = reverse_map.get(state["input"], "90")
        respond(f"b {sid} OK{code}x")

  error_modes:
    communication_timeout:
      behavior: no_response
      description: "Display stops responding to all commands (network issue or display in deep standby)"
    no_signal:
      behavior: custom_state
      state:
        input: "HDMI 1"
      description: "No signal detected on current input (source unplugged or powered off)"
