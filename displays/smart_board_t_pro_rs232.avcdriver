# yaml-language-server: $schema=https://raw.githubusercontent.com/open-avc/openavc-drivers/main/avcdriver.schema.json
#
# SMART Board T Pro interactive displays (RS-232 room control)
# Reference: SMART's "Managing the display using RS-232" page for the T Pro on
#            support.smarttech.com, and Appendix B of the SMART Board T Pro
#            series installation and maintenance guide (docs.smarttech.com/kb/
#            172043, 16 December 2025), which prints the same tables.
# Protocol: ASCII over RS-232, 19200 8N1, no login. A command is
#           "get <setting>" or "set <setting>=<value>" (or +N / -N for a
#           level) ended with CR. Commands are not case-sensitive and extra
#           spacing is ignored. Every reply line is "<setting>=<value>"
#           wrapped in CR LF, followed by the ">" prompt with no line ending,
#           so the prompt reaches the driver as a line of its own in front of
#           the next reply. A word the display does not take is answered
#           "invalid cmd: <the command>".
# Push: the display sends "#<setting>=<value>" (no prompt after it) when its
#       front control panel, Settings app or remote changes power, input,
#       brightness, freeze, screen shade, volume or mute, and when its power
#       state changes. The microphone array is not announced, so the poll
#       reads it. "statereporting" is listed under Room commands with no
#       description; the driver turns it on at connect as the switch for
#       these messages. Hybrid: the messages, plus a 15-second poll.
# Power: on / ready / powersave. The page does not say any command wakes the
#        display (the RX and MX (V5) pages do). It lists the ways out of READY
#        (the Power button, "set powerstate=on", a video signal) and out of
#        POWERSAVE (the Power button or a video signal), and a get is not one
#        of them, so the poll and the start-up reads run in every power state,
#        with no state gate, and the liveness probe below runs on every
#        platform release. "You must wait 20 seconds after issuing a set
#        powerstate=powersave command until the display responds again." The
#        set column also lists =standby, but no state by that name is
#        described or reported, so it is not offered.
# Families: the RX and MX are smart_board_rx_mx, the GX Zero and NX
#           smart_board_gx_nx, and the T Pro's network control (TCP 4664, a
#           different protocol with more settings and no change messages)
#           smart_board_t_pro. This driver is the T Pro's RS-232 port: inputs
#           hdmi1-3 / ops1 / usbc1 / usbc2, volume 0 to 30, the microphone
#           array as micarray.
#
# Why YAML: plain text get / set lines, one reply line per command, and the
# display's own change messages in the same form on the same line, which
# ConfigurableDriver reads with one rule per setting.
#
# Not verified on hardware (no SMART Board on the bench). Unverified from the
# documents alone: that a get leaves a display in READY or POWERSAVE as it is,
# what the display answers to "set powerstate=on" in POWERSAVE, whether
# "statereporting" is what turns the change messages on, and how long the
# display needs between commands (SMART asks only that each reply and prompt
# arrive before the next command).

id: smart_board_t_pro_rs232
name: SMART Board T Pro (RS-232)
manufacturer: SMART Technologies
category: display
version: 1.0.0
author: OpenAVC
description: >-
  SMART Board T Pro interactive displays over RS-232: power, input, volume and
  mute, brightness, freeze, screen shade and the microphone array, with the
  display's own reports of changes made at the display.
source_url: https://support.smarttech.com/docs/hardware/displays/smart-board-tpro/en/managing-using-rs-232/default.cshtml
tags: [display, smart, smart-board, interactive-display, interactive-flat-panel, education, rs232]
verified: false
simulated: true
ports: []
min_platform_version: "0.36.0"
compatible_models:
  - manufacturer: SMART Technologies
    models: [SBID-T065-P, SBID-T075-P, SBID-T086-P]
    confidence: untested
    notes: >-
      SMART Board T Pro, over its RS-232 port. For control over the network instead, use the SMART Board T Pro
      driver.
protocols: [smart_board_rs232]
transport: serial
delimiter: "\r\n"

help:
  overview: >-
    SMART Board T Pro interactive displays over the RS-232 port: power, input,
    volume, mute, brightness, freeze, screen shade and the microphone array.
    Changes made with the display's buttons, Settings app or remote reach
    OpenAVC as soon as they happen; everything is also read every 15 seconds,
    with the screen on or off.
  setup: >-
    1. Connect the display's RS-232 port with a standard (straight-through)
       RS-232 cable, not a null-modem cable, to a serial port on this computer
       or to a serial bridge (choose "Through a bridge" and pick the bridge's
       port).
    2. The settings are 19200 baud, 8 data bits, no parity, 1 stop bit. Through
       a bridge they are applied to the bridge's port for you.
    3. No login.
  connection: >-
    The display is read in every power state: Power Off (Ready) and Power Save
    turn the screen off, and OpenAVC reading it does not turn it back on. After
    Power Save the display does not answer for about 20 seconds. If it stops
    answering for about a minute it shows offline, and comes back as soon as
    it answers again.

default_config:
  baudrate: 19200
  bytesize: 8
  parity: "N"
  stopbits: 1
  poll_interval: 15
  inter_command_delay: 0.25

config_schema:
  baudrate:
    type: integer
    default: 19200
    label: Baud Rate
    description: 19200 on the T Pro.
  poll_interval:
    type: integer
    default: 15
    min: 0
    label: Poll Interval (sec)
    description: How often to read the display's settings. 0 turns polling off; changes made at the display still arrive.
  inter_command_delay:
    type: number
    default: 0.25
    min: 0
    label: Inter-Command Delay (sec)
    description: Gap between commands. SMART asks for each reply before the next command is sent; raise this if the display misses commands.

state_variables:
  power:
    type: enum
    values: ["on", ready, powersave]
    label: Power
    control: true
    help: "on = picture up. ready = screen off, and Power On, a video signal or the Power button turns it on. powersave = the lowest-power state, which only the Power button, the remote or a video signal ends."
  input:
    type: enum
    values: [hdmi1, hdmi2, hdmi3, ops1, usbc1, usbc2]
    label: Input
    control: true
    help: "The active input: hdmi1 to hdmi3, ops1 (the slot-in PC), usbc1 or usbc2."
  volume:
    type: integer
    label: Volume
    min: 0
    max: 30
    step: 1
    control: true
  mute:
    type: boolean
    label: Mute
    control: true
    help: The speakers are muted.
  brightness:
    type: integer
    label: Brightness
    min: 0
    max: 100
    step: 1
  video_freeze:
    type: boolean
    label: Freeze
    control: true
    help: The picture is frozen.
  screen_shade:
    type: boolean
    label: Screen Shade
    control: true
    help: The screen shade is covering the picture.
  mic_array:
    type: boolean
    label: Microphone Array
    control: true
    help: The display's microphone array is on. Read by the poll only; the display does not report it when it changes.
  state_reporting:
    type: boolean
    label: State Reporting
    help: The display's State Reporting setting, which OpenAVC turns on when it connects.
  model:
    type: string
    label: Model
  serial_number:
    type: string
    label: Serial Number
  firmware:
    type: string
    label: Firmware
  part_number:
    type: string
    label: Part Number
  last_error:
    type: string
    label: Last Error
    help: "The display's own words for the last command it did not take, such as \"invalid cmd: setvolume=31\"."

commands:
  # Power. Every reply carries the new state, so no read-back get follows.
  power_on:
    label: Power On
    help: Turns the display on from Power Off (Ready). In Power Save it does not take it; only its Power button, the remote or a video signal wakes it.
    send: "set powerstate=on\r"
    sets: { power: "on" }
  power_off:
    label: Power Off (Ready)
    help: Turns the screen off and leaves the display ready to come on with Power On, a video signal or its Power button.
    send: "set powerstate=ready\r"
    sets: { power: ready }
  power_save:
    label: Power Save
    help: Puts the display in its lowest-power state. It does not answer for about 20 seconds afterwards, and only its Power button, the remote or a video signal brings it back.
    send: "set powerstate=powersave\r"
    sets: { power: powersave }
    confirm: OpenAVC cannot turn the display back on from Power Save; only its Power button, the remote or a video signal wakes it.

  set_input:
    label: Select Input
    help: Selects an input.
    send: "set input={input}\r"
    sets: { input: "{input}" }
    params:
      input:
        type: enum
        required: true
        label: Input
        values:
          - { value: hdmi1, label: "HDMI 1" }
          - { value: hdmi2, label: "HDMI 2" }
          - { value: hdmi3, label: "HDMI 3" }
          - { value: ops1, label: "Slot-in PC (OPS)" }
          - { value: usbc1, label: "USB-C 1" }
          - { value: usbc2, label: "USB-C 2" }

  set_volume:
    label: Set Volume
    help: Sets the speaker volume, 0 to 30.
    send: "set volume={level}\r"
    sets: { volume: "{level}" }
    params:
      level:
        type: integer
        required: true
        label: Volume
        min: 0
        max: 30
  volume_up:
    label: Volume Up
    help: Raises the volume by the step given.
    send: "set volume+{step}\r"
    params:
      step:
        type: integer
        required: true
        label: Step
        default: 1
        min: 1
        max: 30
  volume_down:
    label: Volume Down
    help: Lowers the volume by the step given.
    send: "set volume-{step}\r"
    params:
      step:
        type: integer
        required: true
        label: Step
        default: 1
        min: 1
        max: 30
  mute_on:
    label: Mute On
    help: Mutes the speakers.
    send: "set mute=on\r"
    sets: { mute: true }
  mute_off:
    label: Mute Off
    help: Unmutes the speakers.
    send: "set mute=off\r"
    sets: { mute: false }

  set_brightness:
    label: Set Brightness
    help: Sets the screen brightness.
    send: "set brightness={level}\r"
    sets: { brightness: "{level}" }
    params:
      level:
        type: integer
        required: true
        label: Brightness
        min: 0
        max: 100
  brightness_up:
    label: Brightness Up
    help: Raises the brightness by the step given.
    send: "set brightness+{step}\r"
    params:
      step:
        type: integer
        required: true
        label: Step
        default: 5
        min: 1
        max: 100
  brightness_down:
    label: Brightness Down
    help: Lowers the brightness by the step given.
    send: "set brightness-{step}\r"
    params:
      step:
        type: integer
        required: true
        label: Step
        default: 5
        min: 1
        max: 100

  freeze_on:
    label: Freeze On
    help: Freezes the picture on screen.
    send: "set videofreeze=on\r"
    sets: { video_freeze: true }
  freeze_off:
    label: Freeze Off
    help: Unfreezes the picture.
    send: "set videofreeze=off\r"
    sets: { video_freeze: false }
  screen_shade_on:
    label: Screen Shade On
    help: Covers the picture with the screen shade.
    send: "set screenshade=on\r"
    sets: { screen_shade: true }
  screen_shade_off:
    label: Screen Shade Off
    help: Removes the screen shade.
    send: "set screenshade=off\r"
    sets: { screen_shade: false }
  mic_array_on:
    label: Microphone Array On
    help: Turns the display's microphone array on.
    send: "set micarray=on\r"
    sets: { mic_array: true }
  mic_array_off:
    label: Microphone Array Off
    help: Turns the display's microphone array off.
    send: "set micarray=off\r"
    sets: { mic_array: false }

  factory_reset:
    label: Factory Reset
    help: Resets the display to its factory settings. The display takes the command only with its own serial number, which the device page shows under Serial Number.
    send: "set factoryreset={serial_number}\r"
    confirm: Erases every setting on the display and returns it to its factory state.
    params:
      serial_number:
        type: string
        required: true
        label: Serial Number
        help: The display's serial number, exactly as the device page shows it.

device_settings:
  brightness:
    type: integer
    label: Brightness
    help: Screen brightness, 0 to 100.
    state_key: brightness
    default: 100
    setup: false
    min: 0
    max: 100
    write:
      send: "set brightness={value}\r"

quick_actions: [power_on, power_off, mute_on, mute_off]

# Every reply may follow the ">" prompt and a change message starts with
# "#", so each rule allows both in front. First match wins.
responses:
  # The prompt on a line of its own: it carries nothing to read.
  - match: '^>\s*$'
    set: {}
  - match: '(?i:^>?\s*#?\s*powerstate\s*=\s*([a-z]+)\s*$)'
    set: { power: "$1" }
  - match: '(?i:^>?\s*#?\s*input\s*=\s*([a-z0-9]+)\s*$)'
    set: { input: "$1" }
  - match: '(?i:^>?\s*#?\s*volume\s*=\s*(\d+)\s*$)'
    set: { volume: "$1" }
  - match: '(?i:^>?\s*#?\s*mute\s*=\s*(on|off)\s*$)'
    mappings:
      - { group: 1, state: mute, map: { "on": true, "off": false, "ON": true, "OFF": false } }
  - match: '(?i:^>?\s*#?\s*brightness\s*=\s*(\d+)\s*$)'
    set: { brightness: "$1" }
  - match: '(?i:^>?\s*#?\s*videofreeze\s*=\s*(on|off)\s*$)'
    mappings:
      - { group: 1, state: video_freeze, map: { "on": true, "off": false, "ON": true, "OFF": false } }
  - match: '(?i:^>?\s*#?\s*screenshade\s*=\s*(on|off)\s*$)'
    mappings:
      - { group: 1, state: screen_shade, map: { "on": true, "off": false, "ON": true, "OFF": false } }
  - match: '(?i:^>?\s*#?\s*micarray\s*=\s*(on|off)\s*$)'
    mappings:
      - { group: 1, state: mic_array, map: { "on": true, "off": false, "ON": true, "OFF": false } }
  - match: '(?i:^>?\s*#?\s*statereporting\s*=\s*(on|off)\s*$)'
    mappings:
      - { group: 1, state: state_reporting, map: { "on": true, "off": false, "ON": true, "OFF": false } }
  - match: '(?i:^>?\s*modelnum\s*=\s*(\S.*?)\s*$)'
    set: { model: "$1" }
  - match: '(?i:^>?\s*serialnum\s*=\s*(\S.*?)\s*$)'
    set: { serial_number: "$1" }
  - match: '(?i:^>?\s*fwversion\s*=\s*(\S.*?)\s*$)'
    set: { firmware: "$1" }
  - match: '(?i:^>?\s*partnum\s*=\s*(\S.*?)\s*$)'
    set: { part_number: "$1" }
  # Factory Reset's answer repeats the serial number; nothing to keep.
  - match: '(?i:^>?\s*factoryreset\s*=.*$)'
    set: {}
  - match: '(?i:^>?\s*(invalid cmd\b.*?)\s*$)'
    set: { last_error: "$1" }

# The CR first is SMART's own way to bring up a fresh prompt; it also ends any
# half-typed line left in the display's input. No step waits on the power
# state: nothing on the page says a get wakes the display.
on_connect:
  - "\r"
  - "set statereporting=on\r"
  - { send: "get modelnum\r", query_for: model }
  - { send: "get serialnum\r", query_for: serial_number }
  - { send: "get fwversion\r", query_for: firmware }
  - { send: "get partnum\r", query_for: part_number }

polling:
  queries:
    - { send: "get powerstate\r", query_for: power }
    - { send: "get input\r", query_for: input }
    - { send: "get volume\r", query_for: volume }
    - { send: "get mute\r", query_for: mute }
    - { send: "get brightness\r", query_for: brightness }
    - { send: "get videofreeze\r", query_for: video_freeze }
    - { send: "get screenshade\r", query_for: screen_shade }
    - { send: "get micarray\r", query_for: mic_array }

# Over a direct serial line nothing else notices a display that stops
# answering. Any reply counts, an invalid cmd included. Two misses 30 seconds
# apart ride out the 20 seconds the display is silent after Power Save. Safe
# in every power state for the reason above the poll; the poll has no state
# gate for it to wait on.
liveness:
  send: "get powerstate\r"
  interval: 30
  timeout: 5
  max_failures: 2

# ── Simulator ──
# Models a T Pro: every reply wrapped in CR LF and followed by the ">" prompt,
# invalid cmd for a word it does not take, and every command answered in every
# power state. Only "set powerstate=on" from READY changes the power state
# back; in POWERSAVE a power set is answered with the state unchanged (the
# page lists only the Power button and a video signal as ways out, and does
# not say what the display answers). Changes made in the Simulator UI arrive
# as "#" messages like the display's own buttons. Gaps: a bare CR is not
# answered (the simulator drops empty lines), the 20 seconds of silence after
# Power Save are not modelled, "standby" is not modelled (the driver does not
# send it), and a change made by a command is announced as well as answered,
# which the documents describe only for the display's own buttons.
simulator:
  # The display answers inside the gap the driver leaves between commands
  # (SMART asks for each reply before the next command). Left unset, the
  # simulator would answer at the very end of that gap.
  delays:
    command_response: 0.05
  initial_state:
    power: "on"
    input: hdmi1
    volume: 12
    mute: false
    brightness: 80
    video_freeze: false
    screen_shade: false
    mic_array: true
    state_reporting: false
    model: SBID-T075-P
    serial_number: T75SIM0001
    firmware: SMART_1.2.3.4
    part_number: 1032590-A
  controls:
    - type: select
      key: power
      label: Power
      options: ["on", ready, powersave]
    - type: select
      key: input
      label: Input
      options: [hdmi1, hdmi2, hdmi3, ops1, usbc1, usbc2]
    - type: slider
      key: volume
      label: Volume
      min: 0
      max: 30
    - type: toggle
      key: mute
      label: Mute
    - type: slider
      key: brightness
      label: Brightness
      min: 0
      max: 100
    - type: toggle
      key: video_freeze
      label: Freeze
    - type: toggle
      key: screen_shade
      label: Screen Shade
    - type: toggle
      key: mic_array
      label: Microphone Array
  # The display's change messages. The microphone array and State Reporting
  # are not announced by the display, so they have none.
  notifications:
    power:
      "*": "\r\n#powerstate={value}"
    input:
      "*": "\r\n#input={value}"
    volume:
      "*": "\r\n#volume={value}"
    brightness:
      "*": "\r\n#brightness={value}"
    mute:
      "true": "\r\n#mute=on"
      "false": "\r\n#mute=off"
    video_freeze:
      "true": "\r\n#videofreeze=on"
      "false": "\r\n#videofreeze=off"
    screen_shade:
      "true": "\r\n#screenshade=on"
      "false": "\r\n#screenshade=off"
  command_handlers:
    # One dispatcher for the whole grammar, so the power words and the
    # 0 to 30 volume are judged in one place.
    - match: '(?i:\s*(get|set)\s*[a-z]+.*)'
      handler: |
        def _run():
            text = match.group(0)
            squeezed = re.sub(r"\s+", "", text).lower()
            m = re.match(r"^(get|set)([a-z]+?)(?:([=+-])(.*))?$", squeezed)

            def say(body):
                respond("\r\n" + body + "\r\n>")

            def word(flag):
                return "on" if flag else "off"

            INPUTS = ("hdmi1", "hdmi2", "hdmi3", "ops1", "usbc1", "usbc2")
            BOOLS = {"mute": "mute", "videofreeze": "video_freeze",
                     "screenshade": "screen_shade", "micarray": "mic_array",
                     "statereporting": "state_reporting"}
            LEVELS = {"volume": ("volume", 30), "brightness": ("brightness", 100)}
            READS = {"modelnum": "model", "serialnum": "serial_number",
                     "fwversion": "firmware", "partnum": "part_number"}

            if not m:
                say("invalid cmd: " + squeezed)
                return
            verb, name, op, value = m.group(1), m.group(2), m.group(3), m.group(4) or ""

            if verb == "get":
                if op:
                    say("invalid cmd: " + squeezed)
                elif name == "powerstate":
                    say("powerstate=" + str(state["power"]))
                elif name == "input":
                    say("input=" + str(state["input"]))
                elif name in LEVELS:
                    say(name + "=" + str(int(state[LEVELS[name][0]])))
                elif name in BOOLS:
                    say(name + "=" + word(state[BOOLS[name]]))
                elif name in READS:
                    say(name + "=" + str(state[READS[name]]))
                else:
                    say("invalid cmd: " + squeezed)
                return

            # set
            if name == "powerstate" and op == "=" and value in ("on", "ready", "powersave"):
                if str(state["power"]) != "powersave":
                    state["power"] = value
                say("powerstate=" + str(state["power"]))
            elif name == "input" and op == "=" and value in INPUTS:
                state["input"] = value
                say("input=" + value)
            elif name in LEVELS and op == "=" and value.isdigit() and int(value) <= LEVELS[name][1]:
                state[LEVELS[name][0]] = int(value)
                say(name + "=" + value)
            elif name in LEVELS and op in ("+", "-") and value.isdigit():
                key, top = LEVELS[name]
                step = int(value) if op == "+" else -int(value)
                level = max(0, min(top, int(state[key]) + step))
                state[key] = level
                say(name + "=" + str(level))
            elif name in BOOLS and op == "=" and value in ("on", "off"):
                state[BOOLS[name]] = (value == "on")
                say(name + "=" + value)
            elif name == "factoryreset" and op == "=" and value == str(state["serial_number"]).lower():
                say("factoryreset=" + str(state["serial_number"]))
            else:
                say("invalid cmd: " + squeezed)
        _run()
    # Anything outside the grammar.
    - match: '.+'
      handler: |
        respond("\r\ninvalid cmd: " + re.sub(r"\s+", "", match.group(0)).lower() + "\r\n>")
