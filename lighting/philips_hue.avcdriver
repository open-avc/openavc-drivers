# Philips Hue Bridge Driver (Local REST API V1)
#
# Controls Philips Hue lights, groups (rooms / zones / "all lights"), and
# scenes via the local REST API V1 on a Hue Bridge over HTTP (port 80).
#
# Models covered:
#   - Hue Bridge V2 (BSB002, square)  — current production bridge
#   - Hue Bridge V1 (BSB001, round)   — legacy, still supported by V1 API
#
# Protocol reference:
#   The Hue API V1 reference is gated behind a developer-portal login. This
#   driver is built against the home-assistant-libs/aiohue V1 implementation
#   (a mature open-source client that mirrors the original Signify spec) and
#   the broadly-mirrored V1 endpoint shape.
#
# Push vs. poll:
#   The V1 API is request/response only — there is no push or subscription
#   primitive. (V2 / CLIP V2 adds Server-Sent Events, but that is a separate
#   driver effort and requires HTTPS + SSE support in the platform's HTTP
#   transport. Most production AV bridges still expose V1.) This driver
#   polls /config periodically as a connectivity heartbeat. State for
#   individual lights / groups / scenes is intentionally NOT mirrored on
#   the device-level state store: a single bridge can drive 50+ lights
#   and dozens of scenes, all keyed by user-assigned IDs that vary per
#   install. Commands take the light/group/scene ID as a parameter.
#
# Authentication:
#   The bridge uses a per-app "username" (sometimes called "app key") that
#   is generated by POSTing to /api after the user presses the physical
#   "link button" on top of the bridge. The driver exposes this as the
#   `app_key` config field. Run the `create_user` command from the device
#   page within 30 seconds of pressing the link button to generate one.
#
# Scope:
#   AV-integrator runtime control surface — recall scenes, on/off groups,
#   set group brightness / color / color-temperature, plus the same set
#   on individual lights for finer control. Light/group/scene creation,
#   sensor/rule/schedule management, and software-update control are
#   install-time tasks left to the Hue mobile app.

id: philips_hue
name: Philips Hue Bridge
manufacturer: Signify
category: lighting
version: 1.0.0
author: OpenAVC
description: >
  Controls Philips Hue lights, rooms, zones, and scenes via the local
  REST API V1 on a Hue Bridge (HTTP, port 80). Recall scenes, on/off
  whole rooms, set brightness / color / color-temperature on groups
  or individual lights. Polling-based — the V1 API does not push.

source_url: https://github.com/home-assistant-libs/aiohue/tree/master/aiohue/v1
tags: [hue, philips, signify, lighting, residential, bridge, scenes]
verified: false
simulated: true
protocols: [hue_v1]
ports: [80]

compatible_models:
  - manufacturer: Signify
    models:
      - Hue Bridge V2 (BSB002)
      - Hue Bridge V1 (BSB001)
    confidence: untested
    notes: >
      Both bridge generations expose the V1 REST API on port 80. The V2
      bridge (square, BSB002) is the current production model and also
      supports the V2 / CLIP V2 API over HTTPS — this driver targets V1
      only. The V1 bridge (round, BSB001) is end-of-life for new firmware
      but still functional.

transport: http

help:
  overview: >
    Philips Hue is the most widely deployed residential and small-commercial
    smart-lighting platform. The bridge sits on the LAN and bridges Zigbee
    bulbs / fixtures to a local REST API. AV integrators commonly use it
    for accent lighting in boardrooms, hospitality spaces, and houses of
    worship — recall a "Presentation" scene when the projector turns on,
    fade up "Q&A" lighting when the session ends.
  setup: >
    1. Set a static IP (or DHCP reservation) on the Hue Bridge in your
       router. Default discovery is via mDNS (_hue._tcp) or the Signify
       cloud at https://discovery.meethue.com.
    2. Press the round link button on top of the bridge.
    3. Within 30 seconds, run the "Create User (Pair)" command from this
       device's Commands tab. The response will contain a username string
       like "abc123XYZ...". Copy that into the App Key field below.
    4. Find the IDs of your lights, groups (rooms / zones), and scenes.
       The easiest way is to run the "Query All Lights", "Query All
       Groups", or "Query All Scenes" commands and read the IDs from the
       response. Light and group IDs are short numeric strings ("1", "2",
       "10"). Scene IDs are longer alphanumeric strings ("AB-cdef-12gh").
    5. Use the light_* / group_* / recall_scene commands with those IDs.
       Group ID 0 is the special "all lights" group.
    6. Polling is set to 30 seconds by default and only refreshes bridge
       metadata. Light / group state is not mirrored — read it on demand
       via the query_* commands.

discovery:
  ports: [80]
  mac_prefixes: ["00:17:88", "EC:B5:FA", "1C:53:F9"]

default_config:
  host: ""
  port: 80
  ssl: false
  verify_ssl: false
  auth_type: "none"            # bridge auth is via app_key in URL path
  app_key: ""
  timeout: 5.0
  poll_interval: 30

config_schema:
  host:
    type: string
    required: true
    label: Bridge IP Address
    description: "IP address of the Hue Bridge. Set a DHCP reservation in your router."
  port:
    type: integer
    default: 80
    label: HTTP Port
    description: "V1 API port. Default 80. The bridge does not expose V1 on HTTPS."
  app_key:
    type: string
    default: ""
    required: true
    label: App Key (Username)
    description: >
      Per-app authentication key. Press the link button on the bridge,
      then run the "Create User (Pair)" command and copy the username
      from the response into this field.
    secret: true
  poll_interval:
    type: integer
    default: 30
    min: 10
    label: Poll Interval (sec)
    description: "How often to refresh bridge metadata. Light / group state is NOT polled."
  timeout:
    type: number
    default: 5.0
    label: Request Timeout (sec)

state_variables:
  bridge_name:
    type: string
    label: Bridge Name
  bridge_id:
    type: string
    label: Bridge ID
    description: "16-character hex bridge identifier (also printed on the bridge label)."
  model_id:
    type: string
    label: Model ID
    description: "BSB002 = Hue Bridge V2 (square). BSB001 = Hue Bridge V1 (round)."
  api_version:
    type: string
    label: API Version
  sw_version:
    type: string
    label: Bridge Firmware Version
  mac_address:
    type: string
    label: MAC Address
  zigbee_channel:
    type: integer
    label: Zigbee Channel

commands:

  # ── Pairing / bridge metadata ──

  create_user:
    label: Create User (Pair)
    method: POST
    path: "/api"
    body: '{"devicetype": "openavc#openavc"}'
    help: >
      Press the link button on top of the bridge, then run this command
      within 30 seconds. The response contains a "username" string —
      copy it into the App Key config field.

  query_config:
    label: Query Bridge Config
    method: GET
    path: "/api/{app_key}/config"
    help: "Refreshes bridge metadata state variables."

  query_full_state:
    label: Query Full Bridge State
    method: GET
    path: "/api/{app_key}"
    help: "Returns the entire bridge state (lights, groups, scenes, sensors, etc.) as a single JSON document. Useful for inspection."

  # ── Light commands (per-light by ID) ──

  light_on:
    label: Light On
    method: PUT
    path: "/api/{app_key}/lights/{light_id}/state"
    body: '{"on": true}'
    params:
      light_id:
        type: string
        required: true
        label: Light ID
        description: "Numeric ID, e.g. '1', '2', '10'. Use Query All Lights to discover."

  light_off:
    label: Light Off
    method: PUT
    path: "/api/{app_key}/lights/{light_id}/state"
    body: '{"on": false}'
    params:
      light_id:
        type: string
        required: true
        label: Light ID

  light_set_brightness:
    label: Light Set Brightness
    method: PUT
    path: "/api/{app_key}/lights/{light_id}/state"
    body: '{"on": true, "bri": {bri}}'
    help: "Brightness 1..254. Sending 0 turns the light off via 'on:false' instead."
    params:
      light_id:
        type: string
        required: true
        label: Light ID
      bri:
        type: integer
        required: true
        default: 254
        min: 1
        max: 254
        label: Brightness (1..254)

  light_set_color_temp:
    label: Light Set Color Temperature
    method: PUT
    path: "/api/{app_key}/lights/{light_id}/state"
    body: '{"on": true, "ct": {ct}}'
    help: >
      Color temperature in mired (reciprocal megakelvin). Range 153 (~6500K,
      cool) to 500 (~2000K, warm). Only valid for white-ambiance and color
      bulbs.
    params:
      light_id:
        type: string
        required: true
        label: Light ID
      ct:
        type: integer
        required: true
        default: 366
        min: 153
        max: 500
        label: Color Temperature (153..500 mired)

  light_set_hue_sat:
    label: Light Set Hue / Saturation
    method: PUT
    path: "/api/{app_key}/lights/{light_id}/state"
    body: '{"on": true, "hue": {hue}, "sat": {sat}}'
    help: "Hue 0..65535, saturation 0..254. Color bulbs only."
    params:
      light_id:
        type: string
        required: true
        label: Light ID
      hue:
        type: integer
        required: true
        default: 0
        min: 0
        max: 65535
        label: Hue (0..65535)
      sat:
        type: integer
        required: true
        default: 254
        min: 0
        max: 254
        label: Saturation (0..254)

  light_set_xy:
    label: Light Set XY (CIE)
    method: PUT
    path: "/api/{app_key}/lights/{light_id}/state"
    body: '{"on": true, "xy": [{x}, {y}]}'
    help: "CIE 1931 XY chromaticity coordinates. Color bulbs only."
    params:
      light_id:
        type: string
        required: true
        label: Light ID
      x:
        type: number
        required: true
        default: 0.3127
        min: 0.0
        max: 1.0
        label: X (0.0..1.0)
      y:
        type: number
        required: true
        default: 0.329
        min: 0.0
        max: 1.0
        label: Y (0.0..1.0)

  light_alert:
    label: Light Alert (Identify)
    method: PUT
    path: "/api/{app_key}/lights/{light_id}/state"
    body: '{"alert": "{alert}"}'
    help: >
      Make the light flash so the installer can find it. 'select' = one
      breathe cycle, 'lselect' = breathe for 15 seconds, 'none' = stop.
    params:
      light_id:
        type: string
        required: true
        label: Light ID
      alert:
        type: enum
        values: ["none", "select", "lselect"]
        default: "select"
        required: true
        label: Alert Type

  query_light:
    label: Query Light
    method: GET
    path: "/api/{app_key}/lights/{light_id}"
    params:
      light_id:
        type: string
        required: true
        label: Light ID

  query_all_lights:
    label: Query All Lights
    method: GET
    path: "/api/{app_key}/lights"
    help: "Returns all lights as a JSON object keyed by light ID. Inspect to find IDs."

  # ── Group commands (rooms, zones, group 0 = all lights) ──

  group_on:
    label: Group On
    method: PUT
    path: "/api/{app_key}/groups/{group_id}/action"
    body: '{"on": true}'
    params:
      group_id:
        type: string
        required: true
        default: "0"
        label: Group ID
        description: "Numeric ID. 0 = all lights. 1+ = rooms / zones."

  group_off:
    label: Group Off
    method: PUT
    path: "/api/{app_key}/groups/{group_id}/action"
    body: '{"on": false}'
    params:
      group_id:
        type: string
        required: true
        default: "0"
        label: Group ID

  group_set_brightness:
    label: Group Set Brightness
    method: PUT
    path: "/api/{app_key}/groups/{group_id}/action"
    body: '{"on": true, "bri": {bri}}'
    params:
      group_id:
        type: string
        required: true
        default: "0"
        label: Group ID
      bri:
        type: integer
        required: true
        default: 254
        min: 1
        max: 254
        label: Brightness (1..254)

  group_set_color_temp:
    label: Group Set Color Temperature
    method: PUT
    path: "/api/{app_key}/groups/{group_id}/action"
    body: '{"on": true, "ct": {ct}}'
    params:
      group_id:
        type: string
        required: true
        default: "0"
        label: Group ID
      ct:
        type: integer
        required: true
        default: 366
        min: 153
        max: 500
        label: Color Temperature (153..500 mired)

  group_set_hue_sat:
    label: Group Set Hue / Saturation
    method: PUT
    path: "/api/{app_key}/groups/{group_id}/action"
    body: '{"on": true, "hue": {hue}, "sat": {sat}}'
    params:
      group_id:
        type: string
        required: true
        default: "0"
        label: Group ID
      hue:
        type: integer
        required: true
        default: 0
        min: 0
        max: 65535
        label: Hue (0..65535)
      sat:
        type: integer
        required: true
        default: 254
        min: 0
        max: 254
        label: Saturation (0..254)

  group_recall_scene:
    label: Group Recall Scene
    method: PUT
    path: "/api/{app_key}/groups/{group_id}/action"
    body: '{"scene": "{scene_id}"}'
    help: >
      Recall a Hue scene scoped to the given group. Group 0 lets the
      scene apply to whichever lights it contains.
    params:
      group_id:
        type: string
        required: true
        default: "0"
        label: Group ID
        description: "0 = apply to whichever lights are in the scene."
      scene_id:
        type: string
        required: true
        label: Scene ID
        description: "Alphanumeric scene ID. Use Query All Scenes to discover."

  query_group:
    label: Query Group
    method: GET
    path: "/api/{app_key}/groups/{group_id}"
    params:
      group_id:
        type: string
        required: true
        default: "0"
        label: Group ID

  query_all_groups:
    label: Query All Groups
    method: GET
    path: "/api/{app_key}/groups"
    help: "Returns all groups (rooms, zones, custom groups) as a JSON object keyed by group ID."

  # ── Scene commands ──

  recall_scene:
    label: Recall Scene (All Lights)
    method: PUT
    path: "/api/{app_key}/groups/0/action"
    body: '{"scene": "{scene_id}"}'
    help: "Shortcut: recall a scene targeting group 0. Same as group_recall_scene with group_id=0."
    params:
      scene_id:
        type: string
        required: true
        label: Scene ID

  query_all_scenes:
    label: Query All Scenes
    method: GET
    path: "/api/{app_key}/scenes"
    help: "Returns all scenes as a JSON object keyed by scene ID."

  query_scene:
    label: Query Scene
    method: GET
    path: "/api/{app_key}/scenes/{scene_id}"
    params:
      scene_id:
        type: string
        required: true
        label: Scene ID

# Response patterns. /api/<key>/config is a flat JSON object — match the
# fields we care about with simple key-quoted-value regexes. Other endpoints
# return nested or array JSON that the user inspects on demand; we don't
# try to fan those out into state.
responses:
  - match: '"name":"([^"]+)"'
    set: { bridge_name: "$1" }
  - match: '"bridgeid":"([^"]+)"'
    set: { bridge_id: "$1" }
  - match: '"modelid":"([^"]+)"'
    set: { model_id: "$1" }
  - match: '"apiversion":"([^"]+)"'
    set: { api_version: "$1" }
  - match: '"swversion":"([^"]+)"'
    set: { sw_version: "$1" }
  - match: '"mac":"([^"]+)"'
    set: { mac_address: "$1" }
  - match: '"zigbeechannel":\s*(\d+)'
    set: { zigbee_channel: "$1" }

polling:
  interval: 30
  queries:
    - query_config

# ── SIMULATOR DEFINITION ──
simulator:
  initial_state:
    bridge_name: "Sim Hue Bridge"
    bridge_id: "001788FFFEABCDEF"
    model_id: "BSB002"
    api_version: "1.65.0"
    sw_version: "1965055050"
    mac_address: "00:17:88:ab:cd:ef"
    zigbee_channel: 25

  delays:
    command_response: 0.02

  controls:
    - type: indicator
      key: bridge_name
      label: Bridge Name
    - type: indicator
      key: bridge_id
      label: Bridge ID
    - type: indicator
      key: model_id
      label: Model ID
    - type: indicator
      key: api_version
      label: API Version
    - type: indicator
      key: sw_version
      label: Firmware
    - type: indicator
      key: mac_address
      label: MAC
    - type: indicator
      key: zigbee_channel
      label: Zigbee Channel

  command_handlers:

    # Pair / create user — link button always pressed in sim.
    - match: '^POST /api(\?.*)?\|.*'
      handler: |
        respond('[{"success":{"username":"sim-app-key-abc123"}}]')

    # Query bridge config — flat JSON with the fields the driver parses.
    - match: '^GET /api/[^/]+/config$'
      handler: |
        body = (
          '{'
          f'"name":"{state["bridge_name"]}",'
          f'"bridgeid":"{state["bridge_id"]}",'
          f'"modelid":"{state["model_id"]}",'
          f'"apiversion":"{state["api_version"]}",'
          f'"swversion":"{state["sw_version"]}",'
          f'"mac":"{state["mac_address"]}",'
          f'"zigbeechannel":{state["zigbee_channel"]},'
          '"datastoreversion":"103","factorynew":false'
          '}'
        )
        respond(body)

    # Query full state — also exercises the same response keys.
    - match: '^GET /api/[^/]+$'
      handler: |
        cfg = (
          '"config":{'
          f'"name":"{state["bridge_name"]}",'
          f'"bridgeid":"{state["bridge_id"]}",'
          f'"modelid":"{state["model_id"]}",'
          f'"apiversion":"{state["api_version"]}",'
          f'"swversion":"{state["sw_version"]}",'
          f'"mac":"{state["mac_address"]}",'
          f'"zigbeechannel":{state["zigbee_channel"]}'
          '}'
        )
        respond('{' + cfg + ',"lights":{},"groups":{},"scenes":{}}')

    # Query all lights / groups / scenes — return empty objects in sim.
    - match: '^GET /api/[^/]+/lights$'
      handler: |
        respond('{}')
    - match: '^GET /api/[^/]+/groups$'
      handler: |
        respond('{"0":{"name":"Group 0","type":"LightGroup","lights":[],"action":{"on":false}}}')
    - match: '^GET /api/[^/]+/scenes$'
      handler: |
        respond('{}')

    # Query single light / group / scene — minimal stub responses.
    - match: '^GET /api/[^/]+/lights/(\w+)$'
      handler: |
        lid = match.group(1)
        respond('{"name":"Light ' + lid + '","state":{"on":false,"bri":254}}')
    - match: '^GET /api/[^/]+/groups/(\w+)$'
      handler: |
        gid = match.group(1)
        respond('{"name":"Group ' + gid + '","type":"Room","action":{"on":false}}')
    - match: '^GET /api/[^/]+/scenes/(\S+)$'
      handler: |
        sid = match.group(1)
        respond('{"name":"Scene ' + sid + '","lights":[]}')

    # Light state PUT — accept the body and ack.
    - match: '^PUT /api/[^/]+/lights/(\w+)/state\|(.+)$'
      handler: |
        lid = match.group(1)
        respond('[{"success":{"/lights/' + lid + '/state/on":true}}]')

    # Group action PUT — accept the body and ack.
    - match: '^PUT /api/[^/]+/groups/(\w+)/action\|(.+)$'
      handler: |
        gid = match.group(1)
        respond('[{"success":{"/groups/' + gid + '/action/on":true}}]')
