# EIKI EIP-U4700 Projector (RS-232)
#
# WUXGA DLP installation projector. This driver speaks the projector's
# RS-232 "Projector Control mode" command set, so it is usable over a direct
# serial port or *through a bridge* (e.g. a Global Cache iTach IP2SL) — bind it
# from the device's Connection settings and the platform routes it over the
# bridge's serial pass-through.
#
# (The EIP-U4700 also speaks PJLink over its LAN port; that is a separate,
#  network-only protocol — use the pjlink_class1 driver for that path. PJLink
#  cannot run over the serial bridge.)
#
# Serial settings (from EIKI's "EIP-U4700 RS-232 basic serial commands"):
#   9600 baud, 8 data bits, no parity, 1 stop bit, no flow control.
#
# Command format: fixed 8 ASCII bytes — a 4-character command code plus a
# 4-character parameter, NO terminator. The parameter is right-justified and
# padded with underscores ("_" = 0x5F):
#   POWR___1  -> Power On            (P O W R _ _ _ 1)
#   POWR___0  -> Power Off
#   ISEL___6  -> Set source = HDMI
#   PICM___3  -> Set display mode = Game
# Query forms use "????" (0x3F) in the parameter, e.g. PICM???? = get mode.
# Relative adjust commands use a fixed "9999" (increment) / "8888" (decrement)
# parameter, e.g. BRIT9999 = brightness +1.
#
# Reply format: the projector returns OK / ERR for set commands and a value
# for queries. The exact framing/terminator is not specified in EIKI's basic
# command sheet, so v1 ships the (verified-from-the-sheet) COMMAND set only.
# Response parsing, polled state variables, exact set-to-value commands (which
# need value padding), and a simulator are deferred until the reply framing is
# confirmed against real hardware. See the header notes when extending.

id: eiki_eip_u4700
name: EIKI EIP-U4700 Projector
manufacturer: EIKI
category: projector
version: 1.0.0
author: OpenAVC
description: >-
  Controls the EIKI EIP-U4700 WUXGA projector over RS-232 (9600 8N1), directly
  or through a serial bridge. Power, source select, blank, freeze, picture and
  lamp modes, projection orientation, image adjust, and front-panel keys.
source_url: https://www.eiki.com/rs-232-command-codes/
tags: [projector, eiki, rs232, rs-232, serial, eip-u4700, dlp, bridge]
verified: false
simulated: false
ports: []
compatible_models:
  - manufacturer: EIKI
    models:
      - EIP-U4700
    confidence: untested
    notes: >-
      Commands taken from EIKI's EIP-U4700 RS-232 basic serial command sheet.
      Other EIKI EIP-series models may share this 8-byte command format; verify
      per model before claiming support.

transport: serial
# Response framing only (sent commands are literal 8-byte strings with no
# terminator). EIKI's sheet doesn't state the reply terminator; CR is the
# working assumption pending hardware confirmation.
delimiter: "\r"

help:
  overview: >-
    EIKI EIP-U4700 projector over RS-232. Works on a direct serial port or
    through a serial bridge (choose "Through a bridge" in Connection settings
    and pick the bridge's RS-232 port). Power, source, blank, freeze, picture
    and lamp modes, orientation, image adjust, and remote keys.
  setup: >-
    1. Connect the projector's RS-232 port (or wire it to a serial bridge).
    2. Serial settings are 9600 baud, 8 data bits, no parity, 1 stop bit.
    3. Through a bridge, set the same 9600 8N1 on the binding; the bridge
       applies it to the line automatically.
  connection: >-
    The projector's RS-232 control port must be enabled in its menu if your
    unit has a serial/Ethernet control selector.

default_config:
  poll_interval: 0

config_schema:
  poll_interval:
    type: integer
    default: 0
    min: 0
    label: Poll Interval (sec)
    description: >-
      Status polling is not enabled in this version (reply parsing pending
      hardware verification). Leave at 0.

commands:
  # ── Power ──
  power_on:
    label: Power On
    send: "POWR___1"
    help: Turn the projector on.
  power_off:
    label: Power Off
    send: "POWR___0"
    help: Turn the projector off (to standby).
  query_power:
    label: Query Power Status
    send: "POWR____"
    help: >-
      Request power status. Reply parsing is not wired yet; use this to confirm
      the query form against hardware. (Returns 0:Reset 1:Standby 2:Active
      3:Cooling.)

  # ── Source select (ISEL___n) ──
  source_vga:
    label: "Source: VGA"
    send: "ISEL___1"
  source_vga2:
    label: "Source: VGA 2"
    send: "ISEL___2"
  source_dvi:
    label: "Source: DVI"
    send: "ISEL___3"
  source_video:
    label: "Source: Video"
    send: "ISEL___4"
  source_svideo:
    label: "Source: S-Video"
    send: "ISEL___5"
  source_hdmi:
    label: "Source: HDMI"
    send: "ISEL___6"
  source_bnc:
    label: "Source: BNC"
    send: "ISEL___7"
  source_component:
    label: "Source: Component"
    send: "ISEL___8"
  source_displayport:
    label: "Source: DisplayPort"
    send: "ISEL___9"
  source_hdmi2:
    label: "Source: HDMI 2"
    send: "ISEL__10"
    help: Two-digit source code; verify against hardware.
  query_source:
    label: Query Source
    send: "ICHK????"

  # ── Picture / display ──
  blank_on:
    label: Blank On
    send: "PIMU___1"
  blank_off:
    label: Blank Off
    send: "PIMU___0"
  freeze:
    label: Freeze (toggle key)
    send: "KYFR___1"
  auto_image:
    label: Auto Image
    send: "ADJS___1"
  set_picture_mode:
    label: Set Display Mode
    send: "PICM___{mode}"
    params:
      mode:
        type: string
        label: Display Mode
        values: ["0", "1", "2", "3", "4", "5", "6", "7", "8"]
        description: 0:Standard 1:Presentation 2:Bright 3:Game 4:Movie 5:TV 6:sRGB 7:Blackboard 8:User
  set_test_pattern:
    label: Set Test Pattern
    send: "PTRN___{pattern}"
    params:
      pattern:
        type: string
        label: Test Pattern
        values: ["0", "1", "2", "3", "4", "5", "6"]
        description: 0:Off 1:Grid 2:White 3:Red 4:Green 5:Blue 6:Black
  set_background_color:
    label: Set Background Color
    send: "IMBG___{color}"
    params:
      color:
        type: string
        label: Background Color
        values: ["0", "1", "2", "3", "4"]
        description: 0:Black 1:Red 2:Green 3:Blue 4:White
  set_aspect:
    label: Set Aspect Ratio
    send: "ASPC___{ratio}"
    params:
      ratio:
        type: string
        label: Aspect Ratio (0-5)
        values: ["0", "1", "2", "3", "4", "5"]

  # ── Image adjust (relative; 9999 = +1, 8888 = -1) ──
  brightness_up:
    label: Brightness +
    send: "BRIT9999"
  brightness_down:
    label: Brightness -
    send: "BRIT8888"
  contrast_up:
    label: Contrast +
    send: "CONT9999"
  contrast_down:
    label: Contrast -
    send: "CONT8888"
  color_up:
    label: Color +
    send: "SATU9999"
  color_down:
    label: Color -
    send: "SATU8888"
  tint_up:
    label: Tint +
    send: "TINT9999"
  tint_down:
    label: Tint -
    send: "TINT8888"
  sharpness_up:
    label: Sharpness +
    send: "SHRP9999"
  sharpness_down:
    label: Sharpness -
    send: "SHRP8888"
  keystone_up:
    label: V Keystone +
    send: "KEYV9999"
  keystone_down:
    label: V Keystone -
    send: "KEYV8888"
  zoom_in:
    label: Zoom +
    send: "LNZO9999"
  zoom_out:
    label: Zoom -
    send: "LNZO8888"
  volume_up:
    label: Volume +
    send: "KYVO9999"
  volume_down:
    label: Volume -
    send: "KYVO8888"

  # ── Lamp / projection ──
  set_lamp_mode:
    label: Set Lamp Mode
    send: "LMPM___{mode}"
    params:
      mode:
        type: string
        label: Lamp Mode
        values: ["0", "1", "2"]
        description: 0:Eco 1:Normal 2:Dynamic Eco
  query_lamp_mode:
    label: Query Lamp Mode
    send: "LMPM????"
  set_projection:
    label: Set Projection Orientation
    send: "PJMD___{mode}"
    params:
      mode:
        type: string
        label: Orientation
        values: ["0", "1", "2", "3"]
        description: 0:Front 1:Rear 2:Ceiling 3:Rear+Ceiling
  set_fan_mode:
    label: Set Fan Mode
    send: "HLMD___{mode}"
    params:
      mode:
        type: string
        label: Fan Mode
        values: ["0", "1"]
        description: 0:Normal 1:High

  # ── Front-panel keys ──
  key_menu:
    label: "Key: Menu"
    send: "KYMN___1"
  key_source:
    label: "Key: Source"
    send: "KYIN___1"
  key_auto:
    label: "Key: Auto"
    send: "KYSY___1"
  key_status:
    label: "Key: Status"
    send: "KYIF___1"
  key_enter:
    label: "Key: Enter"
    send: "KYEN___1"
  key_up:
    label: "Key: Up"
    send: "KYUP___1"
  key_down:
    label: "Key: Down"
    send: "KYDO___1"
  key_left:
    label: "Key: Left"
    send: "KYLE___1"
  key_right:
    label: "Key: Right"
    send: "KYRI___1"

  # ── Info queries (reply parsing pending hardware verification) ──
  query_model:
    label: Query Model Name
    send: "MNRD___1"
  query_serial:
    label: Query Serial Number
    send: "SNRD___1"
  query_sw_version:
    label: Query Software Version
    send: "SWVR___1"
  query_lamp_hours:
    label: Query Lamp Hours
    send: "PJRT????"

  # ── Raw escape hatch ──
  send_command:
    label: Send Raw Command
    send: "{raw}"
    params:
      raw:
        type: string
        label: Raw 8-byte Command
        description: >-
          Full 8-character EIKI command, e.g. "POWR___1". Sent literally with
          no terminator. Use for commands not exposed above.
