# Atlona AT-OME-PS62 Driver
#
# Controls the Atlona AT-OME-PS62 6x2 matrix presentation switcher over Telnet
# (port 23). One product — distinct from the Display:Matrix:Set syntax used by
# the AT-OME-MS42 / MS52 / MS52W family, which needs its own driver.
#
# Inputs (1-6):  HDMI 1, HDMI 2, HDMI 3, USB-C, HDBaseT IN 1, HDBaseT IN 2
# Outputs (1-2): HDBaseT OUT, HDMI OUT
# Audio zones (1-4): HDBaseT OUT, HDMI OUT, Analog OUT 1 (Aux 1), Analog OUT 2 (Aux 2)
# Analog audio source routing: independent of video — HDBaseT / HDMI / AUX1-3
# USB host: 6 sources, three follow modes (Follow USB / Manual / Follow Video)
#
# Protocol reference: AT-OME-PS62 Application Programming Interface (rev 5, Jun 2023)
# https://atlona.com/pdf/AT-OME-PS62_API.pdf
#
# Wire format:
#   Each command is terminated with a carriage-return (0x0d).
#   Each feedback line is terminated with carriage-return + line-feed.
#   Commands are case-sensitive.
#   Failed commands return "Command FAILED".
#
# Routing:
#   xXAVxY      route input X (1-6) to output Y (1-2)
#   xXAll       route input X to both outputs
#   All#        reset to 1->1, 2->2
#   Status      one-line dump: "x1AVx1, x2AVx2"
#
# Audio (per zone 1-4):
#   VOUTX Y       set zone X volume — Y is integer dB (-90..10), '+' / '-' to bump, or 'sta'
#   VOUTMuteX Y   mute zone X — on / off / sta
#   AUDX Y        analog output X (1-2) source — HDBaseT, HDMI, AUX1, AUX2, AUX3
#   SetMonoX Y    stereo (off) / mono (on) per analog output
#
# USB switching:
#   UsbMode X     0 = Follow USB (host follows USB hub), 1 = Manual, 2 = Follow Video
#   UsbRoute X    USB host port: 1-2 local, 3 HDBaseT OUT, 4 USB-C, 5-6 HDBaseT IN 1/2
#
# Auth (default: optional):
#   PS62 supports a "Telnet Login Mode" toggle in the web UI. When ON, the
#   device prompts "Login: " then "Password: " before commands. When OFF,
#   commands are accepted immediately. The driver handles both via the
#   auth: block with skip_if_empty: true — leave Username/Password blank if
#   Telnet Login Mode is disabled on the unit. Same prompt strings as
#   atlona_uhd_pro3 / atlona_omnistream.
#
# Child entities:
#   The device's sub-units are modeled as child entities with declarative
#   rosters (instances:) — video outputs (2), audio zones (4), analog audio
#   outputs (2), and inputs (6). Per-unit responses route into child state
#   via child_set (the echoed unit number is the child id); the combined
#   Status line ("x3AVx1, x2AVx2") uses one regex with two capture groups
#   and literal child ids, because response dispatch returns on the first
#   matching pattern. Per-unit polling uses each_child query templates.
#   Zone numbering: zone 1 = HDBaseT Out audio, 2 = HDMI Out audio,
#   3 = Analog Out 1, 4 = Analog Out 2 (analog_out N carries zone N+2's
#   source/mono controls).

id: atlona_ome_ps62
name: Atlona AT-OME-PS62 Matrix Switcher
manufacturer: Atlona
category: switcher
version: 1.5.0
author: OpenAVC
min_platform_version: "0.27.0"
description: >
  Controls the Atlona AT-OME-PS62 6x2 4K/UHD matrix presentation switcher
  over Telnet on port 23. Routes any of six inputs (HDMI / USB-C / HDBaseT)
  to two outputs (HDBaseT and HDMI). Independent four-zone audio with
  per-zone volume and mute, analog audio source routing, USB host switching,
  front-panel lock, and identify (POWER LED blink).

source_url: https://atlona.com/pdf/AT-OME-PS62_API.pdf
tags: [matrix-switcher, presentation, hdbaset, usb-c, atlona, ome, telnet]
verified: false
simulated: true
protocols: [atlona_ome_ps62]
ports: [23]
compatible_models:
  - manufacturer: Atlona
    models:
      - AT-OME-PS62
    confidence: untested
    notes: >
      6x2 4K/UHD matrix presentation switcher with USB hub. The MS42 / MS52
      / MS52W family in the OME line uses a completely different command
      syntax (Display:Matrix:Set...) and is covered by a separate driver.

transport: tcp
delimiter: "\r\n"

help:
  overview: >
    The PS62 routes six HDMI / USB-C / HDBaseT sources to a HDBaseT and a
    HDMI output. Audio is independent: each of the two video outputs and
    two analog audio outputs has its own volume and mute. Analog audio can
    follow the HDBaseT or HDMI feed, or pull from one of three auxiliary
    inputs.
  setup: >
    1. Set a static IP on the matrix via its web UI (or DHCP reservation).
    2. If Telnet Login Mode is ON in the matrix's web UI, enter the same
       Username / Password used for the web GUI in this driver's config.
       Leave both blank if Telnet Login Mode is OFF.
    3. Atlona requires a 500 ms minimum delay between commands; the driver
       is pre-configured for this.

discovery:
  # Atlona KB01625 confirms OME / SW-510W / MS52W announce on mDNS
  # (UDP 5353), but the literal `_atlona-ome._tcp` PTR string is NOT
  # published in any vendor doc, KB article, or OEM integrator
  # module — Velocity / AMS auto-discover by browsing rather than by
  # a fixed string. Hint-only via OUI + the Atlona manufacturer alias.
  oui:
    - "b8:98:b0"
  manufacturer_alias:
    - "atlona"

default_config:
  host: ""
  port: 23
  username: ""
  password: ""
  poll_interval: 30
  inter_command_delay: 0.5

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 23
    label: Telnet Port
  username:
    type: string
    default: ""
    label: Username
    description: "Telnet login. Required only when Telnet Login Mode is enabled in the matrix's web UI."
  password:
    type: string
    default: ""
    label: Password
    secret: true
    description: "Telnet password. Same credentials as the matrix web GUI."
  poll_interval:
    type: integer
    default: 30
    min: 0
    label: Poll Interval (sec)
    description: "Set to 0 to disable polling."
  inter_command_delay:
    type: number
    default: 0.5
    min: 0.5
    label: Inter-Command Delay (sec)
    description: "Atlona requires at least 500 ms between commands."

auth:
  type: telnet_login
  username_prompt: "Login: "
  password_prompt: "Password: "
  username_field: username
  password_field: password
  skip_if_empty: true
  timeout_seconds: 10
  line_ending: "\r\n"

state_variables:
  model:
    type: string
    label: Model
    help: "Model string reported by the `Type` query."
  firmware:
    type: string
    label: Firmware Version
    help: "Firmware version string reported by the `Version` query."
  front_panel_locked:
    type: boolean
    label: Front Panel Locked
    help: "True when the front-panel buttons are locked (Lock / Unlock)."
  usb_mode:
    type: integer
    label: USB Mode (0=Follow USB, 1=Manual, 2=Follow Video)
    help: "USB host-routing mode: 0 = follow USB selection, 1 = manual, 2 = follow active video input."
  usb_route:
    type: integer
    label: USB Host Source
    help: "Currently-selected USB host port (1 = USB-C, 2 = USB-B)."

# Two planes on two different child types: the HDMI/HDBaseT outputs switch
# video, and the analog audio outs select their own source separately.
routing:
  source_child_type: input
  planes:
    - label: Video
      destination_child_type: output
      route_property: input
      command: route
    - label: Analog Audio
      destination_child_type: analog_out
      route_property: source
      command: set_audio_source

child_entity_types:
  output:
    label: Output
    label_plural: Outputs
    id_format: { type: integer, min: 1, max: 2 }
    state_variables:
      input:
        type: integer
        label: Routed Input
        help: "Input (1-6) currently routed to this output. Output 1 = HDBaseT, output 2 = HDMI."
        cloud_priority: high
    summary_fields: [input]
    instances:
      count: 2
      label: "Output {id}"
  zone:
    label: Audio Zone
    label_plural: Audio Zones
    id_format: { type: integer, min: 1, max: 4 }
    state_variables:
      volume:
        type: integer
        label: Volume (dB)
        min: -90
        max: 10
        help: "Zone volume in dB (-90..+10). Zone 1 = HDBaseT Out, 2 = HDMI Out, 3 = Analog Out 1, 4 = Analog Out 2."
      mute:
        type: boolean
        label: Muted
        cloud_priority: high
    summary_fields: [volume, mute]
    instances:
      count: 4
      label: "Zone {id}"
  analog_out:
    label: Analog Audio Out
    label_plural: Analog Audio Outs
    id_format: { type: integer, min: 1, max: 2 }
    state_variables:
      source:
        type: enum
        values: ["HDBaseT", "HDMI", "AUX1", "AUX2", "AUX3"]
        label: Audio Source
        help: "Source feeding this analog output (HDBaseT, HDMI, or analog AUX 1-3). Its volume/mute live on zone N+2."
      mono:
        type: boolean
        label: Mono
        help: "True when this analog output is summed to mono."
    summary_fields: [source, mono]
    instances:
      count: 2
      label: "Analog Out {id}"
  input:
    label: Input
    label_plural: Inputs
    id_format: { type: integer, min: 1, max: 6 }
    state_variables:
      signal:
        type: boolean
        label: Signal Present
        help: "True when this input detects a valid HDMI/USB-C/HDBaseT signal."
        cloud_priority: high
    summary_fields: [signal]
    instances:
      count: 6
      label: "Input {id}"

commands:

  # ── Routing ──

  route:
    label: Route Input to Output
    send: "x{input}AVx{output}\r"
    help: "Route a single input (1-6) to a single output (1=HDBaseT, 2=HDMI)."
    params:
      input:
        type: child_id
        child_type: input
        required: true
        label: Input
      output:
        type: child_id
        child_type: output
        required: true
        label: Output

  route_all:
    label: Route Input to All Outputs
    send: "x{input}All\r"
    help: "Route a single input to both outputs simultaneously."
    params:
      input:
        type: child_id
        child_type: input
        required: true
        label: Input

  route_reset:
    label: Reset Routing (1-to-1)
    send: "All#\r"
    help: "Route input 1 to output 1 and input 2 to output 2."

  query_routing:
    label: Query Routing (Status)
    send: "Status\r"
    help: "Refresh route_1 and route_2 from the matrix."

  # ── Analog audio source routing ──

  set_audio_source:
    label: Set Analog Audio Source
    send: "AUD{output} {source}\r"
    help: "Pick the audio source feeding an analog output."
    params:
      output:
        type: child_id
        child_type: analog_out
        required: true
        label: Analog Output
      source:
        type: enum
        required: true
        label: Audio Source
        values: ["HDBaseT", "HDMI", "AUX1", "AUX2", "AUX3"]

  # ── Volume (per zone 1-4) ──

  set_volume:
    label: Set Zone Volume
    send: "VOUT{zone} {level}\r"
    help: "Set the volume on a zone in dB. Range -90 to +10."
    params:
      zone:
        type: child_id
        child_type: zone
        required: true
        label: Zone
      level:
        type: integer
        required: true
        label: Volume (dB)
        min: -90
        max: 10

  volume_up:
    label: Volume Up (1 dB)
    send: "VOUT{zone} +\r"
    params:
      zone:
        type: child_id
        child_type: zone
        required: true
        label: Zone

  volume_down:
    label: Volume Down (1 dB)
    send: "VOUT{zone} -\r"
    params:
      zone:
        type: child_id
        child_type: zone
        required: true
        label: Zone

  query_volume:
    label: Query Zone Volume
    send: "VOUT{zone} sta\r"
    params:
      zone:
        type: child_id
        child_type: zone
        required: true
        label: Zone

  # ── Mute (per zone 1-4) ──

  mute_on:
    label: Mute Zone
    send: "VOUTMute{zone} on\r"
    params:
      zone:
        type: child_id
        child_type: zone
        required: true
        label: Zone

  mute_off:
    label: Unmute Zone
    send: "VOUTMute{zone} off\r"
    params:
      zone:
        type: child_id
        child_type: zone
        required: true
        label: Zone

  query_mute:
    label: Query Zone Mute
    send: "VOUTMute{zone} sta\r"
    params:
      zone:
        type: child_id
        child_type: zone
        required: true
        label: Zone

  # ── Mono / Stereo (analog only) ──

  mono_on:
    label: Set Analog Output Mono
    send: "SetMono{output} on\r"
    params:
      output:
        type: child_id
        child_type: analog_out
        required: true
        label: Analog Output

  mono_off:
    label: Set Analog Output Stereo
    send: "SetMono{output} off\r"
    params:
      output:
        type: child_id
        child_type: analog_out
        required: true
        label: Analog Output

  # ── Input signal detection ──

  query_input_signal:
    label: Query Input Signal Status
    send: "InputStatus{input}\r"
    help: "Check whether a source is presenting signal on the specified input (1-6)."
    params:
      input:
        type: child_id
        child_type: input
        required: true
        label: Input

  # ── USB switching ──

  set_usb_mode:
    label: Set USB Switching Mode
    send: "UsbMode {mode}\r"
    help: "0 = Follow USB, 1 = Manual, 2 = Follow Video."
    params:
      mode:
        type: integer
        required: true
        label: Mode
        min: 0
        max: 2

  set_usb_route:
    label: Set USB Host Source
    send: "UsbRoute {source}\r"
    help: "USB host port: 1-2 local, 3 HDBaseT Out, 4 USB-C, 5-6 HDBaseT In 1/2."
    params:
      source:
        type: integer
        required: true
        label: USB Source
        min: 1
        max: 6

  # ── Front panel ──

  lock_panel:
    label: Lock Front Panel
    send: "Lock\r"
    help: "Disables the front-panel buttons."

  unlock_panel:
    label: Unlock Front Panel
    send: "Unlock\r"

  blink_on:
    label: Blink (Identify) — On
    send: "Blink on\r"
    help: "Flash the front-panel POWER LED to physically locate this unit."

  blink_off:
    label: Blink (Identify) — Off
    send: "Blink off\r"

  # ── System ──

  query_model:
    label: Query Model
    send: "Type\r"

  query_firmware:
    label: Query Firmware
    send: "Version\r"

  factory_reset:
    label: Factory Reset
    send: "Mreset\r"
    help: "WARNING: resets all settings to default and reboots. There is no feedback during the reboot."

# Quick actions — promote the high-use routing / identify / panel-lock
# commands to the device card. The PS62 has no power command (it is a
# switcher, not a display), so there is nothing to promote there.
actions:
  - id: route
    icon: route
  - id: route_all
    icon: copy
  - id: route_reset
    icon: rotate-ccw
  - id: blink_on
    icon: search
  - id: lock_panel
    icon: lock
  - id: unlock_panel
    icon: unlock

responses:

  # Routing — Status returns "x?AVx1, x?AVx2" on a single line. The combined
  # regex must come first (first-match-wins) and fans into both output
  # children with literal ids. The per-echo form below captures the output
  # number as the child id.
  - match: '^x(\d+)AVx1,\s*x(\d+)AVx2$'
    child_set:
      - { type: output, id: 1, state: { input: "$1" } }
      - { type: output, id: 2, state: { input: "$2" } }
  - match: '^x(\d+)AVx([12])$'
    child_set:
      - { type: output, id: "$2", state: { input: "$1" } }

  # Audio source routing echo/status: "AUD1 HDMI", "AUD2 AUX3"
  - match: '^AUD([12])\s+(HDBaseT|HDMI|AUX[123])$'
    child_set:
      - { type: analog_out, id: "$1", state: { source: "$2" } }

  # Volume: "VOUT1 -20" (echoed after set, +/-, or sta)
  - match: '^VOUT([1-4])\s+(-?\d+)$'
    child_set:
      - { type: zone, id: "$1", state: { volume: "$2" } }

  # Mute: "VOUTMute1 on" / "VOUTMute1 off"
  - match: '^VOUTMute([1-4])\s+(on|off)$'
    child_set:
      - type: zone
        id: "$1"
        state:
          mute: { group: 2, map: { "on": "true", "off": "false" } }

  # Mono / stereo
  - match: '^SetMono([12])\s+(on|off)$'
    child_set:
      - type: analog_out
        id: "$1"
        state:
          mono: { group: 2, map: { "on": "true", "off": "false" } }

  # InputStatus N — feedback "InputStatus<N> 1" (signal) or " 0" (no signal).
  - match: '^InputStatus([1-6])\s+([01])$'
    child_set:
      - type: input
        id: "$1"
        state:
          signal: { group: 2, map: { "1": "true", "0": "false" } }

  # USB
  - match: '^UsbMode\s+(\d+)$'
    set: { usb_mode: "$1" }
  - match: '^UsbRoute\s+(\d+)$'
    set: { usb_route: "$1" }

  # Front panel lock state — Lock and Unlock echo their own command.
  - match: '^Lock$'
    set: { front_panel_locked: "true" }
  - match: '^Unlock$'
    set: { front_panel_locked: "false" }

  # Type → "AT-OME-PS62"
  - match: '^(AT-OME-\S+)$'
    set: { model: "$1" }

  # Version → "1.0.00"
  - match: '^(\d+\.\d+\.\d+)$'
    set: { firmware: "$1" }

polling:
  queries:
    - "Status\r"
    - "Type\r"
    - "Version\r"
    - { each_child: analog_out, send: "AUD{child_id} sta\r" }
    - { each_child: zone, send: "VOUT{child_id} sta\r" }
    - { each_child: zone, send: "VOUTMute{child_id} sta\r" }
    - { each_child: input, send: "InputStatus{child_id}\r" }

# ── SIMULATOR DEFINITION ──
simulator:
  push_state: false
  initial_state:
    model: "AT-OME-PS62"
    firmware: "1.2.1"
    front_panel_locked: false
    route_1: 1
    route_2: 2
    audio_1: "HDBaseT"
    audio_2: "HDMI"
    volume_1: 0
    volume_2: 0
    volume_3: -10
    volume_4: -10
    mute_1: false
    mute_2: false
    mute_3: false
    mute_4: false
    mono_1: false
    mono_2: false
    input_signal_1: true
    input_signal_2: true
    input_signal_3: false
    input_signal_4: false
    input_signal_5: false
    input_signal_6: false
    usb_mode: 0
    usb_route: 1

  delays:
    command_response: 0.05

  controls:
    - type: matrix
      label: Video Routing
      inputs: 6
      outputs: 2
      state_pattern: "route_{output}"
    - type: indicator
      key: model
      label: Model
    - type: indicator
      key: firmware
      label: Firmware
    - type: toggle
      key: front_panel_locked
      label: Panel Lock
    - type: slider
      key: volume_1
      label: Zone 1 Volume
      min: -90
      max: 10
    - type: slider
      key: volume_3
      label: Zone 3 (Analog 1) Volume
      min: -90
      max: 10
    - type: toggle
      key: mute_1
      label: Zone 1 Mute
    - type: toggle
      key: mute_3
      label: Zone 3 Mute
    - type: indicator
      key: input_signal_1
      label: In 1 Signal
    - type: indicator
      key: input_signal_5
      label: In 5 Signal

  command_handlers:

    # ── Routing: xNAVxM (single output) ──
    - match: '^x(\d+)AVx(\d+)$'
      handler: |
        inp = int(match.group(1))
        out = int(match.group(2))
        if 1 <= inp <= 6 and 1 <= out <= 2:
            state[f"route_{out}"] = inp
            respond(f"x{inp}AVx{out}\r\n")
        else:
            respond("Command FAILED\r\n")

    # ── Routing: xNAll ──
    - match: '^x(\d+)All$'
      handler: |
        inp = int(match.group(1))
        if 1 <= inp <= 6:
            state["route_1"] = inp
            state["route_2"] = inp
            respond(f"x{inp}AVx1, x{inp}AVx2\r\n")
        else:
            respond("Command FAILED\r\n")

    # ── Reset to 1-to-1 ──
    - match: '^All#$'
      handler: |
        state["route_1"] = 1
        state["route_2"] = 2
        respond("x1AVx1, x2AVx2\r\n")

    # ── Status (full dump) ──
    - match: '^Status$'
      handler: |
        r1 = state.get("route_1", 1)
        r2 = state.get("route_2", 2)
        respond(f"x{r1}AVx1, x{r2}AVx2\r\n")

    # ── Audio source routing: AUDX Y ──
    - match: '^AUD([12])\s+(HDBaseT|HDMI|AUX[123])$'
      handler: |
        out = match.group(1)
        src = match.group(2)
        state[f"audio_{out}"] = src
        respond(f"AUD{out} {src}\r\n")
    - match: '^AUD([12])\s+sta$'
      handler: |
        out = match.group(1)
        cur = state.get(f"audio_{out}", "HDBaseT")
        respond(f"AUD{out} {cur}\r\n")

    # ── Volume: VOUTX Y ──
    - match: '^VOUT([1234])\s+(\S+)$'
      handler: |
        zone = match.group(1)
        val = match.group(2)
        key = f"volume_{zone}"
        cur = state.get(key, 0)
        if val == "sta":
            respond(f"VOUT{zone} {cur}\r\n")
        elif val in ("+", "-"):
            new = max(-90, min(10, cur + (1 if val == "+" else -1)))
            state[key] = new
            respond(f"VOUT{zone} {new}\r\n")
        else:
            try:
                level = max(-90, min(10, int(val)))
                state[key] = level
                respond(f"VOUT{zone} {level}\r\n")
            except ValueError:
                respond("Command FAILED\r\n")

    # ── Mute: VOUTMuteX Y ──
    - match: '^VOUTMute([1234])\s+(on|off|sta)$'
      handler: |
        zone = match.group(1)
        val = match.group(2)
        key = f"mute_{zone}"
        if val == "sta":
            cur = "on" if state.get(key, False) else "off"
            respond(f"VOUTMute{zone} {cur}\r\n")
        else:
            state[key] = (val == "on")
            respond(f"VOUTMute{zone} {val}\r\n")

    # ── Mono / Stereo ──
    - match: '^SetMono([12])\s+(on|off|sta)$'
      handler: |
        out = match.group(1)
        val = match.group(2)
        key = f"mono_{out}"
        if val == "sta":
            cur = "on" if state.get(key, False) else "off"
            respond(f"SetMono{out} {cur}\r\n")
        else:
            state[key] = (val == "on")
            respond(f"SetMono{out} {val}\r\n")

    # ── InputStatus N (signal detection) ──
    - match: '^InputStatus([1-6])$'
      handler: |
        inp = match.group(1)
        cur = state.get(f"input_signal_{inp}", False)
        respond(f"InputStatus{inp} {1 if cur else 0}\r\n")
    - match: '^InputStatus$'
      handler: |
        # All-input rollup: doc shows "InputStatus 01" — pad to six digits.
        bits = "".join("1" if state.get(f"input_signal_{i}", False) else "0" for i in range(1, 7))
        respond(f"InputStatus {bits}\r\n")

    # ── USB ──
    - match: '^UsbMode\s+([012])$'
      handler: |
        m = int(match.group(1))
        state["usb_mode"] = m
        respond(f"UsbMode {m}\r\n")
    - match: '^UsbMode\s+sta$'
      handler: |
        respond(f"UsbMode {state.get('usb_mode', 0)}\r\n")
    - match: '^UsbRoute\s+([1-6])$'
      handler: |
        r = int(match.group(1))
        state["usb_route"] = r
        respond(f"UsbRoute {r}\r\n")
    - match: '^UsbRoute\s+sta$'
      handler: |
        respond(f"UsbRoute {state.get('usb_route', 1)}\r\n")

    # ── Front panel lock ──
    - match: '^Lock$'
      handler: |
        state["front_panel_locked"] = True
        respond("Lock\r\n")
    - match: '^Unlock$'
      handler: |
        state["front_panel_locked"] = False
        respond("Unlock\r\n")

    # ── Blink (POWER LED identify) ──
    - match: '^Blink\s+(on|off|sta)$'
      handler: |
        respond(f"Blink {match.group(1)}\r\n")

    # ── Type / Version ──
    - match: '^Type$'
      handler: |
        respond(f"{state.get('model', 'AT-OME-PS62')}\r\n")
    - match: '^Version$'
      handler: |
        respond(f"{state.get('firmware', '1.2.1')}\r\n")

    # ── Factory reset (no feedback per doc) ──
    - match: '^Mreset$'
      handler: |
        # In the simulator, just acknowledge silently — the doc says no feedback.
        pass

    # ── IPCFG (multi-line response — best-effort) ──
    - match: '^IPCFG$'
      handler: |
        respond("IP Addr 192.168.11.196\r\nNetmask 255.255.255.0\r\nGateway 192.168.11.1\r\ntelnet Port 23\r\nssh Port: 22\r\n")

    # ── CommaWait / Blink sta / RepeatCmd / RS232para / IPDHCP / IPStatic
    #     — return a benign echo so polling doesn't trip. ──
    - match: '^(CommaWait|RepeatCmd|RepCmdTime|IPDHCP)\s+(on|off|sta|\d+)$'
      handler: |
        respond(f"{match.group(1)} {match.group(2)}\r\n")

    # Catch-all — must stay last (script form so it sits in _script_handlers
    # after the specific entries above; see rules.md).
    - match: '.+'
      handler: |
        respond("Command FAILED\r\n")

  error_modes:
    communication_timeout:
      description: "Device stops responding to commands"
      behavior: no_response
    auth_required:
      description: "Telnet Login Mode is enabled and credentials were not supplied"
      behavior: no_response
