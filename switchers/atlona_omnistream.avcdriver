# Atlona OmniStream Driver
#
# Controls Atlona OmniStream Pro, R-Type, and Wallplate AV-over-IP
# encoders/decoders over TCP (Telnet, port 23).
#
# Models covered (firmware 2.0+):
#   AT-OMNI-111, AT-OMNI-111WP   1-channel encoder (Pro / Wallplate)
#   AT-OMNI-112                  2-channel encoder (Pro)
#   AT-OMNI-121                  1-channel decoder (Pro)
#   AT-OMNI-122                  2-channel decoder (Pro)
#   AT-OMNI-512                  4-channel encoder (Pro)
#   AT-OMNI-521                  Single-channel decoder (Pro)
#
# Protocol reference: Atlona OmniStream CLI Command Set + JSON over WebSocket
#                     (Version 15, May 2023, firmware 2.0)
# https://atlona.com/pdf/OmniStream_CLI-JSON_API.pdf
#
# Command format: <Command><index><space><value><CR>     (CR = 0x0d)
# Feedback:       <Command><index> <value> set<CR><LF>   (after a set)
#                 <Command><index> <value><CR><LF>       (after a query)
#                 ! Command not found<CR><LF>            (on error)
# Inter-command:  500 ms minimum between commands
# Status query:   pass `sta` as the value parameter to read current state
#
# Notes:
#   - Some commands are Pro-only (audio mute / volume / input, AnalogPower,
#     DisplayBtn, VolumeBtn, InputBtn). On R-Type units these return
#     "! Command not found" — the driver simply ignores the error.
#   - VideoInput uses string stream names like "ip_input3" (configured on
#     the device's web UI), not integer indices.
#   - HDCPSet uses "HDMI1" / "HDMI2" identifiers, not bare integers.
#   - This driver covers runtime control. Install-time setup (IP config,
#     multicast addresses, EDID, encoder bit rate, FEC, scrambling) is
#     left to the device's web UI by design.
#   - When IPLogin is enabled, the device prompts "Login: " then "Password: "
#     before accepting commands. The driver handles this via the auth: block
#     below — supply Username and Password in the Add Device dialog. Leave
#     them blank to skip the handshake (when IPLogin is disabled on the unit).

id: atlona_omnistream
name: Atlona OmniStream
manufacturer: Atlona
category: switcher
version: 1.5.0
author: OpenAVC
min_platform_version: "0.22.0"
description: >
  Controls Atlona OmniStream Pro, R-Type, and Wallplate AV-over-IP
  encoders and decoders via the Telnet CLI (port 23). Each HDMI output
  is a child entity tracking its active video/audio source and status,
  audio mute/volume, analog speaker power, and HDCP version. Supports
  source routing, video enable, and CEC/RS-232 display triggers.
  Runtime control surface only — install-time setup is configured in
  the device's web UI.

source_url: https://atlona.com/pdf/OmniStream_CLI-JSON_API.pdf
tags: [av-over-ip, encoder, decoder, omnistream, telnet]
verified: false
simulated: true
protocols: [atlona_omnistream]
ports: [23, 2323, 22]
compatible_models:
  - manufacturer: Atlona
    models:
      - AT-OMNI-111
      - AT-OMNI-111WP
      - AT-OMNI-112
      - AT-OMNI-121
      - AT-OMNI-122
      - AT-OMNI-512
      - AT-OMNI-521
    confidence: untested
    notes: >
      All OmniStream Pro, R-Type, and Wallplate models on firmware 2.0+.
      Some audio commands (mute, volume, AudioInput, AnalogPower,
      DisplayBtn, VolumeBtn, InputBtn) are Pro-only and silently no-op
      on R-Type units.

transport: tcp
delimiter: "\r\n"

help:
  overview: >
    Atlona OmniStream is an AV-over-IP encoder/decoder system. Encoders
    take HDMI sources and produce network streams; decoders pick a stream
    and output HDMI to a display. Routing happens by setting which IP
    stream each decoder receives (the VideoInput command).
  setup: >
    1. Set a static IP on the OmniStream unit via its web UI.
    2. If Telnet login authentication (IPLogin) is enabled on the device,
       enter the unit's Username and Password in this driver's config —
       the driver will handle the "Login:" / "Password:" handshake. Leave
       both blank if IPLogin is disabled.
    3. Configure encoder sessions (multicast addresses, video format)
       and decoder IP inputs in the web UI before driver use.
    4. Connect this driver to port 23. The HDMI output index ranges
       1..2 on most decoders; the session index ranges 1..6.
    5. Volume range is 0..15 (Atlona's native scale).
    6. To route a source: send the "Set Video Input" command with the
       output number and the IP input name (e.g. "ip_input3") configured
       on the decoder's web UI.

discovery:
  # Atlona OmniStream encoders/decoders use mDNS for AMS auto-
  # discovery (KB01143 confirms UDP 5353), but the literal service
  # type PTR string is not published in OmniStream's IT Deployment
  # Guide or any third-party integrator module. RTI / khimo modules
  # address devices by IP, not service browse. Hint-only via OUI +
  # manufacturer alias.
  oui:
    - "b8:98:b0"
  manufacturer_alias:
    - "atlona"
    - "omnistream"

default_config:
  host: ""
  port: 23
  username: ""
  password: ""
  output_count: 2
  poll_interval: 30
  inter_command_delay: 0.5

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 23
    label: Telnet Port
    description: "23 (with NVT), 2323 (without NVT). SSH (22) not supported by this driver."
  username:
    type: string
    default: ""
    label: Username
    description: "Telnet username when IPLogin is enabled. Leave blank if IPLogin is disabled."
  password:
    type: string
    default: ""
    label: Password
    secret: true
    description: "Telnet password when IPLogin is enabled."
  output_count:
    type: integer
    default: 2
    min: 0
    label: HDMI Output Count
    description: >
      Number of HDMI outputs — each becomes an HDMI Output child with
      active source/status, audio, analog power, and HDCP state. 2 covers
      dual-output decoders (OMNI-122); set 1 for single-output units.
  poll_interval:
    type: integer
    default: 30
    min: 0
    label: Poll Interval (sec)
    description: "Set to 0 to disable polling."
  inter_command_delay:
    type: number
    default: 0.5
    min: 0.5
    label: Inter-Command Delay (sec)
    description: "Atlona requires at least 500 ms between commands."

auth:
  type: telnet_login
  username_prompt: "Login: "
  password_prompt: "Password: "
  username_field: username
  password_field: password
  skip_if_empty: true
  timeout_seconds: 10
  line_ending: "\r\n"

state_variables:
  device_type:
    type: string
    label: Device Type
    help: "Device model identifier reported by the `Type` command."
  firmware:
    type: string
    label: Firmware Version
    help: "Firmware version string reported by the `Version` command."
  temperature_c:
    type: number
    label: System Temperature (°C)
    help: "Internal system temperature in °C, reported by `Temperature`."

child_entity_types:
  output:
    label: HDMI Output
    label_plural: HDMI Outputs
    id_format: { type: integer, min: 1, max: 8 }
    state_variables:
      video_input:
        type: string
        label: Active Video Input
        help: "Name of the IP video source currently active on this output (VideoActiveInput — reflects failover, not just the configured primary)."
        cloud_priority: high
      video_status:
        type: string
        label: Video Status
        help: "Video pipeline status text (Active / Inactive / No Signal)."
        cloud_priority: high
      audio_input:
        type: string
        label: Active Audio Input
        help: "Name of the IP audio source currently active on this output."
      audio_status:
        type: string
        label: Audio Status
        help: "Audio pipeline status text."
      audio_mute:
        type: boolean
        label: Audio Muted
        help: "True when this output's audio is muted (Pro units)."
      audio_volume:
        type: integer
        label: Audio Volume
        help: "Audio volume on this output, 0-15 (Pro units)."
      analog_power:
        type: boolean
        label: Analog Speaker Power
        help: "True when the analog speaker amplifier for this output is powered on (Pro units)."
      hdcp:
        type: string
        label: HDCP Version
        help: "HDCP version set on this HDMI port (1.4 / 2.2 / none; HDCPSet sta read-back)."
    summary_fields: [video_input, video_status]
    instances:
      count_from: output_count
      label: "HDMI Out {id}"

commands:

  # ── Universal commands ──

  identify:
    label: Identify (Flash LEDs)
    send: "Identify\r"
    help: "Flash the front-panel LEDs for 10 seconds to physically locate this unit."

  reboot:
    label: Reboot
    send: "Reboot\r"
    help: "Reboot the OmniStream unit."

  # ── Video routing (decoder side) ──

  set_video_input:
    label: Route Video Source to Output
    send: "VideoInput{output} {ip_input}\r"
    help: >
      Route a video source (named IP input) to an HDMI output on the decoder.
      The IP input name (e.g. "ip_input3") must be configured in the device's
      web UI before use.
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output
      ip_input:
        # The VideoInput Y value is a fixed, documented set: ip_input1..16
        # plus notused / generator / multiview (CLI API §VideoInput). Offered
        # as a picker so the integrator selects instead of free-typing an
        # ip_input name they can misspell. The runtime does NOT hard-validate
        # enum membership (only numeric bounds + string patterns), so the field
        # stays forgiving — a specific multiview room name can still be typed.
        type: enum
        required: true
        label: IP Input
        values:
          - ip_input1
          - ip_input2
          - ip_input3
          - ip_input4
          - ip_input5
          - ip_input6
          - ip_input7
          - ip_input8
          - ip_input9
          - ip_input10
          - ip_input11
          - ip_input12
          - ip_input13
          - ip_input14
          - ip_input15
          - ip_input16
          - notused
          - generator
          - multiview
        description: >
          The decoder's IP input to route to this output. Pick an ip_input
          slot (configured in the device web UI), notused, generator, or
          multiview. To route a specific multiview room, type its name.

  set_video_enable:
    label: Set Video Output Enable
    send: "VideoEnable{session} {state}\r"
    help: "Enable or disable the video for the specified session."
    params:
      session:
        type: integer
        required: true
        default: 1
        min: 1
        max: 6
        label: Session
      state:
        type: string
        required: true
        choices: [on, off]
        label: State

  # ── Audio (Pro-only, no-op on R-Type) ──

  set_audio_mute:
    label: Set Audio Mute
    send: "AudioMute{output} {state}\r"
    help: "Mute or unmute audio on the specified HDMI output. Pro units only."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output
      state:
        type: string
        required: true
        choices: [on, off]
        label: Mute State

  set_audio_volume:
    label: Set Audio Volume
    send: "AudioVolume{output} {level}\r"
    help: "Set the audio volume on the specified HDMI output. Pro units only."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output
      level:
        type: integer
        required: true
        min: 0
        max: 15
        label: Volume (0–15)

  set_audio_input:
    label: Set Audio Input
    send: "AudioInput{output} {input}\r"
    help: "Set the audio input for the specified HDMI output. Pro units only."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output
      input:
        type: integer
        required: true
        min: 1
        max: 16
        label: Audio Input

  set_audio_source:
    label: Set HDMI Audio Source
    send: "AudioSource{session} {source}\r"
    help: "Set the HDMI audio source for the specified session."
    params:
      session:
        type: integer
        required: true
        default: 1
        min: 1
        max: 6
        label: Session
      source:
        type: integer
        required: true
        label: Audio Source

  set_audio_enable:
    label: Set Audio Output Enable
    send: "AudioEnable{session} {state}\r"
    help: "Enable or disable the audio for the specified session."
    params:
      session:
        type: integer
        required: true
        default: 1
        min: 1
        max: 6
        label: Session
      state:
        type: string
        required: true
        choices: [on, off]
        label: State

  audio_to_backup:
    label: Switch Audio to Backup
    send: "AudioToBackup{output}\r"
    help: "Promote the active audio input as the backup input."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output

  audio_to_primary:
    label: Switch Audio to Primary
    send: "AudioToPrimary{output}\r"
    help: "Promote the active audio input as the primary input."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output

  video_to_backup:
    label: Switch Video to Backup
    send: "VideoToBackup{output}\r"
    help: "Promote the active video input as the backup input."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output

  video_to_primary:
    label: Switch Video to Primary
    send: "VideoToPrimary{output}\r"
    help: "Promote the active video input as the primary input."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output

  # ── Display / power triggers (decoder side) ──

  set_analog_power:
    label: Set Analog Speaker Power
    send: "AnalogPowerEnable{output} {state}\r"
    help: >
      Enable or disable the analog speaker amplifier for the specified
      HDMI output. Pro units only.
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output
      state:
        type: string
        required: true
        choices: [on, off]
        label: Power

  set_hdcp:
    label: Set HDCP Version
    send: "HDCPSet{port} {version}\r"
    help: "Set the HDCP version for the specified HDMI input or output."
    params:
      port:
        type: string
        required: true
        default: HDMI1
        label: HDMI Port
        description: "HDMI1, HDMI2, etc."
      version:
        type: string
        required: true
        choices: ["1.4", "2.2", "none", "off"]
        label: HDCP Version

  press_display_button:
    label: Press Display Button
    send: "DisplayBtn{input} {action}\r"
    help: "Send a display power command (on/off/toggle) tied to the HDMI input. Pro units only."
    params:
      input:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Input
      action:
        type: string
        required: true
        choices: [on, off, toggle]
        label: Action

  press_input_button:
    label: Press Input Button
    send: "InputBtn {action}\r"
    help: "Emulate the front-panel INPUT button. Pro units only."
    params:
      action:
        type: string
        required: true
        default: tog
        choices: ["1", "2", "tog"]
        label: Action

  press_volume_button:
    label: Press Volume Button
    send: "VolumeBtn {direction}\r"
    help: "Send a volume up or down step (±1). Pro units only."
    params:
      direction:
        type: string
        required: true
        choices: [up, down]
        label: Direction

  trigger_cec:
    label: Trigger CEC Command
    send: "TrigCEC{output} {command}\r"
    help: "Send a stored CEC command on the specified HDMI output."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: HDMI Output
      command:
        type: string
        required: true
        choices: [on, off, "vol+", "vol-"]
        label: CEC Command

  trigger_rs232:
    label: Trigger RS-232 Command
    send: "TrigRS232{port} {command}\r"
    help: "Send a stored RS-232 command on the specified RS-232 port."
    params:
      port:
        type: integer
        required: true
        default: 1
        min: 1
        max: 2
        label: RS-232 Port
      command:
        type: string
        required: true
        choices: [on, off, "vol+", "vol-"]
        label: RS-232 Command

# Quick actions — promote the high-use decoder controls (route a source,
# enable/disable video, mute audio, identify, reboot) to the device card.
actions:
  - id: set_video_input
    icon: route
  - id: set_video_enable
    icon: eye
  - id: set_audio_mute
    icon: volume-x
  - id: identify
    icon: search
  - id: reboot
    icon: power
    confirm: "Reboot this OmniStream unit? The stream drops while it restarts."

responses:

  # Type query: "at-omni-112"
  - match: '^(at-omni-\S+)'
    set: { device_type: "$1" }

  # Version query: free-form text — capture the first token after "Version"
  - match: '^Version\s+(\S+)'
    set: { firmware: "$1" }

  # Temperature: "System temperature: 114.80 F (46.00 C) Die temperature: ..."
  - match: 'System temperature:\s+[\d.]+\s+F\s+\(([\d.]+)\s+C\)'
    set: { temperature_c: "$1" }

  # Per-output active state. The VideoInput set-ack is deliberately NOT
  # parsed — the ack echoes the configured primary, while video_input
  # mirrors VideoActiveInput (which reflects backup failover); the next
  # poll picks the route change up from the active query.
  - match: '^VideoActiveInput(\d+)\s+(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { video_input: "$2" } }
  - match: '^VideoActiveStatus(\d+)\s+(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { video_status: "$2" } }
  - match: '^AudioActiveInput(\d+)\s+(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { audio_input: "$2" } }
  - match: '^AudioActiveStatus(\d+)\s+(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { audio_status: "$2" } }

  # AudioMute<N> on|off — the "sta" answer has no suffix, the set-ack
  # appends " set"; one rule covers both.
  - match: '^AudioMute(\d+)\s+(on|off)(?:\s+set)?$'
    child_set:
      - type: output
        id: "$1"
        state:
          audio_mute: { group: 2, map: { "on": "true", "off": "false" } }

  # AudioVolume<N> <level>[ set]
  - match: '^AudioVolume(\d+)\s+(\d+)(?:\s+set)?$'
    child_set:
      - { type: output, id: "$1", state: { audio_volume: "$2" } }

  # Analog speaker power — status query answers active/inactive; the
  # AnalogPowerEnable set-ack answers on/off + " set".
  - match: '^AnalogPowerStatus(\d+)\s+(active|inactive)$'
    child_set:
      - type: output
        id: "$1"
        state:
          analog_power: { group: 2, map: { "active": "true", "inactive": "false" } }
  - match: '^AnalogPowerEnable(\d+)\s+(on|off)(?:\s+set)?$'
    child_set:
      - type: output
        id: "$1"
        state:
          analog_power: { group: 2, map: { "on": "true", "off": "false" } }

  # HDCP version per HDMI port: "HDCPSet HDMI1 2.2 set" (ack) or
  # "HDCPSet HDMI1 2.2" (sta answer). The space after HDCPSet is optional
  # (the CLI accepts and some firmware echoes the compact form).
  - match: '^HDCPSet\s*HDMI(\d+)\s+(\S+?)(?:\s+set)?$'
    child_set:
      - { type: output, id: "$1", state: { hdcp: "$2" } }

polling:
  queries:
    - "Type\r"
    - "Version\r"
    - "Temperature\r"
    # Per-output state — roster-gated (output_count).
    - { each_child: output, send: "VideoActiveInput{child_id}\r" }
    - { each_child: output, send: "VideoActiveStatus{child_id}\r" }
    - { each_child: output, send: "AudioActiveInput{child_id}\r" }
    - { each_child: output, send: "AudioActiveStatus{child_id}\r" }
    - { each_child: output, send: "AudioMute{child_id} sta\r" }
    - { each_child: output, send: "AudioVolume{child_id} sta\r" }
    - { each_child: output, send: "AnalogPowerStatus{child_id}\r" }
    - { each_child: output, send: "HDCPSet HDMI{child_id} sta\r" }

# ── SIMULATOR DEFINITION ──
simulator:
  push_state: true
  initial_state:
    device_type: "at-omni-122"
    firmware: "2.0.6"
    temperature_c: 46.0
    video_active_input_1: "ip_input1"
    video_active_input_2: "ip_input2"
    video_active_status_1: "active"
    video_active_status_2: "active"
    audio_active_input_1: "1"
    audio_active_input_2: "2"
    audio_active_status_1: "Active"
    audio_active_status_2: "Active"
    audio_mute_1: false
    audio_mute_2: false
    audio_volume_1: 8
    audio_volume_2: 8
    analog_power_1: true
    analog_power_2: true
    hdcp_1: "2.2"
    hdcp_2: "1.4"

  delays:
    command_response: 0.05

  controls:
    - type: indicator
      key: device_type
      label: Device Type
    - type: indicator
      key: firmware
      label: Firmware
    - type: indicator
      key: temperature_c
      label: Temperature (°C)
    - type: indicator
      key: video_active_input_1
      label: Out 1 Source
    - type: indicator
      key: video_active_input_2
      label: Out 2 Source
    - type: indicator
      key: video_active_status_1
      label: Out 1 Video
    - type: indicator
      key: video_active_status_2
      label: Out 2 Video
    - type: toggle
      key: audio_mute_1
      label: Out 1 Mute
    - type: toggle
      key: audio_mute_2
      label: Out 2 Mute
    - type: slider
      key: audio_volume_1
      label: Out 1 Volume
      min: 0
      max: 15
    - type: slider
      key: audio_volume_2
      label: Out 2 Volume
      min: 0
      max: 15
    - type: toggle
      key: analog_power_1
      label: Out 1 Analog Power
    - type: toggle
      key: analog_power_2
      label: Out 2 Analog Power

  command_handlers:

    # Identify, Reboot — no feedback per spec
    - match: '^Identify\s*$'
      handler: |
        respond("")
    - match: '^Reboot\s*$'
      handler: |
        respond("")

    # Type
    - match: '^Type\s*$'
      handler: |
        respond(f"{state['device_type']}\r\n")

    # Version (optional argument ignored in sim)
    - match: '^Version(?:\s+\S+)?\s*$'
      handler: |
        respond(f"Version {state['firmware']}\r\n")

    # Temperature
    - match: '^Temperature\s*$'
      handler: |
        c = state['temperature_c']
        f = round(c * 9 / 5 + 32, 2)
        respond(f"System temperature: {f} F ({c} C) Die temperature: {f + 33} F ({c + 18} C)\r\n")

    # VideoInput<N> <stream>  (set route)
    - match: '^VideoInput([12])\s+(\S+)\s*$'
      handler: |
        out = match.group(1)
        stream = match.group(2)
        if stream == "sta":
            respond(f"VideoInput{out} {state.get('video_active_input_' + out, 'ip_input1')}\r\n")
        else:
            state[f"video_active_input_{out}"] = stream
            state[f"video_active_status_{out}"] = "active"
            respond(f"VideoInput{out} {stream} set\r\n")

    # VideoActiveInput<N>, VideoActiveStatus<N>, AudioActiveInput<N>, AudioActiveStatus<N>
    - match: '^VideoActiveInput([12])\s*$'
      handler: |
        out = match.group(1)
        respond(f"VideoActiveInput{out} {state['video_active_input_' + out]}\r\n")
    - match: '^VideoActiveStatus([12])\s*$'
      handler: |
        out = match.group(1)
        respond(f"VideoActiveStatus{out} {state['video_active_status_' + out]}\r\n")
    - match: '^AudioActiveInput([12])\s*$'
      handler: |
        out = match.group(1)
        respond(f"AudioActiveInput{out} {state['audio_active_input_' + out]}\r\n")
    - match: '^AudioActiveStatus([12])\s*$'
      handler: |
        out = match.group(1)
        respond(f"AudioActiveStatus{out} {state['audio_active_status_' + out]}\r\n")

    # AudioMute<N> on|off|sta
    - match: '^AudioMute([12])\s+(on|off|sta)\s*$'
      handler: |
        out = match.group(1)
        val = match.group(2)
        if val == "sta":
            current = "on" if state[f'audio_mute_{out}'] else "off"
            respond(f"AudioMute{out} {current}\r\n")
        else:
            state[f"audio_mute_{out}"] = (val == "on")
            respond(f"AudioMute{out} {val} set\r\n")

    # AudioVolume<N> <level>|sta
    - match: '^AudioVolume([12])\s+(\S+)\s*$'
      handler: |
        out = match.group(1)
        val = match.group(2)
        if val == "sta":
            respond(f"AudioVolume{out} {state[f'audio_volume_{out}']}\r\n")
        else:
            try:
                level = max(0, min(15, int(val)))
                state[f"audio_volume_{out}"] = level
                respond(f"AudioVolume{out} {level} set\r\n")
            except ValueError:
                respond("! Command not found\r\n")

    # AudioInput<N> <input>|sta
    - match: '^AudioInput([12])\s+(\S+)\s*$'
      handler: |
        out = match.group(1)
        val = match.group(2)
        if val == "sta":
            respond(f"AudioInput{out} {state[f'audio_active_input_{out}']}\r\n")
        else:
            state[f"audio_active_input_{out}"] = val
            respond(f"AudioInput{out} {val} set\r\n")

    # AudioSource<N> <src>
    - match: '^AudioSource(\d+)\s+(\S+)\s*$'
      handler: |
        s = match.group(1)
        v = match.group(2)
        respond(f"AudioSource{s} {v} set\r\n")

    # AudioEnable<N>, VideoEnable<N>
    - match: '^(Audio|Video)Enable(\d+)\s+(on|off|sta)\s*$'
      handler: |
        kind = match.group(1)
        s = match.group(2)
        v = match.group(3)
        if v == "sta":
            respond(f"{kind}Enable{s} on\r\n")
        else:
            respond(f"{kind}Enable{s} {v} set\r\n")

    # AudioToBackup, AudioToPrimary, VideoToBackup, VideoToPrimary
    - match: '^(Audio|Video)To(Backup|Primary)([12])\s*$'
      handler: |
        kind = match.group(1)
        which = match.group(2)
        out = match.group(3)
        respond(f"{kind}To{which}{out} set\r\n")

    # AnalogPowerEnable<N> on|off|sta
    - match: '^AnalogPowerEnable([12])\s+(on|off|sta)\s*$'
      handler: |
        out = match.group(1)
        val = match.group(2)
        if val == "sta":
            respond(f"AnalogPowerEnable{out} {'on' if state[f'analog_power_{out}'] else 'off'}\r\n")
        else:
            state[f"analog_power_{out}"] = (val == "on")
            respond(f"AnalogPowerEnable{out} {val} set\r\n")

    # AnalogPowerStatus<N>
    - match: '^AnalogPowerStatus([12])\s*$'
      handler: |
        out = match.group(1)
        respond(f"AnalogPowerStatus{out} {'active' if state[f'analog_power_{out}'] else 'inactive'}\r\n")

    # HDCPSet HDMI<N> <ver>|sta — sta answers the current value (no "set"
    # suffix); a set stores and acks with " set".
    - match: '^HDCPSet\s*HDMI(\d+)\s+(\S+)\s*$'
      handler: |
        port = match.group(1)
        ver = match.group(2)
        key = f"hdcp_{port}"
        if key not in state:
            respond("! Command not found\r\n")
        elif ver == "sta":
            respond(f"HDCPSet HDMI{port} {state[key]}\r\n")
        else:
            state[key] = ver
            respond(f"HDCPSet HDMI{port} {ver} set\r\n")

    # DisplayBtn<N> on|off|toggle
    - match: '^DisplayBtn([12])\s+(on|off|toggle)\s*$'
      handler: |
        i = match.group(1)
        v = match.group(2)
        respond(f"DisplayBtn{i} {v} set\r\n")

    # InputBtn 1|2|tog
    - match: '^InputBtn\s+(1|2|tog)\s*$'
      handler: |
        v = match.group(1)
        respond(f"InputBtn {v} set\r\n")

    # VolumeBtn up|down
    - match: '^VolumeBtn\s+(up|down)\s*$'
      handler: |
        d = match.group(1)
        for out in (1, 2):
            cur = state.get(f'audio_volume_{out}', 8)
            state[f'audio_volume_{out}'] = max(0, min(15, cur + (1 if d == 'up' else -1)))
        respond(f"VolumeBtn {d} set\r\n")

    # TrigCEC<N> <cmd>
    - match: '^TrigCEC([12])\s+(\S+)\s*$'
      handler: |
        out = match.group(1)
        v = match.group(2)
        respond(f"TrigCEC{out} {v} set\r\n")

    # TrigRS232<N> <cmd>
    - match: '^TrigRS232(\d+)\s+(\S+)\s*$'
      handler: |
        port = match.group(1)
        v = match.group(2)
        respond(f"TrigRS232{port} {v} set\r\n")

    # Catch-all unknown command — must stay last
    - match: '.+'
      handler: |
        respond("! Command not found\r\n")

  error_modes:
    communication_timeout:
      description: "Device stops responding to commands"
      behavior: no_response
    auth_required:
      description: "IPLogin enabled — device requires Telnet authentication"
      behavior: no_response
