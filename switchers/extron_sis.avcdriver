# Extron SIS (Simple Instruction Set) Protocol Driver
#
# Controls Extron products over TCP (port 23) or RS-232 (9600 8N1).
# Covers 200+ products: crosspoint matrix switchers, presentation switchers,
# scalers, distribution amplifiers, and DSPs.
#
# Protocol reference: Extron SIS Command/Response Reference
# https://www.extron.com/article/sisseries
#
# Command format: <command><CR> or <command><LF>
# Response format: varies by command, terminated with CR+LF
#
# Common across all SIS devices:
#   {input}*{output}!  — Route input to output (tie)
#   {input}!           — Route input to all outputs
#   {level}*{channel}V — Set volume level on channel
#   {channel}*{state}Z — Set mute (0=unmute, 1=mute)
#   0!                 — Query current input routing
#   V                  — Query volume
#   Z                  — Query mute
#   I                  — Query input status
#   *Q                 — Query firmware version
#   33*1I              — Query signal presence on input 1 (DTP/DXP)

id: extron_sis
name: Extron SIS Protocol
manufacturer: Extron
category: switcher
version: 1.4.3
author: OpenAVC
description: >
  Controls Extron products via the SIS (Simple Instruction Set) protocol.
  Covers crosspoint matrix switchers (DXP, CrossPoint), presentation
  switchers (IN Series), scalers (DSC, DVS), distribution amplifiers,
  and DSP products. Works over TCP (port 23) or RS-232 (9600 8N1).

source_url: https://www.extron.com/article/sisseries
tags: [matrix-switcher, scaler, distribution-amplifier, sis, generic]
verified: false
simulated: true
protocols: [extron_sis]
ports: [23]
compatible_models:
  - manufacturer: Extron
    models:
      - DXP Series matrix switchers
      - CrossPoint Series matrix switchers
      - IN Series presentation switchers
      - DSC Series scalers
      - DVS Series scalers
      - DTP Series transmitters and receivers
      - DA Series distribution amplifiers
      - DMP Series DSPs
    confidence: untested
    notes: Any Extron product implementing the SIS protocol (~200 products).

transport: tcp
delimiter: "\r\n"

help:
  overview: >
    Universal control for Extron products using the SIS protocol. Works with
    200+ products including crosspoint matrix switchers, presentation switchers,
    scalers, distribution amplifiers, and DSPs.
  setup: >
    1. Connect the Extron device to the network or via RS-232 (9600 8N1).
    2. For TCP control, set the device's IP address and use port 23 (default).
    3. Extron recommends a 100ms delay between commands (pre-configured).

discovery:
  # Extron telnet (port 23) emits a copyright banner the moment the
  # socket opens — typical form:
  #   "(c) Copyright 2014, Extron Electronics, DXP HD 4K PLUS, V1.06"
  # The SIS verbose-mode-3 query (`\x1b3CV\r\n`) flushes the IAC
  # negotiation and elicits a `Vrb3` confirmation behind the banner so
  # the read picks up either signal.
  tcp_probe:
    port: 23
    send_ascii: "\x1b3CV\r\n"
    expect_regex: '(?:©|\(c\))[^\n]*?\d{4}[^\n]*?Extron\s+Electronics'
    extract_manufacturer: "Extron"
    extract:
      model:
        regex: '((?:DTP|IN|DXP|SW|MPS|SMP|XTP|SMD|DSP|IPL|MLC|NAV)[A-Za-z0-9 /.+-]+)'
      firmware:
        regex: 'V(\d+\.\d+(?:\.\d+)?)'
  oui:
    - "00:05:a6"

default_config:
  host: ""
  port: 23
  poll_interval: 10
  inter_command_delay: 0.1

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 23
    label: Port
  poll_interval:
    type: integer
    default: 10
    min: 0
    label: Poll Interval (sec)
  inter_command_delay:
    type: number
    default: 0.1
    label: Inter-Command Delay (sec)
    description: "Extron recommends 100ms between commands"

on_connect:
  - "\x1b3CV\r\n"

state_variables:
  input:
    type: integer
    label: Current Input
    help: "Input number currently routed to the active output."
  volume:
    type: integer
    label: Volume Level
    help: "Audio output volume on a 0–100 scale."
  mute:
    type: boolean
    label: Audio Mute
    help: "True when the audio output is muted."
  firmware:
    type: string
    label: Firmware Version
    help: "Firmware version string reported by the device."
  signal_active:
    type: boolean
    label: Signal Detected
    help: "True when the device detects a valid signal on the active input ('Sig1' / 'Sig0' notification)."

commands:
  route:
    label: Route Input to Output
    send: "{input}*{output}!"
    help: "Route a specific input to a specific output on the switcher."
    params:
      input:
        type: integer
        required: true
        label: Input Number
        min: 1
        help: "Source input number"
      output:
        type: integer
        required: true
        label: Output Number
        min: 1
        help: "Destination output number"

  route_all:
    label: Route Input to All Outputs
    send: "{input}!"
    help: "Route a single input to all outputs simultaneously."
    params:
      input:
        type: integer
        required: true
        label: Input Number
        min: 1

  set_volume:
    label: Set Volume
    send: "{level}V"
    help: "Set the audio volume level."
    params:
      level:
        type: integer
        required: true
        label: Volume Level
        min: 0
        max: 100
        help: "Volume level 0-100"

  mute_on:
    label: Mute Audio
    send: "1Z"
    help: "Mute the audio output."

  mute_off:
    label: Unmute Audio
    send: "0Z"
    help: "Unmute the audio output."

  mute_toggle:
    label: Toggle Mute
    send: "Z"
    help: "Toggle audio mute on/off."

  # Video mute (AV mute) - available on many SIS devices
  video_mute_on:
    label: Video Mute On
    send: "1B"
    help: "Blank the video output (audio continues)."

  video_mute_off:
    label: Video Mute Off
    send: "0B"
    help: "Restore the video output."

  recall_preset:
    label: Recall Preset
    send: "{preset}."
    help: "Recall a saved routing preset."
    params:
      preset:
        type: integer
        required: true
        label: Preset Number
        min: 1
        max: 32
        help: "Preset number 1-32"

  save_preset:
    label: Save Preset
    send: "{preset},."
    help: "Save the current routing configuration to a preset."
    params:
      preset:
        type: integer
        required: true
        label: Preset Number
        min: 1
        max: 32
        help: "Preset number 1-32"

responses:
  # Input routing response: "In1 All" or "In1 Out2"
  - match: 'In(\d+) All'
    set: { input: "$1" }
  - match: 'In(\d+) Out'
    set: { input: "$1" }

  # Volume response: "Vol50" or "Ds50"
  - match: 'Vol(\d+)'
    set: { volume: "$1" }
  - match: 'Ds(\d+)'
    set: { volume: "$1" }

  # Mute response: "Amt1" (muted) or "Amt0" (unmuted)
  - match: 'Amt1'
    set: { mute: "true" }
  - match: 'Amt0'
    set: { mute: "false" }

  # Firmware: "1.02.0001"
  - match: 'Ver(\S+)'
    set: { firmware: "$1" }

  # Signal presence (0=no signal, 1=signal)
  - match: 'Sig1'
    set: { signal_active: true }
  - match: 'Sig0'
    set: { signal_active: false }

polling:
  queries:
    - "I"
    - "V"
    - "Z"

# ── SIMULATOR DEFINITION ──
# Enhances auto-generated simulation with realistic behavior.
# Without this section, auto-gen still works (Level 0).
simulator:
  push_state: true
  initial_state:
    input: 1
    volume: 50
    mute: false
    firmware: "1.04"
    signal_active: true
    route_1: 1
    route_2: 1
    route_3: 1
    route_4: 1

  delays:
    command_response: 0.02   # 20ms — realistic for Extron SIS over TCP

  controls:
    - type: matrix
      label: Video Routing
      inputs: 8
      outputs: 4
      state_pattern: "route_{output}"
    - type: slider
      key: volume
      label: Volume
      min: 0
      max: 100
    - type: toggle
      key: mute
      label: Audio Mute
    - type: indicator
      key: signal_active
      label: Signal
      color_map:
        "true": "#22c55e"
        "false": "#6b7089"
    - type: indicator
      key: firmware
      label: Firmware

  notifications:
    input:
      '*': 'In{value} All'
    volume:
      '*': 'Vol{value}'
    mute:
      'true': 'Amt1'
      'false': 'Amt0'

  command_handlers:
    # Route input to specific output: {input}*{output}!
    - match: '(\d+)\*(\d+)!'
      handler: |
        inp = int(match.group(1))
        out = int(match.group(2))
        state["input"] = inp
        route_key = f"route_{out}"
        if route_key in state:
            state[route_key] = inp
        respond(f"In{inp} Out{out}\r\n")

    # Route input to all outputs: {input}!
    - match: '(\d+)!'
      handler: |
        inp = int(match.group(1))
        state["input"] = inp
        for i in range(1, 5):
            state[f"route_{i}"] = inp
        respond(f"In{inp} All\r\n")

    # Volume set: {level}V
    - match: '(\d+)V'
      handler: |
        level = int(match.group(1))
        state["volume"] = max(0, min(100, level))
        respond(f"Vol{state['volume']}\r\n")

    # Mute on/off: 1Z / 0Z
    - match: '([01])Z'
      handler: |
        state["mute"] = match.group(1) == "1"
        val = "1" if state["mute"] else "0"
        respond(f"Amt{val}\r\n")

    # Query input
    - match: 'I'
      handler: |
        respond(f"In{state['input']} All\r\n")

    # Query volume
    - match: 'V'
      handler: |
        respond(f"Vol{state['volume']}\r\n")

    # Query mute
    - match: 'Z'
      handler: |
        val = "1" if state["mute"] else "0"
        respond(f"Amt{val}\r\n")

    # Model name
    - receive: "N"
      respond: "SIS 1616\r\n"

    # Firmware query
    - receive: '\*Q'
      respond: "Ver{state.firmware}\r\n"

    # Preset recall/save
    - receive: '(\d+)\.'
      respond: "Rpr{1}\r\n"
    - receive: '(\d+),\.'
      respond: "Spr{1}\r\n"

  error_modes:
    communication_timeout:
      description: "Device stops responding to commands"
      behavior: no_response
    garbled_response:
      description: "Corrupted serial data on the wire"
      behavior: corrupt_response
