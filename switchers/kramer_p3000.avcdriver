# Kramer Protocol 3000 Driver
#
# Controls Kramer products over TCP (port 5000) or RS-232 (115200 8N1).
# Covers matrix switchers, scalers, distribution amplifiers, and
# Via wireless presentation systems.
#
# Protocol reference: Kramer Protocol 3000 Specification
# https://www.kramerav.com/support/protocols
#
# Command format: #<CMD> <PARAM1>,<PARAM2>,...<CR>
# Response format: ~<NN>@<CMD> <PARAM1>,<PARAM2>,...<CR><LF>
#   NN = machine number (01 by default)
#
# Notes:
#   - Commands are prefixed with # (request) or ~ (response)
#   - Machine number defaults to 01, configurable per device
#   - Error responses: ~NN@ERR <error_code><CR><LF>

id: kramer_p3000
name: Kramer Protocol 3000
manufacturer: Kramer
category: switcher
version: 1.3.3
author: OpenAVC
description: >
  Controls Kramer products via Protocol 3000 over TCP (port 5000).
  Covers matrix switchers (VS series), scalers (VP series),
  distribution amplifiers, and Via wireless presentation systems.

source_url: https://www.kramerav.com/support/protocols
tags: [matrix-switcher, scaler, wireless-presentation, generic]
verified: false
simulated: true
protocols: [kramer_p3000]
ports: [5000, 23]
compatible_models:
  - manufacturer: Kramer
    models:
      - VS Series matrix switchers
      - VM Series distribution amplifiers
      - VP Series scalers
      - Via wireless presentation systems
    confidence: untested
    notes: Any Kramer product implementing Protocol 3000.

transport: tcp
delimiter: "\r\n"

help:
  overview: >
    Controls Kramer matrix switchers, scalers, distribution amplifiers, and
    Via wireless presentation systems via Protocol 3000. Common in corporate
    AV, education, and houses of worship.
  setup: >
    1. Connect the switcher to the network via Ethernet.
    2. Set the IP address via the front panel menu or Kramer Network.
    3. Enter the IP address and port 5000 (default) in the device config.
    4. Machine number defaults to 01. Change it if multiple Kramer units
       share the same port.

discovery:
  # `#MODEL?` is the Protocol 3000 model query and returns a structured
  # `~NN@MODEL <model>` line. Some Kramer firmware also greets a
  # connection with a "Welcome to Kramer" banner; either form is enough
  # to identify the device.
  tcp_probe:
    port: 5000
    send_ascii: "#MODEL?\r\n"
    expect_regex: '~\d+@MODEL|Welcome to Kramer|Kramer\s+(?:P3K|Protocol)'
    extract_manufacturer: "Kramer"
    extract:
      model:
        regex: '~\d+@MODEL\s+(\S+)'
  oui:
    - "00:1d:56"

default_config:
  host: ""
  port: 5000
  machine_number: "01"
  poll_interval: 10

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 5000
    label: Port
  machine_number:
    type: string
    default: "01"
    label: Machine Number
    description: "01-99, used in Protocol 3000 responses"
  poll_interval:
    type: integer
    default: 10
    min: 0
    label: Poll Interval (sec)

state_variables:
  input:
    type: integer
    label: Current Input (Layer 1)
  output:
    type: integer
    label: Current Output (Layer 1)
  video_mute:
    type: boolean
    label: Video Mute
  audio_mute:
    type: boolean
    label: Audio Mute
  signal_present:
    type: boolean
    label: Signal Present

commands:
  route:
    label: Route Input to Output
    help: "Route an input to an output on a given layer (1=video, 2=audio)."
    send: "#ROUTE {layer},{output},{input}\r"
    params:
      input:
        type: integer
        required: true
        label: Input Number
        min: 1
      output:
        type: integer
        required: true
        label: Output Number
        min: 1
      layer:
        type: integer
        default: 1
        label: Layer (1=Video, 2=Audio)

  route_video:
    label: Route Video
    help: "Route a video input to an output."
    send: "#ROUTE 1,{output},{input}\r"
    params:
      input:
        type: integer
        required: true
        label: Input Number
      output:
        type: integer
        required: true
        label: Output Number

  route_audio:
    label: Route Audio
    help: "Route an audio input to an output."
    send: "#ROUTE 2,{output},{input}\r"
    params:
      input:
        type: integer
        required: true
        label: Input Number
      output:
        type: integer
        required: true
        label: Output Number

  video_mute_on:
    label: Video Mute On
    help: "Blank the video output."
    send: "#VMUTE 1,1\r"

  video_mute_off:
    label: Video Mute Off
    help: "Restore the video output."
    send: "#VMUTE 1,0\r"

  audio_mute_on:
    label: Audio Mute On
    help: "Mute audio output."
    send: "#MUTE 1,1\r"

  audio_mute_off:
    label: Audio Mute Off
    help: "Unmute audio output."
    send: "#MUTE 1,0\r"

  set_volume:
    label: Set Volume
    send: "#AUD-LVL 1,1,{level}\r"
    params:
      level:
        type: integer
        required: true
        label: Volume Level
        min: -100
        max: 15
        description: "Level in dB (-100 to +15)"

responses:
  # Route response: ~01@ROUTE 1,1,3  (layer 1, output 1, input 3)
  - match: '~\d+@ROUTE 1,\d+,(\d+)'
    set: { input: "$1" }

  # Video mute: ~01@VMUTE 1,1  (output 1, muted)
  - match: '~\d+@VMUTE 1,1'
    set: { video_mute: "true" }
  - match: '~\d+@VMUTE 1,0'
    set: { video_mute: "false" }

  # Audio mute: ~01@MUTE 1,1
  - match: '~\d+@MUTE 1,1'
    set: { audio_mute: "true" }
  - match: '~\d+@MUTE 1,0'
    set: { audio_mute: "false" }

  # Signal presence: ~01@SIGNAL 1,1  (input 1, signal present)
  - match: '~\d+@SIGNAL \d+,1'
    set: { signal_present: "true" }
  - match: '~\d+@SIGNAL \d+,0'
    set: { signal_present: "false" }

polling:
  queries:
    - "#ROUTE? 1,1\r"
    - "#VMUTE? 1\r"
    - "#MUTE? 1\r"
    - "#SIGNAL? 1\r"

# ── SIMULATOR DEFINITION ──

simulator:
  initial_state:
    input: 1
    output: 1
    video_mute: false
    audio_mute: false
    signal_present: true

  delays:
    command_response: 0.02

  controls:
    - type: select
      key: input
      label: Input
      options: ["1", "2", "3", "4", "5", "6", "7", "8"]
    - type: toggle
      key: video_mute
      label: Video Mute
    - type: toggle
      key: audio_mute
      label: Audio Mute
    - type: indicator
      key: signal_present
      label: Signal
      color_map:
        "true": "#22c55e"
        "false": "#6b7089"

  command_handlers:
    # Route query (#ROUTE? layer,output) — respond with current route
    - match: '#ROUTE\? (\d+),(\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        layer = match.group(1)
        output = match.group(2)
        respond(f"~{mn}@ROUTE {layer},{output},{state['input']}\r\n")

    # Route set (#ROUTE layer,output,input) — update state and respond
    - match: '#ROUTE (\d+),(\d+),(\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        layer = match.group(1)
        output = match.group(2)
        inp = int(match.group(3))
        state["input"] = inp
        state["output"] = int(output)
        respond(f"~{mn}@ROUTE {layer},{output},{inp}\r\n")

    # Video mute query (#VMUTE? output)
    - match: '#VMUTE\? (\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        output = match.group(1)
        val = "1" if state["video_mute"] else "0"
        respond(f"~{mn}@VMUTE {output},{val}\r\n")

    # Video mute set (#VMUTE output,state)
    - match: '#VMUTE (\d+),(\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        output = match.group(1)
        val = match.group(2)
        state["video_mute"] = val == "1"
        respond(f"~{mn}@VMUTE {output},{val}\r\n")

    # Audio mute query (#MUTE? output)
    - match: '#MUTE\? (\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        output = match.group(1)
        val = "1" if state["audio_mute"] else "0"
        respond(f"~{mn}@MUTE {output},{val}\r\n")

    # Audio mute set (#MUTE output,state)
    - match: '#MUTE (\d+),(\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        output = match.group(1)
        val = match.group(2)
        state["audio_mute"] = val == "1"
        respond(f"~{mn}@MUTE {output},{val}\r\n")

    # Volume set (#AUD-LVL output,type,level)
    - match: '#AUD-LVL (\d+),(\d+),(-?\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        output = match.group(1)
        atype = match.group(2)
        level = match.group(3)
        respond(f"~{mn}@AUD-LVL {output},{atype},{level}\r\n")

    # Signal query (#SIGNAL? input)
    - match: '#SIGNAL\? (\d+)'
      handler: |
        mn = config.get("machine_number", "01")
        inp = match.group(1)
        val = "1" if state["signal_present"] else "0"
        respond(f"~{mn}@SIGNAL {inp},{val}\r\n")

  error_modes:
    communication_timeout:
      behavior: no_response
      description: "Device stops responding to all commands (network issue or device reboot)"
