# Lightware LW3 Driver
#
# Controls Lightware AV switchers, extenders, and matrix routers over the
# Lightware Protocol #3 (LW3) ASCII command set.
#
# Models covered: any current Lightware product implementing LW3, including
#   UCX series          Universal matrix switchers (UCX-2x1-HC30, UCX-2x2-H30,
#                       UCX-4x3-HC30, UCX-4x3-HC40, etc.)
#   Taurus UCX          Universal matrix switchers
#   MMX2 series         Multimedia matrix switchers (MMX2-4x1-H20, MMX2-4x3-H20)
#   MMX series          Earlier multimedia matrix switchers
#   MX2M series         Hybrid modular matrix routers (FR8, FR48, FR65, FR80)
#
# Protocol reference: Lightware Protocol #3 (LW3) — Programmer's Reference,
#                     embedded in every Lightware product manual. Reference
#                     copy: MMX2 series User Manual, chapter 7.
# https://assets.prod.pim.lightware.com/assets/File-Downloads/Guides-and-Manuals/User-Manual/MMX2_series_UserManual.pdf
#
# Transport: TCP, port 6107 (raw LW3 over Ethernet).
#
# Command format: <Type> <Path><CrLf>
#   Examples:
#     GET /V1/MEDIA/VIDEO/I1.SignalPresent
#     SET /V1/MEDIA/VIDEO/XP/O1.Mute=false
#     CALL /V1/MEDIA/VIDEO/XP:switch(I2:O1)
#
# Response format: <Prefix> <Path>=<Value><CrLf>
#   Prefixes: pr (read-only property), pw (read-write property),
#             m- (method), mO (method ok), mF (method failed),
#             nE / pE / mE (errors)
#
# Notes:
#   - Switching '0' to an output disconnects: CALL ...XP:switch(0:O1)
#   - Input Count / Output Count size the child rosters (default 4/4, which
#     covers UCX/Taurus/MMX2; set the frame size on MX2M routers). Every
#     configured output/input is polled per port; routing commands accept
#     any port number regardless.
#   - Authentication is not handled by this driver. If the unit has IPLogin
#     or 6107 authentication enabled, disable it in LDC or switch the unit
#     to its WSS interface (not supported here).
#   - The protocol echoes both SET and GET on writable properties with the
#     `pw` prefix — one response rule therefore covers the SET ack, the GET
#     poll read-back, and (for OPENed nodes) the CHG notification body.
#     SignalPresent is read-only and uses `pr`.
#   - Push is armed on connect: the driver OPENs a node-exact subscription
#     per configured port (XP routing/mute/lock, output port properties,
#     input signal/HDCP) plus the analog audio and device-label nodes, so
#     front-panel and LDC changes arrive as CHG notifications between polls.
#     LW3 deletes subscriptions when the connection drops, so on_connect
#     re-arms them on every reconnect. Polling stays on as the read-back
#     backstop. The open/close_subscription commands remain for extra nodes.
#   - Liveness: with push armed, minutes can pass with no client->device
#     round-trip, and a unit that vanishes without a TCP FIN would stay
#     "connected" forever. The liveness watchdog reuses the version query
#     the poll already sends and flags the device offline (no_response)
#     after consecutive silent probes.

id: lightware_lw3
name: Lightware LW3
manufacturer: Lightware
category: switcher
version: 1.5.0
author: OpenAVC
min_platform_version: "0.22.0"
description: >
  Controls Lightware switchers and matrix routers via Protocol #3 (LW3) over
  TCP port 6107. Covers UCX, Taurus UCX, MMX2, MMX, and MX2M products. Each
  configured output and input is a child entity tracking its routed source,
  mute, lock, HDCP, 5V and signal-type state per port, updated in real time
  via change-notification subscriptions with a keep-alive watchdog guarding
  the link. Provides video and audio crosspoint switching, EDID switching,
  analog audio level/mute/balance, and CEC command sending.

source_url: https://assets.prod.pim.lightware.com/assets/File-Downloads/Guides-and-Manuals/User-Manual/MMX2_series_UserManual.pdf
tags: [matrix-switcher, hdbaset, av-over-ip, lw3, hdmi, edid, cec]
verified: false
simulated: true
protocols: [lightware_lw3]
ports: [6107]
compatible_models:
  - manufacturer: Lightware
    models:
      - UCX-2x1-HC30
      - UCX-2x2-H30
      - UCX-4x3-HC30
      - UCX-4x3-HC40
      - Taurus UCX
      - MMX2-4x1-H20
      - MMX2-4x3-H20
      - MMX series
      - MX2M-FR8
      - MX2M-FR48
      - MX2M-FR65
      - MX2M-FR80
    confidence: untested
    notes: >
      Any Lightware product that implements LW3 (most products since 2012).
      Set Input Count / Output Count to the frame size — each port becomes
      a child entity with per-port state (default 4/4 covers UCX, Taurus,
      and MMX2). Commands accept any port number regardless; ports a model
      doesn't have answer LW3 errors on poll, which is benign.

transport: tcp
delimiter: "\r\n"

help:
  overview: >
    Lightware LW3 is the unified ASCII control protocol used across Lightware's
    matrix switchers, extenders, and modular routers. Commands target a tree
    of nodes (e.g. /V1/MEDIA/VIDEO/XP) using GET, SET, and CALL operations.
    The driver exposes the most-used runtime control surface: video and audio
    routing, mute, HDCP, output power, EDID, analog audio level, and CEC.
  setup: >
    1. Connect the Lightware device to the network via Ethernet.
    2. Confirm the device's IP address using LDC (Lightware Device Controller)
       or the front-panel display.
    3. In LDC's Network tab, ensure the LW3 service on port 6107 is enabled
       and that authentication (IPLogin) is OFF — this driver does not
       authenticate.
    4. Enter the IP address and port 6107 in the device config.
    5. Set Input Count and Output Count to the frame size (default 4/4
       covers UCX, Taurus, and MMX2) — each port becomes a child entity
       with per-port routing, mute, lock, HDCP, 5V and signal state.
    6. Use input/output port numbers as integers (I3 → input=3, O2 → output=2).
       Setting input=0 disconnects an output.

discovery:
  # Lightware Device Controller (LDC) confirms mDNS is used for
  # discovery and that LDC was rewritten to no longer require Apple
  # Bonjour, but the literal `_service._tcp` PTR string isn't named
  # in any vendor doc, integrator manual, or open-source module.
  # Hint-only via the registered Lightware Visual Engineering OUI
  # plus open TCP 6107 (LW3 protocol).
  #   Refs:
  #     maclookup.app/vendors/lightware-visual-engineering
  #     Lightware Device Controller User's Manual
  # Active fingerprint: a cheap LW3 version GET answers with the distinctive
  # `pr /V1/MANAGEMENT/UID/PACKAGE.Version=` prefix, which no other protocol on
  # 6107 emits — so a scan can positively identify a Lightware unit.
  tcp_probe:
    port: 6107
    send_ascii: "GET /V1/MANAGEMENT/UID/PACKAGE.Version\r\n"
    expect_regex: 'pr /V1/MANAGEMENT/UID/PACKAGE\.Version='
    extract_manufacturer: "Lightware"
  oui:
    - "a8:d2:36"
  port_open:
    - 6107
  manufacturer_alias:
    - "lightware"
    - "lightware visual engineering"

default_config:
  host: ""
  port: 6107
  input_count: 4
  output_count: 4
  poll_interval: 30

config_schema:
  host:
    type: string
    required: true
    label: IP Address
  port:
    type: integer
    default: 6107
    label: TCP Port
    description: "6107 for LW3 over raw TCP. WS (80) and WSS (443) interfaces are not used by this driver."
  input_count:
    type: integer
    default: 4
    min: 0
    label: Input Count
    description: >
      Number of input ports — each becomes an Input child with signal and
      HDCP state. Default 4 covers UCX/Taurus/MMX2; set the frame size on
      MX2M routers (e.g. 80 for an FR80).
  output_count:
    type: integer
    default: 4
    min: 0
    label: Output Count
    description: >
      Number of output ports — each becomes an Output child tracking its
      routed source, mute, lock, HDCP mode, 5V mode, and signal type.
  poll_interval:
    type: integer
    default: 30
    min: 0
    label: Poll Interval (sec)
    description: "Set to 0 to disable polling."

state_variables:
  device_label:
    type: string
    label: Device Label
    help: "Custom label set on the unit (DeviceLabel property)."
  firmware:
    type: string
    label: Firmware Version
    help: "Package firmware version reported by /V1/MANAGEMENT/UID/PACKAGE.Version."
  audio_volume_percent:
    type: number
    label: Analog Audio Out (O4) — Volume (%)
    help: "Analog audio output volume on the O4 port as a 0–100% scale."
  audio_volume_db:
    type: number
    label: Analog Audio Out (O4) — Volume (dB)
    help: "Analog audio output volume on the O4 port in dB."
  audio_mute:
    type: boolean
    label: Analog Audio Out (O4) — Mute
    help: "True when the analog audio output on the O4 port is muted."

child_entity_types:
  output:
    label: Output
    label_plural: Outputs
    id_format: { type: integer, min: 1, max: 128 }
    state_variables:
      source:
        type: string
        label: Connected Source
        help: "Input node currently routed to this output (e.g. 'I1'; '0' = disconnected)."
        cloud_priority: high
      mute:
        type: boolean
        label: Video Muted
        help: "True when this output's video path is muted (image blanked)."
        cloud_priority: high
      lock:
        type: boolean
        label: Crosspoint Locked
        help: "True when this output's crosspoint is locked against route changes."
      hdcp_mode:
        type: string
        label: HDCP Mode
        help: "Output HDCP mode (Auto encrypts only when the input is encrypted; Always forces HDCP)."
      output_5v:
        type: string
        label: 5V Mode
        help: "HDMI +5V power mode on this output (On / Auto / Off)."
      signal_type:
        type: string
        label: Signal Type
        help: "Forced output signal type (Auto or DVI)."
    summary_fields: [source, mute]
    instances:
      count_from: output_count
      label: "Output {id}"
  input:
    label: Input
    label_plural: Inputs
    id_format: { type: integer, min: 1, max: 128 }
    state_variables:
      signal:
        type: boolean
        label: Signal Present
        help: "True when this input reports a valid sync/signal (SignalPresent)."
        cloud_priority: high
      hdcp_version:
        type: string
        label: Allowed HDCP Version
        help: "HDCP version this input advertises to sources (HDCP 1.4 / HDCP 2.2 / Off)."
    summary_fields: [signal]
    instances:
      count_from: input_count
      label: "Input {id}"

commands:

  # ── System ──

  identify:
    label: Identify (Flash LEDs)
    send: "CALL /V1/MANAGEMENT/UI:identifyMe()\r\n"
    help: "Flash the front-panel LEDs for 10 seconds to physically locate this unit."

  reboot:
    label: Reboot
    send: "CALL /V1/SYS:restart()\r\n"
    help: "Restart the unit. Active connections will be terminated."

  set_device_label:
    label: Set Device Label
    send: "SET /V1/MANAGEMENT/LABEL.DeviceLabel={label}\r\n"
    help: "Set a custom device label (max 49 ASCII characters)."
    params:
      label:
        type: string
        required: true
        label: Device Label

  # ── Video routing ──

  set_video_route:
    label: Route Video Source to Output
    send: "CALL /V1/MEDIA/VIDEO/XP:switch(I{input}:O{output})\r\n"
    help: "Route an HDMI input to an HDMI output."
    params:
      input:
        type: integer
        required: true
        default: 1
        min: 1
        label: Input
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output

  disconnect_video_output:
    label: Disconnect Video Output
    send: "CALL /V1/MEDIA/VIDEO/XP:switch(0:O{output})\r\n"
    help: "Disconnect any video source from the specified output."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output

  set_video_route_all:
    label: Route Video to All Outputs
    send: "CALL /V1/MEDIA/VIDEO/XP:switchAll(I{input})\r\n"
    help: "Route a single input to every video output."
    params:
      input:
        type: integer
        required: true
        default: 1
        min: 1
        label: Input

  set_video_mute:
    label: Set Video Mute
    send: "SET /V1/MEDIA/VIDEO/XP/O{output}.Mute={state}\r\n"
    help: "Mute or unmute the specified video output port."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      state:
        type: enum
        required: true
        values: ["true", "false"]
        label: Mute State

  set_video_lock:
    label: Lock Video Output
    send: "SET /V1/MEDIA/VIDEO/XP/O{output}.Lock={state}\r\n"
    help: "Lock the video output crosspoint to prevent route changes."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      state:
        type: enum
        required: true
        values: ["true", "false"]
        label: Lock State

  set_output_5v:
    label: Set HDMI Output +5V
    send: "SET /V1/MEDIA/VIDEO/O{output}.Output5VMode={state}\r\n"
    help: "Enable or disable the HDMI +5V power on the output port."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      state:
        type: enum
        required: true
        values: [On, Auto, Off]
        label: 5V Mode

  set_input_hdcp:
    label: Set Input HDCP Allowed Version
    send: "SET /V1/MEDIA/VIDEO/I{input}/HDCP.AllowedHdcpVersion={version}\r\n"
    help: "Choose which HDCP version the input port advertises to sources."
    params:
      input:
        type: integer
        required: true
        default: 1
        min: 1
        label: Input
      version:
        type: enum
        required: true
        values: ["HDCP 1.4", "HDCP 2.2", "Off"]
        label: HDCP Version

  set_output_hdcp_mode:
    label: Set Output HDCP Mode
    send: "SET /V1/MEDIA/VIDEO/O{output}.HdcpMode={mode}\r\n"
    help: "Auto encrypts only when the input is encrypted; Always forces HDCP."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      mode:
        type: enum
        required: true
        values: [Auto, Always]
        label: HDCP Mode

  set_output_signal_type:
    label: Set Output Signal Type
    send: "SET /V1/MEDIA/VIDEO/O{output}.OutputSignalType={signal_type}\r\n"
    help: "Force the output signal type (HDMI auto-detect or DVI)."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      signal_type:
        type: enum
        required: true
        values: [Auto, DVI]
        label: Signal Type

  set_embedded_audio_mute:
    label: Set Embedded Audio Mute
    send: "SET /V1/MEDIA/VIDEO/XP/O{output}.EmbeddedAudioMute={state}\r\n"
    help: "Mute or unmute the audio embedded in the HDMI output."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      state:
        type: enum
        required: true
        values: ["true", "false"]
        label: Mute State

  # ── Audio routing & analog output ──

  set_audio_route:
    label: Route Audio Source to Output
    send: "CALL /V1/MEDIA/AUDIO/XP:switch(I{input}:O{output})\r\n"
    help: "Route an audio input to an audio output (analog or de-embedded)."
    params:
      input:
        type: integer
        required: true
        default: 1
        min: 1
        label: Input
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output

  disconnect_audio_output:
    label: Disconnect Audio Output
    send: "CALL /V1/MEDIA/AUDIO/XP:switch(0:O{output})\r\n"
    help: "Disconnect any audio source from the specified audio output."
    params:
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output

  set_audio_port_mute:
    label: Set Audio Crosspoint Mute
    send: "SET /V1/MEDIA/AUDIO/XP/{port}.Mute={state}\r\n"
    help: "Mute or unmute an audio crosspoint port (e.g. I2 or O4)."
    params:
      port:
        type: string
        required: true
        default: O4
        label: Port
        description: "Examples: I1, I2, I3, I4, O4."
      state:
        type: enum
        required: true
        values: ["true", "false"]
        label: Mute State

  set_analog_volume_percent:
    label: Set Analog Output Volume (%)
    send: "SET /V1/MEDIA/AUDIO/O{output}.VolumePercent={level}\r\n"
    help: "Set the analog audio output level as a percentage (0–100)."
    params:
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output
      level:
        type: number
        required: true
        min: 0
        max: 100
        label: Volume (%)

  set_analog_volume_db:
    label: Set Analog Output Volume (dB)
    send: "SET /V1/MEDIA/AUDIO/O{output}.VolumedB={level}\r\n"
    help: "Set the analog audio output level in dB (-95.62 to 0 in 0.375 dB steps)."
    params:
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output
      level:
        type: number
        required: true
        min: -95.62
        max: 0
        label: Volume (dB)

  set_analog_balance:
    label: Set Analog Output Balance
    send: "SET /V1/MEDIA/AUDIO/O{output}.Balance={level}\r\n"
    help: "Set the analog audio balance (-100 = full left, 0 = center, 100 = full right)."
    params:
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output
      level:
        type: integer
        required: true
        min: -100
        max: 100
        label: Balance

  step_analog_volume_db:
    label: Step Analog Output Volume (dB)
    send: "CALL /V1/MEDIA/AUDIO/O{output}:stepVolumedB({step})\r\n"
    help: "Increment or decrement the analog output volume by the given dB step."
    params:
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output
      step:
        type: number
        required: true
        default: -1
        label: Step (dB)

  step_analog_volume_percent:
    label: Step Analog Output Volume (%)
    send: "CALL /V1/MEDIA/AUDIO/O{output}:stepVolumePercent({step})\r\n"
    help: "Increment or decrement the analog output volume by the given percentage step."
    params:
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output
      step:
        type: number
        required: true
        default: 5
        label: Step (%)

  set_analog_mute:
    label: Set Analog Output Mute
    send: "SET /V1/MEDIA/AUDIO/O{output}.Mute={state}\r\n"
    help: "Mute or unmute the analog audio output (Mute property on the port itself)."
    params:
      output:
        type: integer
        required: true
        default: 4
        min: 1
        label: Output
      state:
        type: enum
        required: true
        values: ["true", "false"]
        label: Mute State

  # ── EDID ──

  set_edid:
    label: Emulate EDID on Input Port
    send: "CALL /V1/EDID:switch({source}:E{input})\r\n"
    help: >
      Emulate an EDID memory slot on a given input. Source examples:
      F49 (Universal HDMI), F89, U2 (User EDID 2), D1 (Dynamic — last sink).
    params:
      source:
        type: string
        required: true
        default: F49
        label: EDID Source
        description: "F1–F155 (factory), U1–U100 (user), D1–D3 (dynamic)."
      input:
        type: integer
        required: true
        default: 1
        min: 1
        label: Input

  set_edid_all:
    label: Emulate EDID on All Inputs
    send: "CALL /V1/EDID:switchAll({source})\r\n"
    help: "Emulate the same EDID source on every input port."
    params:
      source:
        type: string
        required: true
        default: F49
        label: EDID Source

  copy_edid:
    label: Copy EDID to User Memory
    send: "CALL /V1/EDID:copy({source}:U{slot})\r\n"
    help: "Copy an EDID into a user memory slot (U1..U100)."
    params:
      source:
        type: string
        required: true
        label: Source EDID
      slot:
        type: integer
        required: true
        default: 1
        min: 1
        max: 100
        label: User Slot

  reset_edid:
    label: Reset Emulated EDIDs
    send: "CALL /V1/EDID:reset()\r\n"
    help: "Reset all emulated EDIDs to factory defaults."

  # ── CEC ──

  cec_send:
    label: Send CEC Command
    send: "CALL /V1/MEDIA/VIDEO/O{output}/CEC:send({command})\r\n"
    help: >
      Send a raw CEC opcode on the HDMI output (e.g. 446D=Power on, 446C=Power off,
      36=Standby, 446B=Power toggle, 4441=Volume up, 4442=Volume down,
      4443=Mute toggle, 4444=Play, 4445=Stop, 4446=Pause).
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      command:
        type: string
        required: true
        default: "446D"
        label: CEC Hex Code

  cec_user_control:
    label: Send CEC User Control Click
    send: "CALL /V1/MEDIA/VIDEO/O{output}/CEC:sendUserControlClick({command})\r\n"
    help: "Send a CEC push-button-style command (volume, navigation, etc.)."
    params:
      output:
        type: integer
        required: true
        default: 1
        min: 1
        label: Output
      command:
        type: string
        required: true
        default: "4441"
        label: CEC Hex Code

  # ── Subscriptions ──

  open_subscription:
    label: Subscribe to Node
    send: "OPEN {path}\r\n"
    help: "Open a subscription to a node so the device pushes change notifications."
    params:
      path:
        type: string
        required: true
        default: "/V1/MEDIA/VIDEO/*"
        label: LW3 Path

  close_subscription:
    label: Unsubscribe from Node
    send: "CLOSE {path}\r\n"
    help: "Close a subscription previously opened with OPEN."
    params:
      path:
        type: string
        required: true
        default: "/V1/MEDIA/VIDEO/*"
        label: LW3 Path

  raw_lw3:
    label: Send Raw LW3 Command
    send: "{command}\r\n"
    help: "Send an arbitrary LW3 command (e.g. GET /V1/MANAGEMENT/UID/PACKAGE.Version)."
    params:
      command:
        type: string
        required: true
        label: Command

device_settings:
  # DeviceLabel is set (set_device_label) and polled back (device_label state
  # var via GET /V1/MANAGEMENT/LABEL.DeviceLabel), so it's a first-class
  # device setting. The write reuses the same SET string; the device echoes
  # `pw ...DeviceLabel=<value>` so state updates immediately, and polling is
  # the steady-state read-back.
  device_label:
    type: string
    label: Device Label
    help: "Custom label shown on the unit and in LDC (max 49 ASCII characters)."
    state_key: device_label
    default: "Lightware"
    setup: false
    write:
      send: "SET /V1/MANAGEMENT/LABEL.DeviceLabel={value}\r\n"

# Quick Action strip: the routing an operator reaches for, physical-locate,
# and reboot behind a confirm. The full command list still shows everything.
actions:
  - id: set_video_route
    icon: route
  - id: set_video_route_all
    icon: copy
  - id: set_video_mute
    icon: eye-off
  - id: identify
    icon: search
  - id: reboot
    icon: power
    confirm: "Reboot the unit? Active connections are dropped."

responses:

  # Firmware version: pr /V1/MANAGEMENT/UID/PACKAGE.Version=1.3.3b3
  - match: '^pr /V1/MANAGEMENT/UID/PACKAGE\.Version=(\S+)$'
    set: { firmware: "$1" }

  # Device label: pw /V1/MANAGEMENT/LABEL.DeviceLabel=<name>
  - match: '^(?:pw|CHG) /V1/MANAGEMENT/LABEL\.DeviceLabel=(.*)$'
    set: { device_label: "$1" }

  # Connected source per output: pw /V1/MEDIA/VIDEO/XP/O1.ConnectedSource=I3
  # ('pw' covers the SET ack and the GET poll read-back; 'CHG' the push
  # notification on OPENed nodes — same value grammar.)
  - match: '^(?:pw|CHG) /V1/MEDIA/VIDEO/XP/O(\d+)\.ConnectedSource=(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { source: "$2" } }

  # Signal present per input (read-only): pr /V1/MEDIA/VIDEO/I1.SignalPresent=true
  - match: '^(?:pr|CHG) /V1/MEDIA/VIDEO/I(\d+)\.SignalPresent=(true|false)$'
    child_set:
      - { type: input, id: "$1", state: { signal: "$2" } }

  # Input allowed HDCP version: pw /V1/MEDIA/VIDEO/I1/HDCP.AllowedHdcpVersion=HDCP 2.2
  - match: '^(?:pw|CHG) /V1/MEDIA/VIDEO/I(\d+)/HDCP\.AllowedHdcpVersion=(.+)$'
    child_set:
      - { type: input, id: "$1", state: { hdcp_version: "$2" } }

  # Output crosspoint mute / lock: pw /V1/MEDIA/VIDEO/XP/O1.Mute=false
  - match: '^(?:pw|CHG) /V1/MEDIA/VIDEO/XP/O(\d+)\.Mute=(true|false)$'
    child_set:
      - { type: output, id: "$1", state: { mute: "$2" } }
  - match: '^(?:pw|CHG) /V1/MEDIA/VIDEO/XP/O(\d+)\.Lock=(true|false)$'
    child_set:
      - { type: output, id: "$1", state: { lock: "$2" } }

  # Output port properties: pw /V1/MEDIA/VIDEO/O1.HdcpMode=Auto
  - match: '^(?:pw|CHG) /V1/MEDIA/VIDEO/O(\d+)\.HdcpMode=(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { hdcp_mode: "$2" } }
  - match: '^(?:pw|CHG) /V1/MEDIA/VIDEO/O(\d+)\.Output5VMode=(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { output_5v: "$2" } }
  - match: '^(?:pw|CHG) /V1/MEDIA/VIDEO/O(\d+)\.OutputSignalType=(\S+)$'
    child_set:
      - { type: output, id: "$1", state: { signal_type: "$2" } }

  # Analog audio (output O4): pw /V1/MEDIA/AUDIO/O4.VolumePercent=50.00
  # (CHG covers the push notification — the audio node is OPENed on connect.)
  - match: '^(?:pw|CHG) /V1/MEDIA/AUDIO/O4\.VolumePercent=([\d.\-]+)$'
    set: { audio_volume_percent: "$1" }
  - match: '^(?:pw|CHG) /V1/MEDIA/AUDIO/O4\.VolumedB=([\d.\-]+)$'
    set: { audio_volume_db: "$1" }
  - match: '^(?:pw|CHG) /V1/MEDIA/AUDIO/O4\.Mute=true$'
    set: { audio_mute: "true" }
  - match: '^(?:pw|CHG) /V1/MEDIA/AUDIO/O4\.Mute=false$'
    set: { audio_mute: "false" }

# Subscriptions are per-connection — LW3 deletes them when the socket drops
# (manual 7.4.9) — so they are re-armed on every (re)connect. Node-exact
# OPENs (the documented single-node form) per configured child cover exactly
# the surface the response rules parse; the o- acks are ignored quietly.
on_connect:
  - { each_child: output, send: "OPEN /V1/MEDIA/VIDEO/XP/O{child_id}\r\n" }
  - { each_child: output, send: "OPEN /V1/MEDIA/VIDEO/O{child_id}\r\n" }
  - { each_child: input, send: "OPEN /V1/MEDIA/VIDEO/I{child_id}\r\n" }
  - { each_child: input, send: "OPEN /V1/MEDIA/VIDEO/I{child_id}/HDCP\r\n" }
  - "OPEN /V1/MEDIA/AUDIO/O4\r\n"
  - "OPEN /V1/MANAGEMENT/LABEL\r\n"

# Push-mostly link watchdog: reuses the version query the poll already sends;
# the pr reply (or any frame matching expect) satisfies the probe. After
# max_failures silent probes the platform drops the connection with a typed
# no_response fault and reconnects (which re-OPENs the subscriptions above).
liveness:
  send: "GET /V1/MANAGEMENT/UID/PACKAGE.Version\r\n"
  expect: 'PACKAGE\.Version='
  interval: 30
  timeout: 5
  max_failures: 2

polling:
  queries:
    - "GET /V1/MANAGEMENT/UID/PACKAGE.Version\r\n"
    - "GET /V1/MANAGEMENT/LABEL.DeviceLabel\r\n"
    - "GET /V1/MEDIA/AUDIO/O4.VolumePercent\r\n"
    - "GET /V1/MEDIA/AUDIO/O4.VolumedB\r\n"
    - "GET /V1/MEDIA/AUDIO/O4.Mute\r\n"
    # Per-port state — one GET per property per configured child.
    - { each_child: output, send: "GET /V1/MEDIA/VIDEO/XP/O{child_id}.ConnectedSource\r\n" }
    - { each_child: output, send: "GET /V1/MEDIA/VIDEO/XP/O{child_id}.Mute\r\n" }
    - { each_child: output, send: "GET /V1/MEDIA/VIDEO/XP/O{child_id}.Lock\r\n" }
    - { each_child: output, send: "GET /V1/MEDIA/VIDEO/O{child_id}.HdcpMode\r\n" }
    - { each_child: output, send: "GET /V1/MEDIA/VIDEO/O{child_id}.Output5VMode\r\n" }
    - { each_child: output, send: "GET /V1/MEDIA/VIDEO/O{child_id}.OutputSignalType\r\n" }
    - { each_child: input, send: "GET /V1/MEDIA/VIDEO/I{child_id}.SignalPresent\r\n" }
    - { each_child: input, send: "GET /V1/MEDIA/VIDEO/I{child_id}/HDCP.AllowedHdcpVersion\r\n" }

# ── SIMULATOR DEFINITION ──
simulator:
  push_state: true
  initial_state:
    device_label: "MMX2_LabSim"
    firmware: "1.3.3b3"
    source_o1: "I1"
    source_o2: "I2"
    source_o3: "I3"
    source_o4: "I4"
    signal_i1: true
    signal_i2: true
    signal_i3: false
    signal_i4: false
    mute_o1: false
    mute_o2: false
    mute_o3: false
    mute_o4: false
    lock_o1: false
    lock_o2: false
    lock_o3: false
    lock_o4: false
    hdcp_o1: "Auto"
    hdcp_o2: "Auto"
    hdcp_o3: "Auto"
    hdcp_o4: "Auto"
    v5_o1: "Auto"
    v5_o2: "Auto"
    v5_o3: "Auto"
    v5_o4: "Auto"
    sigtype_o1: "Auto"
    sigtype_o2: "Auto"
    sigtype_o3: "Auto"
    sigtype_o4: "Auto"
    ihdcp_i1: "HDCP 2.2"
    ihdcp_i2: "HDCP 2.2"
    ihdcp_i3: "HDCP 1.4"
    ihdcp_i4: "Off"
    audio_volume_percent: 75.0
    audio_volume_db: -10.0
    audio_mute: false

  delays:
    command_response: 0.02

  controls:
    - type: indicator
      key: device_label
      label: Device Label
    - type: indicator
      key: firmware
      label: Firmware
    - type: indicator
      key: source_o1
      label: O1 Source
    - type: indicator
      key: source_o2
      label: O2 Source
    - type: indicator
      key: source_o3
      label: O3 Source
    - type: indicator
      key: source_o4
      label: O4 Source
    - type: toggle
      key: signal_i1
      label: I1 Signal
    - type: toggle
      key: signal_i2
      label: I2 Signal
    - type: toggle
      key: signal_i3
      label: I3 Signal
    - type: toggle
      key: signal_i4
      label: I4 Signal
    - type: toggle
      key: mute_o1
      label: O1 Mute
    - type: toggle
      key: mute_o2
      label: O2 Mute
    - type: toggle
      key: mute_o3
      label: O3 Mute
    - type: toggle
      key: mute_o4
      label: O4 Mute
    - type: slider
      key: audio_volume_percent
      label: Analog Volume (%)
      min: 0
      max: 100
    - type: toggle
      key: audio_mute
      label: Analog Mute

  command_handlers:

    # ── System ──

    - match: '^CALL\s+/V1/MANAGEMENT/UI:identifyMe\(\)\s*$'
      handler: |
        respond("mO /V1/MANAGEMENT/UI:identifyMe=\r\n")

    - match: '^CALL\s+/V1/SYS:restart\(\)\s*$'
      handler: |
        respond("mO /V1/SYS:restart=\r\n")

    - match: '^CALL\s+/V1/SYS:factoryDefaults\(\)\s*$'
      handler: |
        respond("mO /V1/SYS:factoryDefaults=\r\n")

    - match: '^GET\s+/V1/MANAGEMENT/UID/PACKAGE\.Version\s*$'
      handler: |
        respond(f"pr /V1/MANAGEMENT/UID/PACKAGE.Version={state['firmware']}\r\n")

    - match: '^GET\s+/V1/MANAGEMENT/LABEL\.DeviceLabel\s*$'
      handler: |
        respond(f"pw /V1/MANAGEMENT/LABEL.DeviceLabel={state['device_label']}\r\n")

    - match: '^SET\s+/V1/MANAGEMENT/LABEL\.DeviceLabel=(.*)$'
      handler: |
        label = match.group(1).strip()
        state['device_label'] = label
        respond(f"pw /V1/MANAGEMENT/LABEL.DeviceLabel={label}\r\n")

    # ── Video routing ──

    - match: '^CALL\s+/V1/MEDIA/VIDEO/XP:switch\(I(\d+):O(\d+)\)\s*$'
      handler: |
        i = match.group(1)
        o = match.group(2)
        key = f"source_o{o}"
        if key in state:
            state[key] = f"I{i}"
        respond("mO /V1/MEDIA/VIDEO/XP:switch=\r\n")

    - match: '^CALL\s+/V1/MEDIA/VIDEO/XP:switch\(0:O(\d+)\)\s*$'
      handler: |
        o = match.group(1)
        key = f"source_o{o}"
        if key in state:
            state[key] = "0"
        respond("mO /V1/MEDIA/VIDEO/XP:switch=\r\n")

    - match: '^CALL\s+/V1/MEDIA/VIDEO/XP:switchAll\(I(\d+)\)\s*$'
      handler: |
        i = match.group(1)
        for o in (1, 2, 3, 4):
            key = f"source_o{o}"
            if key in state:
                state[key] = f"I{i}"
        respond("mO /V1/MEDIA/VIDEO/XP:switchAll=\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/XP/O(\d+)\.ConnectedSource\s*$'
      handler: |
        o = match.group(1)
        src = state.get(f"source_o{o}", "0")
        respond(f"pw /V1/MEDIA/VIDEO/XP/O{o}.ConnectedSource={src}\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/I(\d+)\.SignalPresent\s*$'
      handler: |
        i = match.group(1)
        present = state.get(f"signal_i{i}", False)
        respond(f"pr /V1/MEDIA/VIDEO/I{i}.SignalPresent={'true' if present else 'false'}\r\n")

    - match: '^SET\s+/V1/MEDIA/VIDEO/XP/O(\d+)\.Mute=(true|false)\s*$'
      handler: |
        o = match.group(1)
        v = match.group(2)
        key = f"mute_o{o}"
        if key in state:
            state[key] = (v == "true")
        respond(f"pw /V1/MEDIA/VIDEO/XP/O{o}.Mute={v}\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/XP/O(\d+)\.Mute\s*$'
      handler: |
        o = match.group(1)
        muted = state.get(f"mute_o{o}", False)
        respond(f"pw /V1/MEDIA/VIDEO/XP/O{o}.Mute={'true' if muted else 'false'}\r\n")

    - match: '^SET\s+/V1/MEDIA/VIDEO/XP/O(\d+)\.Lock=(true|false)\s*$'
      handler: |
        o = match.group(1)
        v = match.group(2)
        key = f"lock_o{o}"
        if key in state:
            state[key] = (v == "true")
            respond(f"pw /V1/MEDIA/VIDEO/XP/O{o}.Lock={v}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/XP/O{o}.Lock %E002:Not exist\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/XP/O(\d+)\.Lock\s*$'
      handler: |
        o = match.group(1)
        key = f"lock_o{o}"
        if key in state:
            respond(f"pw /V1/MEDIA/VIDEO/XP/O{o}.Lock={'true' if state[key] else 'false'}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/XP/O{o}.Lock %E002:Not exist\r\n")

    - match: '^SET\s+/V1/MEDIA/VIDEO/O(\d+)\.Output5VMode=(\S+)\s*$'
      handler: |
        o = match.group(1)
        v = match.group(2)
        key = f"v5_o{o}"
        if key in state:
            state[key] = v
            respond(f"pw /V1/MEDIA/VIDEO/O{o}.Output5VMode={v}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/O{o}.Output5VMode %E002:Not exist\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/O(\d+)\.Output5VMode\s*$'
      handler: |
        o = match.group(1)
        key = f"v5_o{o}"
        if key in state:
            respond(f"pw /V1/MEDIA/VIDEO/O{o}.Output5VMode={state[key]}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/O{o}.Output5VMode %E002:Not exist\r\n")

    - match: '^SET\s+/V1/MEDIA/VIDEO/I(\d+)/HDCP\.AllowedHdcpVersion=(.+)$'
      handler: |
        i = match.group(1)
        v = match.group(2).strip()
        key = f"ihdcp_i{i}"
        if key in state:
            state[key] = v
            respond(f"pw /V1/MEDIA/VIDEO/I{i}/HDCP.AllowedHdcpVersion={v}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/I{i}/HDCP.AllowedHdcpVersion %E002:Not exist\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/I(\d+)/HDCP\.AllowedHdcpVersion\s*$'
      handler: |
        i = match.group(1)
        key = f"ihdcp_i{i}"
        if key in state:
            respond(f"pw /V1/MEDIA/VIDEO/I{i}/HDCP.AllowedHdcpVersion={state[key]}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/I{i}/HDCP.AllowedHdcpVersion %E002:Not exist\r\n")

    - match: '^SET\s+/V1/MEDIA/VIDEO/O(\d+)\.HdcpMode=(\S+)\s*$'
      handler: |
        o = match.group(1)
        v = match.group(2)
        key = f"hdcp_o{o}"
        if key in state:
            state[key] = v
            respond(f"pw /V1/MEDIA/VIDEO/O{o}.HdcpMode={v}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/O{o}.HdcpMode %E002:Not exist\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/O(\d+)\.HdcpMode\s*$'
      handler: |
        o = match.group(1)
        key = f"hdcp_o{o}"
        if key in state:
            respond(f"pw /V1/MEDIA/VIDEO/O{o}.HdcpMode={state[key]}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/O{o}.HdcpMode %E002:Not exist\r\n")

    - match: '^SET\s+/V1/MEDIA/VIDEO/O(\d+)\.OutputSignalType=(\S+)\s*$'
      handler: |
        o = match.group(1)
        v = match.group(2)
        key = f"sigtype_o{o}"
        if key in state:
            state[key] = v
            respond(f"pw /V1/MEDIA/VIDEO/O{o}.OutputSignalType={v}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/O{o}.OutputSignalType %E002:Not exist\r\n")

    - match: '^GET\s+/V1/MEDIA/VIDEO/O(\d+)\.OutputSignalType\s*$'
      handler: |
        o = match.group(1)
        key = f"sigtype_o{o}"
        if key in state:
            respond(f"pw /V1/MEDIA/VIDEO/O{o}.OutputSignalType={state[key]}\r\n")
        else:
            respond(f"pE /V1/MEDIA/VIDEO/O{o}.OutputSignalType %E002:Not exist\r\n")

    - match: '^SET\s+/V1/MEDIA/VIDEO/XP/O(\d+)\.EmbeddedAudioMute=(true|false)\s*$'
      handler: |
        o = match.group(1)
        v = match.group(2)
        respond(f"pw /V1/MEDIA/VIDEO/XP/O{o}.EmbeddedAudioMute={v}\r\n")

    # ── Audio routing & analog output ──

    - match: '^CALL\s+/V1/MEDIA/AUDIO/XP:switch\(I(\d+):O(\d+)\)\s*$'
      handler: |
        respond("mO /V1/MEDIA/AUDIO/XP:switch=\r\n")

    - match: '^CALL\s+/V1/MEDIA/AUDIO/XP:switch\(0:O(\d+)\)\s*$'
      handler: |
        respond("mO /V1/MEDIA/AUDIO/XP:switch=\r\n")

    - match: '^SET\s+/V1/MEDIA/AUDIO/XP/(\S+?)\.Mute=(true|false)\s*$'
      handler: |
        port = match.group(1)
        v = match.group(2)
        respond(f"pw /V1/MEDIA/AUDIO/XP/{port}.Mute={v}\r\n")

    - match: '^SET\s+/V1/MEDIA/AUDIO/O(\d+)\.VolumePercent=(\S+)\s*$'
      handler: |
        o = match.group(1)
        raw = match.group(2)
        ok = True
        level = 0.0
        try:
            level = max(0.0, min(100.0, float(raw)))
        except:  # noqa: E722 — script namespace has no exception names
            ok = False
        if not ok:
            respond(f"pE /V1/MEDIA/AUDIO/O{o}.VolumePercent %E001:Syntax error\r\n")
        else:
            if o == "4":
                state['audio_volume_percent'] = level
            respond(f"pw /V1/MEDIA/AUDIO/O{o}.VolumePercent={level:.2f}\r\n")

    - match: '^GET\s+/V1/MEDIA/AUDIO/O(\d+)\.VolumePercent\s*$'
      handler: |
        o = match.group(1)
        level = state.get('audio_volume_percent', 100.0) if o == "4" else 100.0
        respond(f"pw /V1/MEDIA/AUDIO/O{o}.VolumePercent={level:.2f}\r\n")

    - match: '^SET\s+/V1/MEDIA/AUDIO/O(\d+)\.VolumedB=(\S+)\s*$'
      handler: |
        o = match.group(1)
        raw = match.group(2)
        ok = True
        level = 0.0
        try:
            level = max(-95.62, min(0.0, float(raw)))
        except:  # noqa: E722
            ok = False
        if not ok:
            respond(f"pE /V1/MEDIA/AUDIO/O{o}.VolumedB %E001:Syntax error\r\n")
        else:
            if o == "4":
                state['audio_volume_db'] = level
            respond(f"pw /V1/MEDIA/AUDIO/O{o}.VolumedB={level:.2f}\r\n")

    - match: '^GET\s+/V1/MEDIA/AUDIO/O(\d+)\.VolumedB\s*$'
      handler: |
        o = match.group(1)
        level = state.get('audio_volume_db', 0.0) if o == "4" else 0.0
        respond(f"pw /V1/MEDIA/AUDIO/O{o}.VolumedB={level:.2f}\r\n")

    - match: '^SET\s+/V1/MEDIA/AUDIO/O(\d+)\.Balance=(\S+)\s*$'
      handler: |
        o = match.group(1)
        raw = match.group(2)
        ok = True
        v = 0
        try:
            v = max(-100, min(100, int(float(raw))))
        except:  # noqa: E722
            ok = False
        if not ok:
            respond(f"pE /V1/MEDIA/AUDIO/O{o}.Balance %E001:Syntax error\r\n")
        else:
            respond(f"pw /V1/MEDIA/AUDIO/O{o}.Balance={v}\r\n")

    - match: '^SET\s+/V1/MEDIA/AUDIO/O(\d+)\.Mute=(true|false)\s*$'
      handler: |
        o = match.group(1)
        v = match.group(2)
        if o == "4":
            state['audio_mute'] = (v == "true")
        respond(f"pw /V1/MEDIA/AUDIO/O{o}.Mute={v}\r\n")

    - match: '^GET\s+/V1/MEDIA/AUDIO/O(\d+)\.Mute\s*$'
      handler: |
        o = match.group(1)
        muted = state.get('audio_mute', False) if o == "4" else False
        respond(f"pw /V1/MEDIA/AUDIO/O{o}.Mute={'true' if muted else 'false'}\r\n")

    - match: '^CALL\s+/V1/MEDIA/AUDIO/O(\d+):stepVolumedB\(([-+]?\d+(?:\.\d+)?)\)\s*$'
      handler: |
        o = match.group(1)
        step = float(match.group(2))
        if o == "4":
            cur = state.get('audio_volume_db', 0.0)
            state['audio_volume_db'] = max(-95.62, min(0.0, cur + step))
        respond(f"mO /V1/MEDIA/AUDIO/O{o}:stepVolumedB=\r\n")

    - match: '^CALL\s+/V1/MEDIA/AUDIO/O(\d+):stepVolumePercent\(([-+]?\d+(?:\.\d+)?)\)\s*$'
      handler: |
        o = match.group(1)
        step = float(match.group(2))
        if o == "4":
            cur = state.get('audio_volume_percent', 100.0)
            state['audio_volume_percent'] = max(0.0, min(100.0, cur + step))
        respond(f"mO /V1/MEDIA/AUDIO/O{o}:stepVolumePercent=\r\n")

    - match: '^CALL\s+/V1/MEDIA/AUDIO/O(\d+):stepBalance\(([-+]?\d+)\)\s*$'
      handler: |
        o = match.group(1)
        respond(f"mO /V1/MEDIA/AUDIO/O{o}:stepBalance=\r\n")

    # ── EDID ──

    - match: '^CALL\s+/V1/EDID:switch\((\S+):E(\d+)\)\s*$'
      handler: |
        respond("mO /V1/EDID:switch=\r\n")

    - match: '^CALL\s+/V1/EDID:switchAll\((\S+)\)\s*$'
      handler: |
        respond("mO /V1/EDID:switchAll=\r\n")

    - match: '^CALL\s+/V1/EDID:copy\((\S+):U(\d+)\)\s*$'
      handler: |
        respond("mO /V1/EDID:copy=\r\n")

    - match: '^CALL\s+/V1/EDID:reset\(\)\s*$'
      handler: |
        respond("mO /V1/EDID:reset=\r\n")

    # ── CEC ──

    - match: '^CALL\s+/V1/MEDIA/VIDEO/O(\d+)/CEC:send\((\S+)\)\s*$'
      handler: |
        o = match.group(1)
        respond(f"mO /V1/MEDIA/VIDEO/O{o}/CEC:send=OK\r\n")

    - match: '^CALL\s+/V1/MEDIA/VIDEO/O(\d+)/CEC:sendUserControlClick\((\S+)\)\s*$'
      handler: |
        o = match.group(1)
        respond(f"mO /V1/MEDIA/VIDEO/O{o}/CEC:sendUserControlClick=OK\r\n")

    # ── Subscriptions ──

    - match: '^OPEN\s*$'
      handler: |
        respond("o-\r\n")

    - match: '^OPEN\s+(\S+)\s*$'
      handler: |
        respond(f"o- {match.group(1)}\r\n")

    - match: '^CLOSE\s+(\S+)\s*$'
      handler: |
        respond(f"c- {match.group(1)}\r\n")

    # Catch-all: report a generic error matching the LW3 error grammar.
    # Must remain last in this block; written as `match: + handler:` so it
    # routes via _script_handlers and stays after the specific entries above.
    - match: '.+'
      handler: |
        respond("nE %E001:Syntax error\r\n")

  error_modes:
    communication_timeout:
      description: "Device stops responding to commands"
      behavior: no_response
    auth_required:
      description: "IPLogin enabled — device requires LW3 authentication"
      behavior: no_response
